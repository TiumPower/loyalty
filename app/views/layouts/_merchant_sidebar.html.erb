<%# Six entries, one per flow of the admin design. Which screens sit inside each
    is decided once, in MerchantHelper#merchant_sections, and the tab strip under
    every page title reads from the same map — so nothing can fall out of the nav. %>
<% nav = defined?(nav_key) ? nav_key : nil %>
<% active_section = merchant_section_for(nav)&.dig(:key) %>
<aside class="l-side" data-controller="activenav">
  <div class="brand">
    <div class="logo"><%= current_workspace&.logo_initials || "DL" %></div>
    <div style="min-width:0;">
      <div class="nm"><%= current_workspace&.name || "Quenly" %></div>
      <div class="sub"><%= t("merchant.nav.merchant_tag") %></div>
    </div>
  </div>

  <% if accessible_workspaces.size > 1 %>
    <details class="l-ws">
      <summary style="cursor:pointer; list-style:none;">
        <div class="k"><%= t("merchant.nav.workspace") %></div>
        <div class="v"><%= current_workspace&.name %> ▾</div>
      </summary>
      <div style="margin-top:8px; display:flex; flex-direction:column; gap:4px;">
        <% accessible_workspaces.each do |ws| %>
          <%# turbo: false — switching redirects to that workspace's subdomain, and
              Turbo cannot follow a cross-origin redirect (it sends OPTIONS then
              quietly gives up), so the button would appear to do nothing. %>
          <%= button_to ws.name, merchant_switch_workspace_path(ws), class: "l-nav-item",
                form: { data: { turbo: false } },
                style: "background:none;border:none;text-align:left;width:100%;#{'font-weight:700;' if ws.id == current_workspace&.id}" %>
        <% end %>
      </div>
    </details>
  <% end %>

  <%# The counter scanner keeps its own prominent button: it is the most-used
      action in the shop and does not deserve to be one tab among many. %>
  <%= link_to merchant_scanner_path, class: "l-nav-scan #{'active' if nav == :scanner}" do %>
    <%= ui_icon(:scan, size: 20) %><span><%= t("merchant.nav.scanner") %></span>
  <% end %>

  <nav style="margin-top:6px;">
    <% merchant_sections.each do |sec| %>
      <% on = active_section == sec[:key] %>
      <%= link_to sec[:items].first[2], class: "l-nav-item #{'active' if on}" do %>
        <%= ui_icon(sec[:icon], size: 20) %><span><%= sec[:label] %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="foot">
    <%= link_to merchant_account_path, style: "display:flex; align-items:center; gap:10px; flex:1; min-width:0; text-decoration:none; color:inherit; border-radius:10px; padding:4px 6px; #{'background:rgba(255,255,255,.1);' if nav == :account}", title: t("merchant.nav.account") do %>
      <div class="av"><%= current_user&.initials %></div>
      <div style="min-width:0;">
        <div style="font-size:13px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= current_user&.name %></div>
        <div style="font-size:11px; opacity:.6;"><%= current_membership&.label %></div>
      </div>
    <% end %>
    <%= button_to "⎋", destroy_user_session_path, method: :delete,
          form: { data: { turbo_confirm: t("merchant.nav.logout_confirm") } },
          style: "margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;font-size:16px;" %>
  </div>
</aside>
