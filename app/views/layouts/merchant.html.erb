<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta name="turbo-cache-control" content="no-cache">
    <%= render "layouts/head" %>
  </head>
  <body>
    <%= render "layouts/merchant_theme_vars" %>

    <div class="l-shell">
      <%# Mobile navigation. The sidebar is hidden below 900px, so without this
          a phone had no way to move between pages at all. Checkbox + labels so
          it works with no JS and resets on every Turbo navigation. %>
      <input type="checkbox" id="l-navtoggle" class="l-navtoggle" hidden>
      <label for="l-navtoggle" class="l-navscrim" aria-hidden="true"></label>
      <%= render "layouts/merchant_sidebar" %>
      <main class="l-main">
        <header class="l-topbar">
          <label for="l-navtoggle" class="l-navbtn" role="button" tabindex="0" aria-label="<%= t("merchant.nav.menu", default: "Menu") %>">
            <span></span><span></span><span></span>
          </label>
          <% if content_for?(:back) %><%= yield(:back) %><% end %>
          <div class="title">
            <%= content_for?(:title) ? yield(:title) : "Tổng quan" %>
            <span class="en"><%= content_for?(:title_en) ? yield(:title_en) : "OVERVIEW" %></span>
          </div>
          <div style="margin-left:auto; display:flex; align-items:center; gap:14px;">
            <%# Hộp thư của cửa hàng: đánh giá mới, quà hết hàng, bài chờ duyệt %>
            <% if current_membership&.can_manage? %>
              <%= link_to merchant_alerts_path, title: t("merchant.alerts.title"),
                    style: "position:relative; display:grid; place-items:center; color:var(--ink); text-decoration:none;" do %>
                <%= ui_icon(:bell, size: 20) %>
                <% if unread_alerts_count.positive? %>
                  <span style="position:absolute; top:-6px; right:-7px; background:var(--warn,#E08A3C); color:#fff;
                               font-size:10px; font-weight:700; min-width:16px; height:16px; border-radius:999px;
                               display:grid; place-items:center; padding:0 4px;">
                    <%= unread_alerts_count > 99 ? "99+" : unread_alerts_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
            <span style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden;">
              <% [["VI", :vi], ["EN", :en]].each do |lbl, loc| %>
                <% on = I18n.locale == loc %>
                <%= link_to lbl, set_locale_path(loc),
                      style: "padding:6px 16px; font-size:12px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:var(--on-primary);' : 'color:var(--ink-2);'}" %>
              <% end %>
            </span>
          </div>
        </header>
        <div class="l-content"><%= yield %></div>
      </main>
    </div>

    <%# Global async-job progress bar (e.g. AI banner generation) %>
    <div data-controller="jobbar" data-jobbar-url-value="<%= banner_jobs_merchant_campaigns_path %>"
         style="position:fixed; right:16px; bottom:16px; z-index:2000; width:min(92vw,400px);
                display:flex; flex-direction:column; gap:10px; pointer-events:none;"></div>
  </body>
</html>
