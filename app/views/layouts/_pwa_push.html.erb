<div class="l-a2hs-overlay" data-pwa-target="pushBanner" hidden>
  <div class="l-a2hs">
    <button type="button" class="l-a2hs-x" data-action="pwa#dismissPush" aria-label="<%= t("customer.common.close") %>">✕</button>
    <div class="ic">🔔</div>
    <div style="font-weight:700; font-size:17px;"><%= t("customer.pwa.push_prompt_title") %></div>
    <div style="font-size:13px; color:var(--ink-2); margin-top:6px;"><%= t("customer.pwa.push_prompt_sub", shop: current_workspace&.name) %></div>
    <div style="display:flex; gap:8px; margin-top:18px;">
      <button type="button" class="l-btn l-btn-ghost" data-action="pwa#dismissPush" style="flex:1;"><%= t("customer.pwa.push_prompt_later") %></button>
      <button type="button" class="l-btn l-btn-primary" data-action="pwa#enablePush" style="flex:1;"><%= t("customer.pwa.push_prompt_enable") %></button>
    </div>
  </div>
</div>
