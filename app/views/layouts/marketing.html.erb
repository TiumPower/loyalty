<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
    <%# One family for all marketing type. _head's families are shop theme presets. %>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400..700&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# This is the product's sales page and it carried no description and no
        Open Graph tags, so search results showed a scraped snippet and a link
        pasted into Zalo or Messenger — the channels this is actually sold
        through — rendered as a bare URL with no title, image or blurb. %>
    <% page_title = content_for?(:title) ? content_for(:title) : "Quenly" %>
    <% page_desc  = t("landing.hero_sub") %>
    <meta name="description" content="<%= page_desc %>">
    <link rel="canonical" href="<%= request.base_url %><%= request.path %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Quenly">
    <meta property="og:locale" content="<%= I18n.locale == :vi ? "vi_VN" : "en_US" %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_desc %>">
    <meta property="og:url" content="<%= request.base_url %><%= request.path %>">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_desc %>">
    <meta name="twitter:image" content="<%= request.base_url %>/og.png">
    <%# Switch on the hidden start state for section entrances before first paint, so the hero doesn't
        flash in, vanish, then animate. If inview_controller never connects (script failed), give up
        after 4s and show everything. %>
    <script>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        document.documentElement.classList.add("reveal-on")
        setTimeout(() => { if (!document.documentElement.dataset.inview) document.documentElement.classList.remove("reveal-on") }, 4000)
      }
    </script>
    <%= javascript_import_module_tag "marketing" %>
  </head>
  <body class="marketing bg-surface text-ink antialiased">
    <%# Absolute anchors: this layout also wraps /merchant/signup. %>
    <% nav = [["/#how", t("landing.nav_how")], ["/#features", t("landing.nav_features")],
              ["/#pricing", t("landing.nav_pricing")], ["/#faq", t("landing.faq_title")]] %>
    <header class="l-hdr sticky top-0 z-50 border-b border-line">
      <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-10 px-4 py-2 sm:px-6 lg:py-3">
        <a class="flex h-12 items-center" href="/">
          <%= image_tag "quenly-lockup.png", alt: "Quenly", width: 449, height: 160, class: "h-7 w-auto sm:h-8" %>
        </a>

        <div class="ms-auto flex items-center gap-2 sm:gap-5 lg:order-3">
          <a class="l-link hidden text-[15px] font-medium lg:inline" href="/merchant/login"><%= t("landing.nav_login") %></a>
          <a class="l-btn l-btn-primary min-h-10! px-4! text-sm! sm:px-5!" href="/merchant/signup"><%= t("landing.hero_cta") %></a>
          <button type="button" class="hs-collapse-toggle -me-2 rounded-lg p-2 text-ink-2 hover:bg-surface-2 lg:hidden"
                  data-hs-collapse="#m-nav" aria-controls="m-nav" aria-label="Menu">
            <%= ui_icon(:menu, size: 22, klass: "hs-collapse-open:hidden") %>
            <%= ui_icon(:close, size: 22, klass: "hidden hs-collapse-open:block") %>
          </button>
        </div>

        <div id="m-nav" class="hs-collapse hidden w-full basis-full overflow-hidden transition-[height] duration-300 lg:order-2 lg:block lg:w-auto lg:basis-auto">
          <div class="flex flex-col py-2 text-[15px] font-medium text-ink-2 lg:flex-row lg:items-center lg:gap-7 lg:py-0">
            <% nav.each do |href, label| %>
              <a class="l-link py-2" href="<%= href %>"><%= label %></a>
            <% end %>
            <a class="py-2 font-semibold text-ink lg:hidden" href="/merchant/login"><%= t("landing.nav_login") %></a>
          </div>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 sm:px-6">
      <%= yield %>
    </main>

    <footer class="mt-8 border-t border-line">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid gap-10 py-14 md:grid-cols-12 md:gap-8">
          <div class="md:col-span-6">
            <a class="inline-flex" href="/"><%= image_tag "quenly-lockup.png", alt: "Quenly", width: 449, height: 160, class: "h-11 w-auto" %></a>
            <p class="mt-4 max-w-[36ch] leading-relaxed text-ink-2"><%= t("landing.footer_tagline") %></p>
          </div>
          <ul class="space-y-3 text-[15px] text-ink-2 md:col-span-3">
            <% nav.each do |href, label| %><li><a class="l-link" href="<%= href %>"><%= label %></a></li><% end %>
          </ul>
          <ul class="space-y-3 text-[15px] text-ink-2 md:col-span-3">
            <li><a class="l-link" href="/merchant/signup"><%= t("landing.hero_cta") %></a></li>
            <li><a class="l-link" href="/merchant/login"><%= t("landing.nav_login") %></a></li>
          </ul>
        </div>
        <div class="flex flex-col gap-3 border-t border-line py-6 text-[13px] text-ink-2 sm:flex-row sm:items-center sm:justify-between">
          <span>© <%= Date.current.year %> Quenly · <%= t("landing.footer_rights") %></span>
          <span class="flex gap-4 font-semibold">
            <%= link_to "VI", set_locale_path(:vi), class: (I18n.locale == :vi ? "text-ink" : "l-link"), data: { turbo: false } %>
            <%= link_to "EN", set_locale_path(:en), class: (I18n.locale == :en ? "text-ink" : "l-link"), data: { turbo: false } %>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
