<% content_for :title, current_workspace&.name || t("customer.unavailable.title") %>
<% content_for :no_tabbar, true %>
<div class="l-screen no-tabs" style="display:flex; flex-direction:column; justify-content:center; min-height:88vh;">
  <div class="l-result">
    <div class="halo warn"><%= ui_icon(:clock, size: 38) %></div>
    <h1><%= t("customer.unavailable.title") %></h1>
    <p><%= t("customer.unavailable.body_html", shop: tag.strong(current_workspace&.name)).html_safe %></p>
  </div>
</div>
