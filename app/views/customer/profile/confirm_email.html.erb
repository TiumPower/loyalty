<% content_for :title, t("customer.profile.email_confirm_title") %>
<% content_for :tab, "me" %>
<header class="l-subhead">
  <%= link_to member_edit_profile_path, class: "l-iconbtn", data: { controller: "goback", action: "goback#back" }, "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;"><div class="t"><%= t("customer.profile.email_confirm_title") %></div></div>
</header>

<div class="l-screen" style="text-align:center;">
  <div style="width:80px; height:80px; margin:12px auto 0; border-radius:50%; background:var(--primary-soft);
              color:var(--primary); display:grid; place-items:center;">
    <%= ui_icon(:mail, size: 34) %>
  </div>
  <div style="font-size:20px; font-weight:700; letter-spacing:-.02em; margin-top:16px;"><%= t("customer.profile.email_confirm_heading") %></div>
  <p style="font-size:14px; color:var(--ink-2); line-height:1.55; margin-top:8px;"><%= t("customer.profile.email_confirm_note") %></p>
  <div style="font-weight:700; font-size:15px; margin-top:6px;"><%= @pending %></div>

  <% if @dev_code %>
    <div class="l-note brand" style="justify-content:center; margin-top:16px;">
      <span><%= t("customer.profile.email_dev_code") %></span>
      <strong class="l-mono" style="letter-spacing:.2em;"><%= @dev_code %></strong>
    </div>
  <% end %>

  <%# Six boxes with one real input behind them, so the keyboard, paste and SMS
      autofill all keep working. %>
  <%= form_with url: member_profile_confirm_email_path, method: :post, data: { turbo: false, controller: "otpboxes" }, html: { style: "margin-top:22px;" } do %>
    <div class="l-otpboxes">
      <div class="boxes" data-otpboxes-target="boxes">
        <% 6.times { %><span></span><% } %>
      </div>
      <%= text_field_tag :code, nil, inputmode: "numeric", maxlength: 6, autocomplete: "one-time-code",
            autofocus: true, data: { otpboxes_target: "input", action: "input->otpboxes#paint" } %>
    </div>
    <%= submit_tag t("customer.profile.email_confirm_cta"), class: "l-btn l-btn-primary l-btn-block", style: "margin-top:20px;" %>
  <% end %>

  <%# The code lasts a minute; offering "resend" straight away just races the
      first email. Count it down, then reveal the action. %>
  <div style="margin-top:16px; font-size:13.5px; color:var(--ink-2);" data-controller="countdown" data-countdown-seconds-value="60">
    <span data-countdown-target="waiting" class="l-countdown">
      <%= ui_icon(:clock, size: 14) %>
      <%= t("customer.profile.email_code_valid") %> <strong data-countdown-target="clock">1:00</strong>
    </span>
    <span data-countdown-target="resend" hidden>
      <%= t("customer.profile.email_resend_prompt") %>
      <%= button_to t("customer.profile.email_resend"), member_profile_resend_email_change_path, method: :post,
            class: "l-linkbtn", form: { style: "display:inline;" } %>
    </span>
  </div>

  <div class="l-note" style="margin-top:22px; text-align:left;">
    <%= ui_icon(:shield, size: 16) %><span><%= t("customer.profile.email_security_note") %></span>
  </div>
</div>
