<% content_for :title, t("customer.profile.title") %>
<% content_for :tab, "me" %>
<header class="l-appbar">
  <%= member_avatar(@member, klass: "avatar") %>
  <div><div class="nm"><%= @member.display_name %></div><div class="hi"><%= @member.email.presence || @member.phone %></div></div>
</header>
<div class="l-screen">
  <% if @member.errors.any? %>
    <div class="l-tile" style="margin-bottom:14px; background:#F7E0DA; color:#B4402F;"><%= @member.errors.full_messages.to_sentence %></div>
  <% end %>

  <%# ---- Avatar upload (own form: click avatar → preview → save) ---- %>
  <div class="l-tile" style="margin-bottom:14px;">
    <%= form_with url: member_profile_avatar_path, method: :patch, multipart: true, data: { controller: "avatarupload", turbo: false } do %>
      <div style="display:flex; align-items:center; gap:16px;">
        <label style="position:relative; flex:none; cursor:pointer;" title="Đổi ảnh đại diện">
          <div data-avatarupload-target="box" style="width:72px; height:72px; border-radius:20px; overflow:hidden; background:var(--surface-2); color:var(--ink-2); display:grid; place-items:center; font-weight:700; font-size:22px;">
            <% if @member.avatar.attached? %>
              <%= image_tag rails_storage_proxy_path(@member.avatar, only_path: true), style: "width:100%;height:100%;object-fit:cover;" %>
            <% else %>
              <%= @member.initials %>
            <% end %>
          </div>
          <span style="position:absolute; right:-4px; bottom:-4px; width:28px; height:28px; border-radius:50%; background:var(--primary); color:var(--on-primary); display:grid; place-items:center; font-size:14px; box-shadow:0 2px 6px rgba(0,0,0,.2);">📷</span>
          <%= file_field_tag "member[avatar]", accept: "image/*", data: { avatarupload_target: "input", action: "avatarupload#change" }, style: "position:absolute; width:1px; height:1px; opacity:0; pointer-events:none;" %>
        </label>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:600;">Ảnh đại diện</div>
          <div style="font-size:13px; color:var(--ink-2); margin-top:2px;">Chạm vào ảnh để chọn ảnh mới.</div>
          <%= button_tag "Lưu ảnh", type: "submit", class: "l-btn l-btn-primary", data: { avatarupload_target: "save" }, style: "margin-top:10px; display:none; padding:8px 16px; font-size:13px;" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="l-tile" style="margin-bottom:14px;">
    <div class="l-display" style="font-size:16px; margin-bottom:12px;"><%= t("customer.profile.account") %></div>
    <%= form_with model: @member, url: member_profile_path, method: :patch, data: { turbo: false } do |f| %>
      <label class="l-label"><%= t("customer.profile.name") %></label>
      <%= f.text_field :name, class: "l-field", placeholder: t("customer.profile.name") %>

      <label class="l-label" style="margin-top:12px;"><%= t("customer.profile.email") %></label>
      <%= f.email_field :email, class: "l-field", autocomplete: "email", placeholder: "ban@vidu.com" %>
      <%# Email is the login and there is no password, so say what saving it does. %>
      <div style="font-size:12px; color:var(--ink-2); margin-top:6px;"><%= t("customer.profile.email_hint") %></div>
      <% if session[:pending_email].present? %>
        <div style="margin-top:8px; padding:9px 12px; border-radius:12px; background:var(--surface-2); font-size:12.5px;">
          <%= t("customer.profile.email_pending", email: session[:pending_email]) %>
          <%= link_to t("customer.profile.email_confirm_cta"), member_profile_confirm_email_path,
                style: "font-weight:700; color:var(--primary); text-decoration:underline;" %>
        </div>
      <% end %>

      <label class="l-label" style="margin-top:12px;"><%= t("customer.profile.phone") %></label>
      <%= f.telephone_field :phone, class: "l-field", autocomplete: "tel", inputmode: "numeric", placeholder: "0901234567" %>

      <label class="l-label" style="margin-top:12px;"><%= t("customer.profile.birthday") %></label>
      <%# Masked text field guarantees DD/MM/YYYY on every browser; a ghost
          overlay keeps the remaining DD/MM/YYYY template visible while typing. %>
      <div class="l-datefield" data-controller="datemask">
        <div class="l-datefield-ghost" data-datemask-target="ghost" aria-hidden="true"></div>
        <%= f.text_field :birthday, value: @member.birthday&.strftime("%d/%m/%Y"),
              class: "l-datefield-input", inputmode: "numeric", maxlength: 10,
              autocomplete: "bday",
              data: { datemask_target: "input", action: "input->datemask#format" } %>
      </div>
      <div style="font-size:12px; color:var(--ink-2); margin-top:6px;"><%= t("customer.profile.birthday_hint") %></div>

      <%= f.submit t("customer.profile.save"), class: "l-btn l-btn-primary l-btn-block", style: "margin-top:16px;" %>
    <% end %>
  </div>

  <div class="l-tile" style="margin-bottom:14px; padding:6px 16px;">
    <%= link_to member_history_path, class: "l-toggle-row", style: "text-decoration:none; color:var(--ink);" do %>
      <span><%= t("customer.profile.history") %></span><span style="color:var(--ink-2);">›</span>
    <% end %>
    <%= link_to member_tier_path, class: "l-toggle-row", style: "text-decoration:none; color:var(--ink);" do %>
      <span><%= t("customer.profile.tier") %></span><span style="color:var(--ink-2);">›</span>
    <% end %>
    <%= link_to member_notifications_path, class: "l-toggle-row", style: "text-decoration:none; color:var(--ink);" do %>
      <span><%= t("customer.profile.notifications") %></span><span style="color:var(--ink-2);">›</span>
    <% end %>
    <%= link_to member_refer_path, class: "l-toggle-row", style: "text-decoration:none; color:var(--ink);" do %>
      <span><%= t("customer.profile.refer") %></span><span style="color:var(--ink-2);">›</span>
    <% end %>
    <%= link_to member_new_review_path, class: "l-toggle-row", style: "text-decoration:none; color:var(--ink);" do %>
      <span>⭐ Đánh giá quán</span><span style="color:var(--ink-2);">›</span>
    <% end %>
    <% if current_workspace.feedback_public? %>
      <%= link_to member_shop_about_path, class: "l-toggle-row", style: "text-decoration:none; color:var(--ink);" do %>
        <span>🏬 Về quán &amp; đánh giá</span><span style="color:var(--ink-2);">›</span>
      <% end %>
    <% end %>
  </div>

  <div class="l-tile" style="margin-bottom:14px;">
    <div class="l-toggle-row"><span><%= t("customer.profile.language") %></span>
      <span style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden;">
        <% [["VI", :vi], ["EN", :en]].each do |label, loc| %>
          <% on = I18n.locale == loc %>
          <%= link_to label, set_locale_path(loc),
                style: "padding:6px 16px; font-size:12px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:var(--on-primary);' : 'color:var(--ink-2); background:transparent;'}" %>
        <% end %>
      </span>
    </div>
    <% if PushSender.configured? %>
      <div class="l-toggle-row" data-action="click->pwa#togglePush" style="cursor:pointer;">
        <span><%= t("customer.pwa.notifications") %><br><span data-pwa-target="pushLabel" style="font-size:12px; color:var(--ink-2);"></span></span>
        <span class="l-switch" data-pwa-target="pushToggle"><span class="knob"></span></span>
      </div>
    <% end %>
    <div class="l-toggle-row"><span><%= t("customer.profile.store") %></span><span style="color:var(--ink-2);"><%= current_workspace.name %></span></div>
    <div class="l-toggle-row"><span><%= t("customer.profile.referral_code") %></span><span class="l-mono"><%= @member.referral_code %></span></div>
  </div>
  <%= button_to t("customer.profile.logout"), member_logout_path, method: :delete,
        form: { data: { turbo_confirm: t("customer.profile.logout") + "?" } },
        class: "l-btn l-btn-ghost l-btn-block" %>
</div>
