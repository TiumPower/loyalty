<% content_for :title, t("customer.profile.title") %>
<% content_for :tab, "me" %>
<% tier = @member.tier %>

<%# The design centres the title between a back button and a matching spacer. %>
<header class="l-subhead" style="padding-bottom:6px;">
  <%= link_to member_root_path, class: "l-iconbtn sm", "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 17) %>
  <% end %>
  <div style="flex:1; text-align:center;"><div style="font-size:17px; font-weight:700;"><%= t("customer.profile.title") %></div></div>
  <span style="width:34px; flex:none;"></span>
</header>

<div class="l-screen" style="padding-top:8px;">
  <%# ---- who you are ---- %>
  <div style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:12px 0 6px;">
    <%= member_avatar(@member, klass: "", style: "width:80px; height:80px; border-radius:50%; background:var(--primary); color:var(--on-primary); display:grid; place-items:center; font-weight:700; font-size:28px; overflow:hidden;") %>
    <div style="font-weight:700; font-size:20px; letter-spacing:-.02em; margin-top:14px;"><%= @member.display_name %></div>
    <div style="font-size:13.5px; color:var(--ink-2); margin-top:3px;"><%= @member.email.presence || @member.phone %></div>
    <%= link_to t("customer.profile.edit"), member_edit_profile_path,
          style: "margin-top:12px; font-size:13.5px; font-weight:700; color:var(--primary); text-decoration:none;" %>
  </div>

  <%# ---- three numbers ---- %>
  <div class="l-stats" style="border:none; box-shadow:none; background:transparent; border-radius:0; padding:16px 0;">
    <div>
      <div class="v"><%= number_with_delimiter(@member.points_balance) %></div>
      <div class="k"><%= t("customer.common.points_unit").upcase %></div>
    </div>
    <div>
      <div class="v"><%= tier&.name || "—" %></div>
      <div class="k"><%= t("customer.profile.tier") %></div>
    </div>
    <div>
      <div class="v"><%= @member.referrals_made.count %></div>
      <div class="k"><%= t("customer.referrals.invited") %></div>
    </div>
  </div>

  <%# ---- tier progress ---- %>
  <% if tier %>
    <div class="l-tile">
      <div style="display:flex; align-items:flex-start; gap:12px;">
        <div style="flex:1; min-width:0;">
          <div class="l-eyebrow"><%= t("customer.profile.loyalty") %></div>
          <div style="font-weight:700; font-size:16px; margin-top:3px;"><%= t("customer.profile.tier_named", name: tier.name) %></div>
        </div>
        <span class="l-pill gold" style="flex:none;"><%= tier.name %></span>
      </div>
      <% if @member.next_tier %>
        <div class="l-bar thick" style="margin-top:14px;"><span style="width:<%= @member.tier_progress_pct %>%;"></span></div>
        <div style="display:flex; justify-content:space-between; gap:10px; font-size:12px; color:var(--ink-2); margin-top:8px;">
          <span><%= number_with_delimiter(@member.points_balance) %> / <%= number_with_delimiter(@member.next_tier.threshold_points) %> <%= t("customer.common.points_unit").upcase %></span>
          <span><%= t("customer.tiers.to_next_short", n: number_with_delimiter(@member.points_to_next), tier: @member.next_tier.name) %></span>
        </div>
      <% end %>
      <%= link_to member_tier_path, style: "display:flex; align-items:center; gap:6px; margin-top:14px; font-size:13.5px; font-weight:700; color:var(--primary); text-decoration:none;" do %>
        <%= t("customer.profile.view_benefits") %><%= ui_icon(:chevron_right, size: 15, stroke: 2.4) %>
      <% end %>
    </div>
  <% end %>

  <%# ---- point history, on its own row as the design has it ---- %>
  <div class="l-rows" style="margin-top:14px;">
    <%= link_to member_history_path do %>
      <span class="ic"><%= ui_icon(:history, size: 20) %></span>
      <span style="flex:1; min-width:0;"><%= t("customer.home.view_history") %></span>
      <span class="tr"><%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %></span>
    <% end %>
  </div>

  <%# ---- settings ---- %>
  <div class="l-rows" style="margin-top:14px;">
    <div>
      <span class="ic"><%= ui_icon(:globe, size: 20) %></span>
      <span style="flex:1; min-width:0;"><%= t("customer.profile.language") %></span>
      <span class="tr" style="gap:0;">
        <span style="display:inline-flex; border:1px solid var(--line); border-radius:999px; overflow:hidden;">
          <% [["VI", :vi], ["EN", :en]].each do |label, loc| %>
            <% on = I18n.locale == loc %>
            <%= link_to label, set_locale_path(loc),
                  style: "padding:6px 15px; font-size:12px; font-weight:700; text-decoration:none; #{on ? 'background:var(--primary); color:var(--on-primary);' : 'color:var(--ink-2); background:transparent;'}" %>
          <% end %>
        </span>
      </span>
    </div>

    <%# The design's "Notification Settings" row is where web push lives. %>
    <% if PushSender.configured? %>
      <div data-action="click->pwa#togglePush" style="cursor:pointer;">
        <span class="ic"><%= ui_icon(:bell, size: 20) %></span>
        <span style="flex:1; min-width:0;">
          <%= t("customer.profile.notification_settings") %>
          <span data-pwa-target="pushLabel" style="display:block; font-size:12px; color:var(--ink-2);"></span>
        </span>
        <span class="tr"><span class="l-switch" data-pwa-target="pushToggle"><span class="knob"></span></span></span>
      </div>
    <% end %>

    <%= link_to member_notifications_path do %>
      <span class="ic"><%= ui_icon(:mail, size: 20) %></span>
      <span style="flex:1; min-width:0;"><%= t("customer.profile.notifications") %></span>
      <span class="tr"><%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %></span>
    <% end %>

    <% if current_workspace.program.referral_enabled %>
      <%= link_to member_refer_path do %>
        <span class="ic"><%= ui_icon(:users, size: 20) %></span>
        <span style="flex:1; min-width:0;"><%= t("customer.profile.refer") %></span>
        <span class="tr"><span class="l-mono"><%= @member.referral_code %></span><%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %></span>
      <% end %>
    <% end %>

    <%# "Privacy & Security" in the design; here it is the one honest thing the
        app can say about the data it holds. %>
    <%= link_to member_edit_profile_path do %>
      <span class="ic"><%= ui_icon(:shield, size: 20) %></span>
      <span style="flex:1; min-width:0;"><%= t("customer.profile.privacy") %></span>
      <span class="tr"><%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %></span>
    <% end %>

    <%# "Help & Support" → the shop itself, which is who can actually help. %>
    <% if current_workspace.feedback_public? %>
      <%= link_to member_shop_about_path do %>
        <span class="ic"><%= ui_icon(:help, size: 20) %></span>
        <span style="flex:1; min-width:0;"><%= t("customer.profile.help") %></span>
        <span class="tr"><%= current_workspace.name %><%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %></span>
      <% end %>
    <% end %>
  </div>

  <div style="text-align:center; margin-top:26px;">
    <%= button_to t("customer.profile.logout"), member_logout_path, method: :delete,
          form: { data: { turbo_confirm: t("customer.profile.logout") + "?" } },
          class: "l-btn l-btn-ghost l-btn-block", style: "color:var(--warn);" %>
    <div style="font-size:11.5px; color:var(--ink-2); margin-top:14px;"><%= current_workspace.name %></div>
  </div>
</div>
