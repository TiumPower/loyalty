<% content_for :title, t("customer.wallet.title") %>
<% content_for :tab, "wallet" %>
<header class="l-appbar">
  <div class="nm l-display" style="font-size:22px;"><%= t("customer.wallet.title") %></div>
  <span class="l-chip l-chip-brand" style="margin-left:auto;"><%= t("customer.common.points_count", n: number_with_delimiter(@member.points_balance)) %></span>
</header>

<div class="l-screen" data-controller="tabs" data-tabs-active-class-value="active" data-tabs-active-value="<%= %w[rewards owned expiring].include?(params[:tab]) ? params[:tab] : @default_tab %>">
  <% usable_count = @vouchers.count(&:usable?) %>
  <div class="l-wtabs">
    <button data-tabs-target="tab" data-name="rewards" data-action="tabs#select"><%= t("customer.wallet.tab_redeemable") %></button>
    <button data-tabs-target="tab" data-name="owned" data-action="tabs#select" style="position:relative;">
      <%= t("customer.wallet.tab_owned") %>
      <% if usable_count > 0 %>
        <span style="position:absolute; top:-4px; right:-2px; min-width:18px; height:18px; padding:0 5px; border-radius:999px; background:var(--primary-2,#E08A3C); color:#fff; font-size:11px; font-weight:700; line-height:18px; text-align:center; box-shadow:0 1px 3px rgba(0,0,0,.2);"><%= usable_count %></span>
      <% end %>
    </button>
    <button data-tabs-target="tab" data-name="expiring" data-action="tabs#select"><%= t("customer.wallet.tab_expiring") %></button>
  </div>

  <%# ---- Có thể đổi (catalog) ---- %>
  <div data-tabs-target="panel" data-name="rewards">
    <% if @rewards.empty? %>
      <%= render "customer/wallet/empty", icon: "🎁", text: t("customer.wallet.empty_redeemable") %>
    <% else %>
      <% @rewards.each do |r| %>
        <% open = r.redeem_open? %>
        <% hint = r.redeem_window_hint %>
        <%= link_to member_reward_path(r), class: "l-ticket", style: "margin-bottom:12px; position:relative; #{'opacity:.62; filter:grayscale(.35);' unless open}" do %>
          <div class="stub"><div class="v"><%= r.value_label %></div><div class="u"><%= r.kind_label %></div></div>
          <div class="perf"></div>
          <div class="body">
            <div style="font-weight:700;"><%= r.display_icon %> <%= r.title %></div>
            <div style="font-size:12px; color:var(--ink-2); margin:4px 0;"><%= truncate(r.description.to_s, length: 60) %></div>
            <div style="display:flex; align-items:center; gap:8px; margin-top:6px; flex-wrap:wrap;">
              <span class="l-chip l-chip-brand"><%= t("customer.common.points_count", n: number_with_delimiter(r.cost_points)) %></span>
              <% if r.remaining %><span class="l-chip"><%= t("customer.wallet.remaining", n: r.remaining) %></span><% end %>
              <% if !open && hint %>
                <span class="l-chip" style="background:var(--surface-2); color:var(--ink-2);">🕑 <%= hint %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# ---- Đã đổi (owned vouchers) ---- %>
  <div data-tabs-target="panel" data-name="owned" hidden>
    <% if @vouchers.empty? %>
      <%= render "customer/wallet/empty", icon: "🎟️", text: t("customer.wallet.empty_owned") %>
    <% else %>
      <% @vouchers.each do |v| %><%= render "customer/wallet/voucher", v: v %><% end %>
    <% end %>
  </div>

  <%# ---- Sắp hết hạn ---- %>
  <div data-tabs-target="panel" data-name="expiring" hidden>
    <% if @expiring.empty? %>
      <%= render "customer/wallet/empty", icon: "⏳", text: t("customer.wallet.empty_expiring") %>
    <% else %>
      <% @expiring.each do |v| %><%= render "customer/wallet/voucher", v: v %><% end %>
    <% end %>
  </div>
</div>
