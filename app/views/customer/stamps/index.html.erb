<% content_for :title, t("customer.stamps.title") %>
<% content_for :tab, "" %>
<header class="l-appbar">
  <%= link_to "←", member_root_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;"><%= t("customer.stamps.title") %></div>
</header>

<div class="l-screen">
  <% if @cards.empty? %>
    <div class="l-tile" style="text-align:center; padding:40px 20px;">
      <div style="font-size:40px;">🎟️</div>
      <p style="font-weight:600; margin-top:8px;"><%= t("customer.stamps.empty") %></p>
    </div>
  <% else %>
    <% @cards.each do |card| %>
      <% m = @memberships[card]; count = m.count %>
      <div class="l-tile" style="margin-bottom:16px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:26px;"><%= card.display_icon %></span>
          <div style="flex:1;">
            <div style="font-weight:700;"><%= card.title %></div>
            <div style="font-size:12px; color:var(--ink-2);"><%= card.description %></div>
          </div>
          <span class="l-chip l-chip-brand"><%= count %>/<%= card.target_count %></span>
        </div>

        <div class="l-stamp-grid">
          <% card.target_count.times do |i| %>
            <% last = i == card.target_count - 1 %>
            <div class="l-stamp-dot <%= 'filled' if i < count %> <%= 'reward' if last && i >= count %>">
              <%= last ? (i < count ? "★" : (card.reward&.display_icon || "🎁")) : (i < count ? "✓" : (i + 1)) %>
            </div>
          <% end %>
        </div>

        <% if card.reward %>
          <p style="font-size:12px; color:var(--ink-2); margin-top:12px;"><%= t("customer.stamps.complete_to_get_html", reward: card.reward.title) %><% if m.completed_count.positive? %><%= t("customer.stamps.redeemed_times", n: m.completed_count) %><% end %></p>
          <%# Card full but the prize ran out: the stamps are kept, so say so —
              otherwise a full card that pays out nothing looks broken. %>
          <% if m.held_for_stock? %>
            <div style="margin-top:10px; padding:10px 12px; border-radius:12px; background:var(--surface-2); font-size:12.5px; line-height:1.5;">
              <strong>⏳ <%= t("customer.stamps.held_title") %></strong>
              <div style="color:var(--ink-2); margin-top:2px;"><%= t("customer.stamps.held_body", reward: card.reward.title) %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
