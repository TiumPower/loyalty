<% content_for :title, t("customer.stamps.title") %>
<%= stamp_ink_filter %>
<% content_for :tab, "" %>
<header class="l-subhead">
  <%= link_to member_root_path, class: "l-iconbtn", data: { controller: "goback", action: "goback#back" }, "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;">
    <div class="t"><%= t("customer.stamps.title") %></div>
    <div class="s"><%= t("customer.stamps.subtitle") %></div>
  </div>
  <div class="sp"><span class="l-pill brand"><%= t("customer.common.points_count", n: number_with_delimiter(@member.points_balance)) %></span></div>
</header>

<div class="l-screen">
  <% if @cards.empty? %>
    <div class="l-empty">
      <div class="ic"><%= ui_icon(:stamp, size: 26) %></div>
      <div class="tt"><%= t("customer.stamps.empty") %></div>
      <div class="mt"><%= t("customer.stamps.empty_sub") %></div>
    </div>
  <% else %>
    <% @cards.each do |card| %>
      <% m = @memberships[card]; count = m.count; target = card.target_count; left = [target - count, 0].max %>
      <div class="l-tile" style="margin-bottom:14px;">
        <div style="font-weight:700; font-size:16px; letter-spacing:-.015em;"><%= card.title %></div>
        <% if card.description.present? %>
          <div style="font-size:13px; color:var(--ink-2); margin-top:4px; line-height:1.45;"><%= card.description %></div>
        <% end %>

        <div class="l-stamps" style="margin-top:16px;">
          <% target.times do |i| %>
            <% last = i == target - 1 %>
            <div class="s <%= 'on' if i < count %> <%= 'goal' if last && i >= count %>">
              <% if i < count %><%= stamp_mark(i + 1) %>
              <% elsif last %><%= ui_icon(:gift, size: 16) %>
              <% else %><%= i + 1 %><% end %>
            </div>
          <% end %>
        </div>

        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-top:18px;">
          <div style="font-size:13px; font-weight:600; color:var(--ink-2);"><%= t("customer.stamps.progress") %></div>
          <div style="font-size:26px; font-weight:700; letter-spacing:-.03em; line-height:1; font-variant-numeric:tabular-nums;">
            <%= count %><span style="color:var(--ink-2); font-size:.6em;"> / <%= target %></span>
          </div>
        </div>

        <% if card.reward %>
          <div style="height:1px; background:var(--line-soft); margin:14px 0;"></div>
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:48px; height:48px; border-radius:12px; flex:none; overflow:hidden; background:var(--primary-soft); display:grid; place-items:center; font-size:20px;">
              <%= reward_art(card.reward, size: 140, emoji_size: 20) %>
            </div>
            <div style="min-width:0;">
              <div class="l-eyebrow"><%= t("customer.stamps.your_reward") %></div>
              <div style="font-weight:700; font-size:14.5px; margin-top:2px;"><%= card.reward.title %></div>
            </div>
          </div>
        <% end %>

        <%# Card full but the prize ran out: the stamps are kept, so say so —
            otherwise a full card that pays out nothing looks broken. %>
        <% if m.held_for_stock? %>
          <div class="l-note amber" style="margin-top:12px;">
            <%= ui_icon(:clock, size: 16) %>
            <span><strong><%= t("customer.stamps.held_title") %></strong><br><%= t("customer.stamps.held_body", reward: card.reward.title) %></span>
          </div>
        <% end %>
        <% if m.completed_count.positive? %>
          <div style="font-size:12.5px; color:var(--ink-2); margin-top:10px;"><%= t("customer.stamps.redeemed_times", n: m.completed_count) %></div>
        <% end %>
      </div>

      <%# The design's nudge: a small character with one encouraging line. %>
      <% if left.positive? %>
        <div style="display:flex; align-items:flex-start; gap:12px; margin:-4px 0 20px;">
          <div style="width:52px; height:52px; border-radius:50%; flex:none; background:var(--primary-soft);
                      display:grid; place-items:center; font-size:26px;"><%= card.display_icon %></div>
          <div class="l-bubble"><%= t("customer.stamps.almost_there", n: left) %></div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
