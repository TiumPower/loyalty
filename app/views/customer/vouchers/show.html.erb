<% content_for :title, @voucher.reward.title %>
<% content_for :tab, "wallet" %>
<% ink = current_workspace.theme_value(:ink).to_s.delete("#") %>
<% in_use = @voucher.usable? && @voucher.redeem_token.present? && @voucher.redeem_token_expires_at&.future? %>

<header class="l-appbar">
  <%= link_to "←", member_wallet_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:20px;"><%= t("customer.voucher.title") %></div>
</header>

<div class="l-screen">
  <% if @voucher.state == "used" %>
    <%# ---- Used confirmation ---- %>
    <div class="l-tile" style="text-align:center; padding:34px 20px;">
      <div style="width:76px; height:76px; margin:0 auto 14px; border-radius:50%; background:var(--good); color:#fff; display:grid; place-items:center; font-size:38px;">✓</div>
      <h3 class="l-display" style="font-size:22px;"><%= t("customer.voucher.used_title") %></h3>
      <p style="font-weight:600; margin-top:4px;"><%= @voucher.reward.title %></p>
      <p style="color:var(--ink-2); font-size:13px; margin-top:8px;">
        <%= t("customer.voucher.used_time", time: @voucher.used_at&.strftime("%H:%M · %d/%m/%Y")) %>
        <%= t("customer.voucher.used_at_outlet", outlet: @voucher.used_outlet.name) if @voucher.used_outlet %>
      </p>
    </div>

  <% elsif @voucher.expired? %>
    <div class="l-tile" style="text-align:center; padding:34px 20px;">
      <div style="font-size:42px;">⌛</div>
      <h3 class="l-display" style="font-size:20px; margin-top:8px;"><%= t("customer.voucher.expired_title") %></h3>
      <p style="color:var(--ink-2); font-size:13px;"><%= t("customer.common.code_label") %> <%= @voucher.code %></p>
    </div>

  <% elsif in_use %>
    <%# ---- Point-of-use one-time code (§6.4) ---- %>
    <div data-controller="usecode"
         data-usecode-status-url-value="<%= member_voucher_status_path(@voucher) %>"
         data-usecode-seconds-value="<%= @voucher.use_token_seconds_left %>"
         data-usecode-return-url-value="<%= member_voucher_path(@voucher) %>">
      <div class="l-tile" style="text-align:center; padding:24px;">
        <p style="font-weight:700;"><%= @voucher.reward.display_icon %> <%= @voucher.reward.title %></p>
        <p style="color:var(--warn); font-weight:700; margin:10px 0;">
          <%= t("customer.voucher.use_expires_pre") %> <span data-usecode-target="count" class="l-mono"><%= @voucher.use_token_seconds_left %></span>s
        </p>
        <div style="display:inline-block; padding:14px; background:#fff; border:1px solid var(--line); border-radius:16px;">
          <%= qr_svg(@voucher.redeem_token, color: ink, size: 200) %>
        </div>
        <div style="margin-top:16px;">
          <div class="l-eyebrow"><%= t("customer.voucher.fallback_label") %></div>
          <div class="l-mono" style="font-size:26px; letter-spacing:.16em; font-weight:700; margin-top:4px;"><%= @voucher.formatted_use_token %></div>
        </div>
      </div>
      <p style="text-align:center; color:var(--ink-2); font-size:13px; margin-top:14px;"><%= t("customer.voucher.hand_to_staff") %></p>
      <%= link_to t("customer.voucher.cancel_later"), member_wallet_path, class: "l-btn l-btn-ghost l-btn-block", style: "margin-top:8px;" %>
    </div>

  <% else %>
    <%# ---- Active voucher detail — start using ---- %>
    <div class="l-ticket" style="margin-bottom:16px;">
      <div class="stub"><div class="v"><%= @voucher.reward.value_label %></div><div class="u"><%= @voucher.reward.kind_label %></div></div>
      <div class="perf"></div>
      <div class="body">
        <div style="font-weight:700; font-size:17px;"><%= @voucher.reward.display_icon %> <%= @voucher.reward.title %></div>
        <div style="font-size:12px; color:var(--ink-2); margin-top:6px;"><%= t("customer.common.code_label") %> <span class="l-mono"><%= @voucher.code %></span><% if @voucher.expires_at %> · <%= t("customer.common.exp_short", date: l(@voucher.expires_at.to_date, format: :short)) %><% end %></div>
      </div>
    </div>
    <% if @voucher.reward.description.present? %>
      <div class="l-tile" style="margin-bottom:16px; font-size:13px; color:var(--ink-2);"><%= @voucher.reward.description %></div>
    <% end %>
    <%= button_to t("customer.voucher.use_now"), member_use_voucher_path(@voucher), method: :post, class: "l-btn l-btn-primary l-btn-block" %>
    <p style="text-align:center; color:var(--ink-2); font-size:12px; margin-top:10px;"><%= t("customer.voucher.use_hint", min: (Voucher::USE_TTL / 60)) %></p>
  <% end %>
</div>
