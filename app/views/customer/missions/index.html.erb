<% content_for :title, t("customer.missions.title") %>
<% content_for :tab, "missions" %>
<%
  groups = [["daily",  t("customer.missions.today")],
            ["weekly", t("customer.missions.this_week")],
            ["once",   t("customer.missions.one_time")]]
  open_missions = @missions.reject { |m| @progress[m].completed? }
  done_missions = @missions.select { |m| @progress[m].completed? }
%>

<header class="l-head" style="padding-bottom:6px;">
  <div style="min-width:0;">
    <div class="t"><%= t("customer.missions.title_shop", shop: current_workspace.name) %></div>
    <div class="s"><%= t("customer.missions.subtitle_shop", shop: current_workspace.name) %></div>
  </div>
  <div class="sp"><span class="l-pill brand"><%= t("customer.missions.active_count", n: open_missions.size) %></span></div>
</header>

<div class="l-screen">
  <p style="font-size:13px; color:var(--ink-2); line-height:1.55; margin-bottom:16px;">
    <%= t("customer.missions.explainer") %>
  </p>

  <%# Badges live under Missions in the design — their screen carries the
      Missions tab. They had no entry point but a link at the foot of the tier
      screen, which nobody was going to find. %>
  <% if current_workspace.program.gamification_enabled %>
    <%= link_to member_badges_path, class: "l-action", style: "margin-bottom:16px;" do %>
      <%= ui_icon(:trophy, size: 18) %>
      <span style="flex:1; min-width:0; text-align:left;">
        <span style="display:block; font-weight:700;"><%= t("customer.badges.title") %></span>
        <span style="display:block; font-size:12.5px; color:var(--ink-2);"><%= t("customer.badges.subtitle") %></span>
      </span>
      <%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %>
    <% end %>
  <% end %>

  <% if @missions.empty? %>
    <div class="l-empty">
      <div class="ic"><%= ui_icon(:target, size: 28) %></div>
      <div class="tt"><%= t("customer.missions.empty") %></div>
      <div class="mt"><%= t("customer.missions.empty_sub") %></div>
    </div>
  <% else %>
    <%# One tab per group, plus "all" — tapping one shows that group. They used
        to be anchors that jumped to a heading, which on a card with two missions
        moved the page barely a hundred pixels and read as a dead tab. %>
    <% shown = groups.select { |period, _| open_missions.any? { |m| m.period == period } } %>
    <div data-controller="groupfilter">
      <% if shown.size > 1 %>
        <div class="l-seg boxed">
          <button type="button" data-groupfilter-target="tab" data-group="all"
                  data-action="groupfilter#pick"><%= t("customer.missions.all") %></button>
          <% shown.each do |period, label| %>
            <button type="button" data-groupfilter-target="tab" data-group="<%= period %>"
                    data-action="groupfilter#pick"><%= label %></button>
          <% end %>
        </div>
      <% end %>

      <% shown.each do |period, label| %>
        <div data-groupfilter-target="group" data-group="<%= period %>">
          <div class="l-grouplabel"><%= label %></div>
          <% open_missions.select { |m| m.period == period }.each { |m| %><%= render "customer/missions/card", m: m, mp: @progress[m] %><% } %>
        </div>
      <% end %>
    </div>

    <% if done_missions.any? %>
      <div class="l-grouplabel"><%= t("customer.missions.completed") %></div>
      <% done_missions.each do |m| %>
        <div class="l-row dim">
          <span class="ic muted"><%= mission_icon(m, size: 18) %></span>
          <div class="bd">
            <div class="tt" style="text-decoration:line-through;"><%= m.title %></div>
            <div class="mt"><%= current_workspace.name %> · <%= t("customer.missions.done_note", n: m.reward_points) %></div>
          </div>
          <span class="tr" style="color:var(--good);"><%= ui_icon(:check, size: 19, stroke: 2.4) %></span>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
