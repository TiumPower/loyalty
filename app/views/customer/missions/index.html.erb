<% content_for :title, t("customer.missions.title") %>
<% content_for :tab, "missions" %>
<%
  groups = [["daily",  t("customer.missions.today")],
            ["weekly", t("customer.missions.this_week")],
            ["once",   t("customer.missions.one_time")]]
  open_missions = @missions.reject { |m| @progress[m].completed? }
  done_missions = @missions.select { |m| @progress[m].completed? }
%>

<header class="l-head" style="padding-bottom:6px;">
  <div style="min-width:0;">
    <div class="t"><%= t("customer.missions.title_shop", shop: current_workspace.name) %></div>
    <div class="s"><%= t("customer.missions.subtitle_shop", shop: current_workspace.name) %></div>
  </div>
  <div class="sp"><span class="l-pill brand"><%= t("customer.missions.active_count", n: open_missions.size) %></span></div>
</header>

<div class="l-screen">
  <p style="font-size:13px; color:var(--ink-2); line-height:1.55; margin-bottom:16px;">
    <%= t("customer.missions.explainer") %>
  </p>

  <% if @missions.empty? %>
    <div class="l-empty">
      <div class="ic"><%= ui_icon(:target, size: 28) %></div>
      <div class="tt"><%= t("customer.missions.empty") %></div>
      <div class="mt"><%= t("customer.missions.empty_sub") %></div>
    </div>
  <% else %>
    <%# The tabs jump to a group rather than hiding the others — the design
        lists every group on one page and explains that above. %>
    <div class="l-seg boxed">
      <% groups.each do |period, label| %>
        <% next if open_missions.none? { |m| m.period == period } %>
        <a href="#g-<%= period %>"><%= label %></a>
      <% end %>
    </div>

    <% groups.each do |period, label| %>
      <% list = open_missions.select { |m| m.period == period } %>
      <% next if list.empty? %>
      <div class="l-grouplabel" id="g-<%= period %>" style="scroll-margin-top:12px;"><%= label %></div>
      <% list.each { |m| %><%= render "customer/missions/card", m: m, mp: @progress[m] %><% } %>
    <% end %>

    <% if done_missions.any? %>
      <div class="l-grouplabel"><%= t("customer.missions.completed") %></div>
      <% done_missions.each do |m| %>
        <div class="l-row dim">
          <span class="ic muted"><%= mission_icon(m, size: 18) %></span>
          <div class="bd">
            <div class="tt" style="text-decoration:line-through;"><%= m.title %></div>
            <div class="mt"><%= current_workspace.name %> · <%= t("customer.missions.done_note", n: m.reward_points) %></div>
          </div>
          <span class="tr" style="color:var(--good);"><%= ui_icon(:check, size: 19, stroke: 2.4) %></span>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
