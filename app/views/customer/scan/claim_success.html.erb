<% content_for :title, t("customer.claim_success.title") %>
<% content_for :tab, "" %>
<div class="l-screen" data-controller="pointburst sfx" style="display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:80vh; text-align:center;">
  <div style="font-size:72px; animation:none;">🎁</div>
  <h2 class="l-display" style="font-size:26px; margin-top:8px;"><%= t("customer.claim_success.heading") %></h2>
  <div class="l-ticket" style="margin:20px 0; width:100%; max-width:360px;">
    <div class="stub"><div class="v"><%= @voucher.reward.value_label %></div><div class="u"><%= @voucher.reward.kind_label %></div></div>
    <div class="perf"></div>
    <div class="body" style="text-align:left;">
      <div style="font-weight:700;"><%= @voucher.reward.display_icon %> <%= @voucher.reward.title %></div>
      <div style="font-size:12px; color:var(--good); margin-top:4px;"><%= t("customer.claim_success.saved") %></div>
    </div>
  </div>
  <p style="color:var(--ink-2); font-size:13px;"><%= t("customer.claim_success.free_note") %></p>
  <%= link_to t("customer.claim_success.view_in_wallet"), member_wallet_path, class: "l-btn l-btn-primary l-btn-block", style: "margin-top:18px; max-width:360px;" %>
  <%= link_to t("customer.common.scan_other"), member_scan_path, style: "margin-top:12px; color:var(--ink-2); font-size:13px; text-decoration:none;" %>
</div>
