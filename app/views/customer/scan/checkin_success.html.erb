<% content_for :title, t("customer.checkin.success_title") %>
<% content_for :tab, "" %>
<div class="l-screen no-tabs" data-controller="pointburst sfx" style="padding-top:24px;">
  <div class="l-result">
    <div class="halo"><%= ui_icon(:pin, size: 38) %></div>
    <% if @points.to_i.positive? %>
      <span class="l-pill good" style="margin-top:2px;"><%= t("customer.checkin.checked_in") %></span>
      <h1><%= t("customer.earn_success.heading_points", n: number_with_delimiter(@points)) %></h1>
      <p><%= t("customer.checkin.success_points", n: number_with_delimiter(current_member.points_balance)) %></p>
    <% else %>
      <h1><%= t("customer.checkin.success_heading") %></h1>
      <p><%= t("customer.checkin.success_recorded") %></p>
    <% end %>
  </div>
  <div style="display:flex; flex-direction:column; gap:10px; margin-top:26px;">
    <%= link_to t("customer.common.home_back"), member_root_path, class: "l-btn l-btn-primary l-btn-block" %>
    <%= link_to t("customer.missions.title"), member_missions_path, class: "l-btn l-btn-outline l-btn-block" %>
  </div>
</div>
