<% content_for :title, t("customer.scan.title") %>
<% content_for :tab, "" %>

<%# Every status the scanner shows used to be a Vietnamese literal inside the
    Stimulus controller, so an English customer was told in Vietnamese that
    their camera was blocked. Handed in, like the PWA prompts already are. %>
<div data-controller="qrnav" data-qrnav-resolve-url-value="<%= member_scan_resolve_path %>"
     data-qrnav-scanning-text-value="<%= t("customer.scan.js_scanning") %>"
     data-qrnav-denied-text-value="<%= t("customer.scan.js_denied") %>"
     data-qrnav-unsupported-text-value="<%= t("customer.scan.js_unsupported") %>"
     data-qrnav-failed-text-value="<%= t("customer.scan.js_failed") %>">

  <%# The camera half of the screen inverts to dark chrome, as in the design —
      it reads as a viewfinder rather than a page. %>
  <header class="l-darkbar">
    <%= link_to member_my_code_path, class: "l-iconbtn sm", "aria-label": t("customer.common.back") do %>
      <%= ui_icon(:arrow_left, size: 17) %>
    <% end %>
    <div class="t"><%= t("customer.scan.checkin_title") %></div>
    <%= link_to member_root_path, class: "l-iconbtn sm", "aria-label": t("customer.common.close") do %>
      <%= ui_icon(:close, size: 17) %>
    <% end %>
  </header>

  <div class="l-viewfinder">
    <video data-qrnav-target="video" playsinline muted></video>
    <div class="l-reticle"><i></i><i></i><i></i><i></i></div>
    <%# Shown for half a second once a code is read, so the scan visibly lands. %>
    <div class="l-recognised" data-qrnav-target="recognised" hidden>
      <span style="width:40px; height:40px; border-radius:11px; flex:none; display:grid; place-items:center; background:rgba(255,255,255,.16);">
        <%= ui_icon(:tag, size: 19) %>
      </span>
      <div style="min-width:0;">
        <div style="font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; opacity:.7;"><%= t("customer.scan.recognised") %></div>
        <div style="font-weight:700; font-size:14px; margin-top:2px;"><%= current_workspace.name %></div>
      </div>
    </div>
    <div class="l-camprompt" data-qrnav-target="overlay">
      <div class="inner">
        <div style="font-size:19px; font-weight:700; letter-spacing:-.02em;"><%= t("customer.scan.prompt_title") %></div>
        <p style="font-size:13.5px; opacity:.78; line-height:1.5; margin:8px 0 18px;"><%= t("customer.scan.prompt") %></p>
        <button type="button" class="l-btn l-btn-primary" data-action="qrnav#start">
          <%= ui_icon(:scan, size: 17) %><%= t("customer.scan.start_camera") %>
        </button>
        <p style="font-size:11.5px; opacity:.6; line-height:1.4; margin-top:12px;"><%= t("customer.scan.camera_hint") %></p>
      </div>
    </div>
  </div>

  <div class="l-screen" style="padding-top:16px;">
    <p data-qrnav-target="status" style="text-align:center; color:var(--ink-2); font-size:12.5px; margin-bottom:12px;"></p>

    <%# What the shop's QR is worth, so the reason to point a camera at it is on
        screen before the camera is even open. %>
    <div class="l-tile">
      <div style="display:flex; align-items:center; gap:12px;">
        <span style="width:40px; height:40px; border-radius:12px; flex:none; display:grid; place-items:center; background:var(--primary-soft); color:var(--primary);">
          <%= ui_icon(:pin, size: 19) %>
        </span>
        <div style="flex:1; min-width:0;">
          <div class="l-eyebrow"><%= t("customer.scan.daily_checkin") %></div>
          <div style="font-weight:700; font-size:15px; margin-top:3px;"><%= t("customer.scan.checkin_ready") %></div>
        </div>
      </div>
      <p style="font-size:13px; color:var(--ink-2); line-height:1.5; margin-top:10px;"><%= t("customer.scan.checkin_explainer") %></p>

      <%# What it is worth. The design names a number here; this screen used to
          say only "để nhận điểm", which is not a reason to open a camera. %>
      <% if @checkin_points.to_i.positive? %>
        <div class="l-delta" style="margin-top:12px;">
          <div>
            <div class="k"><%= t("customer.scan.what_you_earn") %></div>
            <div class="v hi">+<%= t("customer.common.points_count", n: number_with_delimiter(@checkin_points)) %></div>
          </div>
          <span class="l-pill <%= @checked_in_today ? "" : "good" %>" style="flex:none;">
            <%= @checked_in_today ? t("customer.scan.done_today") : t("customer.scan.once_a_day") %>
          </span>
        </div>
      <% end %>
    </div>

    <%# The other thing this camera does. The screen used to name only check-in,
        so nobody knew a campaign poster's QR was worth pointing it at. %>
    <div class="l-tile" style="margin-top:10px;">
      <div style="display:flex; align-items:center; gap:12px;">
        <span style="width:40px; height:40px; border-radius:12px; flex:none; display:grid; place-items:center; background:var(--primary-soft); color:var(--primary);">
          <%= ui_icon(:gift, size: 19) %>
        </span>
        <div style="flex:1; min-width:0;">
          <div class="l-eyebrow"><%= t("customer.scan.campaign_gift") %></div>
          <div style="font-weight:700; font-size:15px; margin-top:3px;"><%= t("customer.scan.campaign_ready") %></div>
        </div>
      </div>
      <p style="font-size:13px; color:var(--ink-2); line-height:1.5; margin-top:10px;"><%= t("customer.scan.campaign_explainer") %></p>
    </div>

    <div style="display:flex; align-items:center; gap:10px; margin:18px 0; color:var(--ink-2); font-size:12.5px;">
      <span style="flex:1; height:1px; background:var(--line);"></span><%= t("customer.scan.or_enter") %><span style="flex:1; height:1px; background:var(--line);"></span>
    </div>

    <%= form_with url: member_scan_resolve_path, method: :get do %>
      <div style="display:flex; gap:8px;">
        <input name="code" class="l-field" placeholder="<%= t("customer.scan.enter_placeholder") %>" autocomplete="off">
        <%= submit_tag t("customer.scan.submit"), class: "l-btn l-btn-primary", style: "white-space:nowrap; flex:none;" %>
      </div>
    <% end %>
  </div>
</div>
