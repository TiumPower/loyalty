<%# How much closer this brought them, as the design's second card. Carries the
    next tier's own glyph rather than a generic medal — a diamond for Diamond. %>
<% nxt = current_member.next_tier %>
<% if nxt %>
  <div class="l-tile" style="margin-top:12px; display:flex; align-items:center; gap:12px;">
    <span style="width:38px; height:38px; border-radius:12px; flex:none; display:grid; place-items:center;
                 background:<%= nxt.pill_background %>; color:<%= nxt.pill_foreground %>;">
      <%= ui_icon(tier_icon(nxt), size: 18, fill: true) %>
    </span>
    <div style="flex:1; min-width:0;">
      <div style="font-weight:700; font-size:14px;">
        <%= t("customer.tiers.to_next_short", n: number_with_delimiter(current_member.points_to_next), tier: nxt.name) %>
      </div>
      <div style="font-size:12.5px; color:var(--ink-2); margin-top:2px;">
        <%= t("customer.earn_success.tier_unlocks", tier: nxt.name, n: number_with_delimiter(nxt.threshold_points)) %>
      </div>
    </div>
  </div>
<% end %>
