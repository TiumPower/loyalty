<% content_for :title, @reward.title %>
<% content_for :tab, "wallet" %>
<% enough = @member.points_balance >= @reward.cost_points.to_i %>
<header class="l-appbar">
  <%= link_to "←", member_wallet_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:20px;"><%= t("customer.reward_detail.title") %></div>
</header>

<div class="l-screen">
  <div class="l-ticket" style="margin-bottom:16px;">
    <div class="stub"><div class="v"><%= @reward.value_label %></div><div class="u"><%= @reward.kind %></div></div>
    <div class="perf"></div>
    <div class="body">
      <div style="font-weight:700; font-size:17px;"><%= @reward.display_icon %> <%= @reward.title %></div>
      <div style="font-size:13px; color:var(--ink-2); margin-top:6px;"><%= @reward.description %></div>
    </div>
  </div>

  <% if @reward.terms.present? %>
    <div class="l-tile" style="margin-bottom:16px;">
      <div class="l-eyebrow"><%= t("customer.reward_detail.terms") %></div>
      <div style="font-size:13px; color:var(--ink-2); margin-top:6px;"><%= simple_format @reward.terms %></div>
    </div>
  <% end %>

  <%# How long the voucher lasts was only revealed AFTER the points were spent.
      A customer choosing between rewards needs it beforehand. %>
  <% if @reward.valid_days.to_i.positive? %>
    <div class="l-tile" style="margin-bottom:16px; display:flex; align-items:center; gap:10px; font-size:13px; color:var(--ink-2);">
      <span style="font-size:17px;">⏳</span>
      <span>Sau khi đổi, ưu đãi có hiệu lực <strong style="color:var(--ink);"><%= @reward.valid_days %> ngày</strong>
        (đến <strong style="color:var(--ink);"><%= l(@reward.valid_days.to_i.days.from_now.to_date, format: :short) %></strong>).</span>
    </div>
  <% end %>

  <div class="l-tile" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
    <div><div class="l-eyebrow"><%= t("customer.reward_detail.cost") %></div><div class="l-num" style="font-size:24px;"><%= t("customer.common.points_count", n: number_with_delimiter(@reward.cost_points)) %></div></div>
    <div style="text-align:right;"><div class="l-eyebrow"><%= t("customer.reward_detail.your_points") %></div><div class="l-num" style="font-size:20px; color:<%= enough ? 'var(--good)' : 'var(--warn)' %>;"><%= number_with_delimiter(@member.points_balance) %></div></div>
  </div>

  <% if !@reward.redeem_open? %>
    <button class="l-btn l-btn-block" disabled style="background:var(--surface-2); color:var(--ink-2);">
      🕑 <%= @reward.redeem_window_hint %>
    </button>
    <% if @reward.schedule_summary.present? && @reward.redeem_state != :ended %>
      <p style="text-align:center; font-size:12px; color:var(--ink-2); margin-top:8px;"><%= t("customer.reward_detail.window_only", win: @reward.schedule_summary) %></p>
    <% end %>
  <% elsif enough %>
    <%= button_to t("customer.reward_detail.redeem_now", n: number_with_delimiter(@reward.cost_points)), member_redeem_reward_path(@reward),
          method: :post, class: "l-btn l-btn-primary l-btn-block",
          form: { data: { turbo_confirm: t("customer.reward_detail.confirm", title: @reward.title, n: number_with_delimiter(@reward.cost_points)) } } %>
  <% else %>
    <button class="l-btn l-btn-block" disabled style="background:var(--surface-2); color:var(--ink-2);">
      <%= t("customer.reward_detail.short_by", n: number_with_delimiter(@reward.cost_points - @member.points_balance)) %>
    </button>
  <% end %>
</div>
