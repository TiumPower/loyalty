<% content_for :title, t("customer.review.new_title") %>
<% content_for :tab, "" %>
<header class="l-subhead">
  <%= link_to member_shop_about_path,
        class: "l-iconbtn", data: { controller: "goback", action: "goback#back" }, "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;">
    <div class="t"><%= t("customer.review.new_title") %></div>
    <div class="s"><%= t("customer.review.new_sub") %></div>
  </div>
</header>

<div class="l-screen">
  <%= render "form", rating: @rating, url: member_reviews_path, method: :post, submit_label: t("customer.review.submit") %>
</div>
