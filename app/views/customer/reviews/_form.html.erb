<%
  chosen  = rating.new_record? ? nil : rating.stars
  picked  = rating.tag_list
  outlet  = current_workspace.outlets.first
  labels  = { 1 => t("customer.review.r1"), 2 => t("customer.review.r2"), 3 => t("customer.review.r3"),
              4 => t("customer.review.r4"), 5 => t("customer.review.r5") }
%>
<%# ---- who the review is about ---- %>
<div class="l-tile" style="margin-bottom:12px;">
  <div style="display:flex; align-items:center; gap:12px;">
    <div style="width:64px; height:64px; border-radius:14px; flex:none; overflow:hidden; background:var(--surface-2); display:grid; place-items:center;">
      <%= shop_cover(current_workspace, size: 200) %>
    </div>
    <div style="flex:1; min-width:0;">
      <div style="font-weight:700; font-size:16px; letter-spacing:-.015em;"><%= current_workspace.name %></div>
      <% if outlet %><div style="font-size:12.5px; color:var(--ink-2); margin-top:2px;"><%= outlet.name %></div><% end %>
      <span class="l-pill brand" style="margin-top:7px;"><%= t("customer.review.public_chip") %></span>
    </div>
  </div>
</div>

<%= form_with url: url, method: method, multipart: true, data: { controller: "rating" } do %>
  <% if rating.errors.any? %>
    <div class="l-note warn" style="margin-bottom:12px;">
      <%= ui_icon(:shield, size: 15) %><span><%= t("customer.review.pick_stars_error") %></span>
    </div>
  <% end %>

  <%# ---- stars ---- %>
  <div class="l-tile" style="text-align:center;">
    <div style="font-size:14px; font-weight:600;"><%= t("customer.review.prompt", shop: current_workspace.name) %></div>
    <%# The stars column defaults to 5 in the database, so a new Rating arrives
        pre-rated. Start blank and make the customer choose. %>
    <input type="hidden" name="stars" value="<%= chosen %>" data-rating-target="input">
    <div style="display:flex; gap:12px; justify-content:center; font-size:34px; margin:14px 0 8px; cursor:pointer;">
      <% (1..5).each do |i| %>
        <span data-rating-target="star" data-value="<%= i %>"
              data-action="click->rating#set keydown.enter->rating#set"
              role="radio" tabindex="0" aria-label="<%= t("customer.review.stars_n", n: i) %>"
              style="user-select:none; color:var(--primary-2); line-height:1;">★</span>
      <% end %>
    </div>
    <div data-rating-target="hint" style="font-size:12.5px; color:var(--ink-2);"><%= t("customer.review.tap_to_rate") %></div>
    <% if chosen %><div style="font-size:13px; font-weight:700; color:var(--primary);"><%= labels[chosen] %></div><% end %>
  </div>

  <%# ---- the words ---- %>
  <div class="l-tile" style="margin-top:12px;" data-controller="charcount">
    <div style="display:flex; align-items:baseline; justify-content:space-between; gap:10px;">
      <label class="l-label" style="margin:0;"><%= t("customer.review.comment_label") %></label>
      <span style="font-size:11.5px; color:var(--ink-2);" data-charcount-target="out"></span>
    </div>
    <%= text_area_tag :comment, rating.comment, class: "l-field", rows: 4,
          maxlength: 500, style: "margin-top:8px;", placeholder: t("customer.review.comment_ph"),
          data: { charcount_target: "input", action: "input->charcount#count" } %>
    <div style="font-size:11.5px; color:var(--ink-2); margin-top:6px;"><%= t("customer.review.optional") %></div>
  </div>

  <%# ---- tags: what the shop does well. Free text cannot be counted, so the
        shop page's "review highlights" are built from these. ---- %>
  <div class="l-tile" style="margin-top:12px;">
    <label class="l-label"><%= t("customer.review.tags_label") %></label>
    <div class="l-chipset" data-controller="tagpick">
      <% Rating::TAGS.each do |key| %>
        <label class="l-tag <%= 'on' if picked.include?(key) %>" data-tagpick-target="tag">
          <input type="checkbox" name="tags[]" value="<%= key %>" <%= "checked" if picked.include?(key) %>
                 data-action="tagpick#toggle" hidden>
          <%= t("customer.review.tag_#{key}") %>
        </label>
      <% end %>
    </div>
  </div>

  <%# ---- photos of the visit ---- %>
  <div class="l-tile" style="margin-top:12px;"
       data-controller="photopick" data-photopick-max-value="<%= Rating::MAX_PHOTOS %>"
       data-photopick-too-many-value="<%= t("customer.review.photos_too_many", n: Rating::MAX_PHOTOS) %>">
    <button type="button" class="l-photopick" data-action="photopick#pick">
      <span class="ic"><%= ui_icon(:camera, size: 22) %></span>
      <span class="bd">
        <span class="tt" style="display:block;"><%= t("customer.review.photos_title") %></span>
        <span class="ds" style="display:block;"><%= t("customer.review.photos_sub", n: Rating::MAX_PHOTOS) %></span>
      </span>
      <span class="plus" data-photopick-target="count"></span>
      <span class="plus">＋</span>
    </button>
    <%# `capture` lets a phone offer the camera as well as the library. %>
    <%= file_field_tag "photos[]", multiple: true, accept: Rating::PHOTO_TYPES.join(","),
          hidden: true, data: { photopick_target: "input", action: "photopick#changed" } %>
    <div class="l-photogrid" data-photopick-target="grid" hidden></div>

    <% if rating.photos.attached? %>
      <div style="margin-top:12px;">
        <div class="l-eyebrow" style="margin-bottom:7px;"><%= t("customer.review.photos_current") %></div>
        <div class="l-photogrid">
          <% rating.photo_list.each do |att| %>
            <span class="l-photo"><%= image_tag att.variant(resize_to_fill: [160, 160]), alt: "" %></span>
          <% end %>
        </div>
        <label style="display:inline-flex; align-items:center; gap:7px; margin-top:10px; font-size:13px; color:var(--ink-2);">
          <input type="checkbox" name="remove_photos" value="1" style="margin:0;">
          <%= t("customer.review.photos_remove") %>
        </label>
      </div>
    <% end %>
  </div>

  <div class="l-note" style="margin-top:12px;">
    <%= ui_icon(:eye, size: 16) %><span><%= t("customer.review.visibility_note", shop: current_workspace.name) %></span>
  </div>

  <%= submit_tag submit_label, class: "l-btn l-btn-primary l-btn-block", style: "margin-top:16px;",
        data: { rating_target: "submit" }, disabled: chosen.blank? %>
  <%= link_to t("customer.reward_detail.not_now"),
        (current_workspace.feedback_public? ? member_shop_about_path : member_profile_path),
        class: "l-btn l-btn-outline l-btn-block", style: "margin-top:10px;" %>
<% end %>
