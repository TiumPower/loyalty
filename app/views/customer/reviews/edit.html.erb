<% content_for :title, t("customer.review.edit_title") %>
<% content_for :tab, "" %>
<header class="l-subhead">
  <%= link_to member_shop_about_path, class: "l-iconbtn",
        data: { controller: "goback", action: "goback#back" }, "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;"><div class="t"><%= t("customer.review.edit_title") %></div></div>
</header>

<div class="l-screen">
  <%= render "form", rating: @rating, url: member_review_path(@rating), method: :patch, submit_label: t("customer.review.update") %>
</div>
