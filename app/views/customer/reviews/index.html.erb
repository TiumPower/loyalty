<% content_for :title, "Về quán" %>
<% content_for :tab, "" %>
<% stars = ->(n) { "★" * n.round + "☆" * (5 - n.round) } %>
<header class="l-appbar">
  <%= link_to "←", member_root_path, data: { controller: "goback", action: "goback#back" }, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;">Về quán</div>
</header>

<%# Renders one review row; shows an edit affordance when it's the member's own. %>
<% review_row = ->(r) do %>
  <div class="l-tile" style="margin-bottom:10px;">
    <div style="display:flex; align-items:center; gap:10px;">
      <%= member_avatar(r.member, klass: "avatar", style: "width:36px;height:36px;border-radius:11px;background:var(--surface-2);color:var(--ink);display:grid;place-items:center;font-weight:700;font-size:13px;flex:none;") %>
      <div style="flex:1; min-width:0;">
        <div style="font-weight:600; font-size:14px;"><%= r.member&.display_name %><% if r.member_id == current_member.id %> <span style="color:var(--ink-2); font-weight:400;">· bạn</span><% end %></div>
        <div style="color:var(--primary-2,#E08A3C); font-size:13px; letter-spacing:1px;"><%= stars.call(r.stars) %></div>
      </div>
      <% if r.member_id == current_member.id %>
        <%= link_to member_edit_review_path(r), style: "flex:none; color:var(--primary-ink); text-decoration:none; font-size:16px;", title: "Sửa" do %>✎<% end %>
      <% end %>
      <div style="font-size:11px; color:var(--ink-2);"><%= l(r.created_at.to_date, format: :short) %></div>
    </div>
    <% if r.comment.present? %><div style="font-size:14px; margin-top:8px;"><%= r.comment %></div><% end %>

    <%# Phản hồi của quán — cho khách thấy quán có lắng nghe %>
    <% if r.replied? %>
      <div style="margin-top:10px; padding:10px 12px; border-radius:12px; background:var(--surface-2);
                  border-left:3px solid var(--primary);">
        <div style="font-size:12px; font-weight:700; color:var(--primary-ink);">
          <%= t("customer.review_reply.from_shop", shop: current_workspace.name) %>
          <span style="font-weight:400; color:var(--ink-2);"> · <%= l(r.replied_at.to_date, format: :short) %></span>
        </div>
        <div style="font-size:13.5px; margin-top:4px;"><%= r.reply_body %></div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="l-screen" data-controller="tabs" data-tabs-active-class-value="active" data-tabs-active-value="all">
  <%# ---- Shop info ---- %>
  <div class="l-tile" style="display:flex; gap:14px; align-items:center; margin-bottom:14px;">
    <%= workspace_avatar(current_workspace, klass: "avatar", style: "width:56px;height:56px;border-radius:16px;font-size:20px;flex:none;") %>
    <div style="min-width:0;">
      <div style="font-weight:700; font-size:18px;"><%= current_workspace.name %></div>
      <% if current_workspace.branding_value("tagline").present? %>
        <div style="color:var(--ink-2); font-size:13px;"><%= current_workspace.branding_value("tagline") %></div>
      <% end %>
    </div>
  </div>

  <%# ---- Rating summary ---- %>
  <div class="l-tile" style="text-align:center; margin-bottom:14px;">
    <div class="l-num" style="font-size:44px; line-height:1;"><%= @avg %></div>
    <div style="color:var(--primary-2,#E08A3C); font-size:20px; letter-spacing:2px;"><%= stars.call(@avg) %></div>
    <div style="color:var(--ink-2); font-size:13px; margin-top:4px;"><%= @count %> đánh giá</div>
  </div>

  <%# ---- Branches ---- %>
  <% if @outlets.any? %>
    <div class="l-section-h"><h3>Chi nhánh</h3></div>
    <div class="l-tile" style="margin-bottom:14px; padding:6px 16px;">
      <% @outlets.each do |o| %>
        <div style="padding:10px 0; border-bottom:1px solid var(--line);">
          <div style="font-weight:600;">🏬 <%= o.name %></div>
          <%# The address and phone were plain text, so a customer looking up the
              shop had to copy them out by hand. Make them do their obvious job. %>
          <% if o.address.present? %>
            <%= link_to "https://maps.google.com/?q=#{CGI.escape("#{o.name} #{o.address}")}",
                  target: "_blank", rel: "noopener",
                  style: "display:block; font-size:13px; color:var(--primary); margin-top:2px; text-decoration:none;" do %>
              📍 <%= o.address %> <span style="color:var(--ink-2);">· Chỉ đường ›</span>
            <% end %>
          <% end %>
          <% if o.phone.present? %>
            <%= link_to "📞 #{o.phone}", "tel:#{o.phone.gsub(/\s+/, '')}",
                  style: "display:block; font-size:13px; color:var(--primary); text-decoration:none;" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ---- Feedback wall with All / Yours filter ---- %>
  <div class="l-section-h"><h3>Đánh giá của khách</h3></div>
  <%= link_to "＋ Viết đánh giá", member_new_review_path, class: "l-btn l-btn-primary l-btn-block", style: "margin-bottom:12px;" %>
  <div class="l-wtabs" style="margin-bottom:12px;">
    <button data-tabs-target="tab" data-name="all"  data-action="tabs#select">Tất cả · <%= @count %></button>
    <button data-tabs-target="tab" data-name="mine" data-action="tabs#select">Của bạn · <%= @my_count %></button>
  </div>

  <div data-tabs-target="panel" data-name="all">
    <% if @ratings.empty? %>
      <div class="l-tile" style="text-align:center; padding:30px 20px; color:var(--ink-2);">Chưa có đánh giá nào — hãy là người đầu tiên!</div>
    <% else %>
      <% @ratings.each { |r| review_row.call(r) } %>
    <% end %>
  </div>

  <div data-tabs-target="panel" data-name="mine" hidden>
    <% if @mine.empty? %>
      <div class="l-tile" style="text-align:center; padding:24px 20px; color:var(--ink-2);">
        Bạn chưa có đánh giá nào.<br>
        <%= link_to "Viết đánh giá", member_new_review_path, class: "l-btn l-btn-primary", style: "margin-top:12px; display:inline-flex;" %>
      </div>
    <% else %>
      <% @mine.each { |r| review_row.call(r) } %>
    <% end %>
  </div>
</div>
