<% content_for :title, t("customer.shop.title") %>
<% content_for :tab, "" %>
<% main = @outlets.first %>

<header class="l-subhead" style="padding-bottom:8px;">
  <%= link_to member_root_path, class: "l-iconbtn",
        data: { controller: "goback", action: "goback#back" }, "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;"><div class="t" style="font-size:18px;"><%= current_workspace.name %></div></div>
  <div class="sp">
    <% if @public && @avg.to_f.positive? %><span class="l-pill"><%= @avg %> ★</span><% end %>
  </div>
</header>

<div class="l-screen flush">
  <div class="l-shophero">
    <%= shop_cover(current_workspace) %>
    <div class="cap"><%= current_workspace.name %></div>
  </div>

  <%# The distance is worked out in the browser from coordinates already in the
      page — the customer's position is never sent anywhere. %>
  <div style="padding:0 20px;" data-controller="distance"
       data-distance-km-label-value="<%= t("customer.shop.km_away") %>"
       data-distance-m-label-value="<%= t("customer.shop.m_away") %>"
       data-distance-failed-value="<%= t("customer.shop.distance_failed") %>">
    <%# ---- the facts: where it is and how to reach it ---- %>
    <div style="padding:16px 0;">
      <% if main&.address.present? %>
        <div class="l-inforow"><span class="ic"><%= ui_icon(:pin, size: 14) %></span><span><%= main.address %></span></div>
      <% end %>
      <% if main&.located? %>
        <div class="l-inforow" data-distance-target="place" data-lat="<%= main.latitude %>" data-lng="<%= main.longitude %>">
          <span class="ic"><%= ui_icon(:navigate, size: 14) %></span>
          <span>
            <span data-role="dist"></span>
            <button type="button" class="l-linkbtn" data-distance-target="ask" data-action="distance#locate">
              <%= t("customer.shop.show_distance") %>
            </button>
          </span>
        </div>
        <div class="l-inforow" data-distance-target="status" hidden>
          <span class="ic"><%= ui_icon(:clock, size: 14) %></span><span><%= t("customer.shop.locating") %></span>
        </div>
      <% end %>
      <% if @outlets.size > 1 %>
        <div class="l-inforow"><span class="ic"><%= ui_icon(:store, size: 14) %></span><span><%= t("customer.shop.n_outlets", n: @outlets.size) %></span></div>
      <% end %>
      <%# Open or closed, and until when — drawn only when the branch has said. %>
      <% if (state = shop_open_state(main)) %>
        <div class="l-inforow">
          <span class="ic"><%= ui_icon(:clock, size: 14) %></span>
          <span>
            <strong style="color:<%= state[:open] ? 'var(--good)' : 'var(--warn)' %>;">
              <%= state[:open] ? t("customer.shop.open") : t("customer.shop.closed") %>
            </strong>
            · <%= state[:label] %>
          </span>
        </div>
      <% end %>
      <% if main&.phone.present? %>
        <div class="l-inforow"><span class="ic"><%= ui_icon(:phone, size: 14) %></span><span><%= main.phone %></span></div>
      <% end %>
    </div>

    <% if current_workspace.branding_value("tagline").present? %>
      <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em;"><%= t("customer.shop.about") %></h3>
      <p style="font-size:14px; color:var(--ink-2); line-height:1.6; margin-top:8px;"><%= current_workspace.branding_value("tagline") %></p>
    <% end %>

    <%# What the shop is known for, in its own words. %>
    <% if current_workspace.menu_highlights.any? %>
      <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em; margin-top:24px;"><%= t("customer.shop.menu_highlights") %></h3>
      <div class="l-chipset" style="margin-top:10px;">
        <% current_workspace.menu_highlights.each do |item| %>
          <span class="l-tag"><%= item %></span>
        <% end %>
      </div>
    <% end %>

    <%# Things worth knowing before you walk over: Wi-Fi, a socket, a seat. %>
    <% if current_workspace.amenity_list.any? %>
      <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em; margin-top:24px;"><%= t("customer.shop.amenities") %></h3>
      <div class="l-amenities">
        <% current_workspace.amenity_list.each do |key| %>
          <div>
            <span class="ic"><%= ui_icon(amenity_icon(key), size: 15) %></span>
            <span><%= t("merchant.amenities.#{key}") %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# The design shows one address. A shop with several branches needs each of
        them tappable, so they get their own chip set. %>
    <% if @outlets.size > 1 %>
      <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em; margin-top:24px;"><%= t("customer.shop.outlets") %></h3>
      <div class="l-chipset" style="margin-top:10px;">
        <% @outlets.each do |o| %>
          <%= link_to "https://maps.google.com/?q=#{CGI.escape("#{o.name} #{o.address}")}",
                target: "_blank", rel: "noopener", style: "text-decoration:none;",
                data: (o.located? ? { distance_target: "place", lat: o.latitude, lng: o.longitude } : {}) do %>
            <%= o.name %><% if o.located? %><span data-role="dist" style="color:var(--ink-2); margin-left:6px;"></span><% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em; margin-top:24px;"><%= t("customer.shop.contact") %></h3>
    <div style="display:flex; flex-direction:column; gap:10px; margin-top:12px;">
      <% if main&.phone.present? %>
        <%= link_to "tel:#{main.phone.gsub(/\s+/, '')}", class: "l-action" do %>
          <%= ui_icon(:phone, size: 18) %><span><%= t("customer.shop.call_shop") %></span>
        <% end %>
      <% end %>
      <% if main&.address.present? %>
        <%= link_to "https://maps.google.com/?q=#{CGI.escape("#{main.name} #{main.address}")}",
              target: "_blank", rel: "noopener", class: "l-action" do %>
          <%= ui_icon(:navigate, size: 18) %><span><%= t("customer.shop.directions_cta") %></span>
        <% end %>
      <% end %>
      <%= link_to member_new_review_path, class: "l-action" do %>
        <%= ui_icon(:mail, size: 18) %><span><%= t("customer.shop.send_message") %></span>
      <% end %>
    </div>

    <%# The public half of this page. The merchant's "trang đánh giá công khai"
        switch used to hide the whole screen — address, hours, menu and all —
        which is two decisions made by one control. It now governs exactly what
        it is named after: whether other customers' reviews are shown. %>
    <% if @public %>
      <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em; margin-top:26px;"><%= t("customer.shop.reviews") %></h3>
      <div class="l-tile" style="margin-top:12px;">
        <div style="display:flex; align-items:flex-start; gap:20px;">
          <div style="flex:none; text-align:center;">
            <div style="font-size:36px; font-weight:700; letter-spacing:-.04em; line-height:1;"><%= @avg %></div>
            <span class="l-pill amber" style="margin-top:8px;"><%= @avg %> ★</span>
          </div>
          <div style="flex:1; min-width:0;">
            <% 5.downto(1) do |n| %>
              <% pct = @count.positive? ? (@dist[n] * 100.0 / @count).round : 0 %>
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:5px;">
                <span style="font-size:11.5px; color:var(--ink-2); width:8px; flex:none;"><%= n %></span>
                <span class="l-bar" style="flex:1; height:6px;"><span style="width:<%= pct %>%;"></span></span>
                <span style="font-size:11px; color:var(--ink-2); width:30px; text-align:right; flex:none;"><%= pct %>%</span>
              </div>
            <% end %>
          </div>
        </div>
        <% if @highlights.present? %>
          <div style="height:1px; background:var(--line-soft); margin:14px 0;"></div>
          <div class="l-chipset"><% @highlights.each { |h| %><span><%= h %></span><% } %></div>
        <% end %>
      </div>
        <%# One list, newest first, as the design shows. A review of the member's own
            is flagged inline and editable rather than hidden behind a second tab.
            The list lives in its own frame so "see all" swaps the reviews in place
            instead of reloading the page and throwing the reader back to the top. %>
        <%= turbo_frame_tag "shop_reviews", class: "l-busy", style: "display:block; margin-top:14px;" do %>
          <% if @ratings.empty? %>
            <div class="l-empty">
              <div class="ic"><%= ui_icon(:star, size: 26) %></div>
              <div class="tt"><%= t("customer.shop.no_reviews") %></div>
            </div>
          <% else %>
            <% @ratings.first(@shown).each do |r| %>
              <% mine = r.member_id == current_member.id %>
              <div class="l-tile" style="margin-bottom:10px;">
                <div style="display:flex; align-items:center; gap:10px;">
                  <%= member_avatar(r.member, klass: "", style: "width:32px;height:32px;border-radius:50%;background:var(--surface-2);color:var(--ink-2);display:grid;place-items:center;font-weight:700;font-size:12px;flex:none;") %>
                  <div style="flex:1; min-width:0;">
                    <div style="font-weight:700; font-size:14px;">
                      <%= r.member&.display_name %><% if mine %><span style="color:var(--ink-2); font-weight:400;"> · <%= t("customer.shop.you") %></span><% end %>
                    </div>
                    <div style="font-size:11.5px; color:var(--ink-2); margin-top:2px;"><%= t("customer.notifications.ago", time: time_ago_in_words(r.created_at)) %></div>
                  </div>
                  <% if mine %>
                    <%= link_to member_edit_review_path(r), class: "l-iconbtn sm", title: t("customer.shop.edit_review") do %>
                      <%= ui_icon(:edit, size: 14) %>
                    <% end %>
                  <% end %>
                  <span class="l-pill amber" style="flex:none;"><%= r.stars %> ★</span>
                </div>
                <% if r.comment.present? %>
                  <div style="font-size:13.5px; margin-top:9px; line-height:1.55;"><%= r.comment %></div>
                <% end %>
                <%# Photos of the visit. They open full size, because a thumbnail of
                    a coffee is not why the customer took the picture. %>
                <% if r.photos.attached? %>
                  <div class="l-reviewshots">
                    <% r.photo_list.each do |att| %>
                      <%= link_to url_for(att), target: "_blank", rel: "noopener" do %>
                        <%= image_tag att.variant(resize_to_fill: [200, 200]), alt: "" %>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
                <% if r.replied? %>
                  <div style="margin-top:10px; padding:11px 13px; border-radius:12px; background:var(--surface-2); border-left:3px solid var(--primary);">
                    <div style="font-size:12px; font-weight:700; color:var(--primary);">
                      <%= t("customer.review_reply.from_shop", shop: current_workspace.name) %>
                      <span style="font-weight:400; color:var(--ink-2);"> · <%= l(r.replied_at.to_date, format: :short) %></span>
                    </div>
                    <div style="font-size:13px; margin-top:4px; line-height:1.5;"><%= r.reply_body %></div>
                  </div>
                <% end %>
              </div>
            <% end %>
            <% if @ratings.size > @shown %>
              <%= link_to member_shop_about_path(all: 1), class: "l-btn l-btn-ghost l-btn-block",
                    style: "margin-bottom:12px;", data: { turbo_frame: "shop_reviews" } do %>
                <%= t("customer.shop.more_reviews", n: @ratings.size - @shown) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
    <% end %>

    <%# Your own reviews, shown whichever way the switch is set: a member who
        left feedback needs a way back to it even when the public list is off.
        The redesign folded the old "Của bạn" tab into one list and flagged your
        rows inline — but the list shows three by default and caps at a hundred,
        so a member whose review had scrolled out of that window had no way back
        to it to edit it. The band below is the way back; the public list stays
        exactly as the design draws it. %>
    <% if @mine.present? %>
      <div class="l-tile" style="margin-top:14px; background:var(--primary-soft); border-color:transparent;">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="flex:1; min-width:0; font-weight:700; font-size:14px; color:var(--primary-ink);">
            <%= t("customer.shop.your_reviews", n: @my_count) %>
          </span>
        </div>
        <% @mine.each do |r| %>
          <%= link_to member_edit_review_path(r), class: "l-row", style: "background:transparent; border:none; padding:10px 0;" do %>
            <span class="l-pill amber" style="flex:none;"><%= r.stars %> ★</span>
            <span class="bd">
              <span class="tt" style="display:block; font-weight:600;">
                <%= r.comment.presence || t("customer.shop.no_comment_short") %>
              </span>
              <span class="mt" style="display:block;"><%= l(r.created_at.to_date, format: :short) %></span>
            </span>
            <span class="tr" style="color:var(--primary);"><%= ui_icon(:edit, size: 15) %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= link_to member_new_review_path, class: "l-btn l-btn-primary l-btn-block", style: "margin-top:4px;" do %>
      <%= ui_icon(:edit, size: 16) %><%= t("customer.review.new_title") %>
    <% end %>
  </div>
</div>
