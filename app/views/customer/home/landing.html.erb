<% content_for :title, "Dynamic Loyalty — #{t('landing.hero_eyebrow')}" %>

<%# ---- Hero ---- %>
<section class="m-hero"><div class="m-in grid">
  <div class="m-hero-copy">
    <div class="eyebrow"><%= t("landing.hero_eyebrow") %></div>
    <h1 style="margin-top:14px;"><%= t("landing.hero_title") %></h1>
    <p class="lead"><%= t("landing.hero_sub") %></p>
    <div class="m-heroprice">
      <div class="hp-day"><%= t("landing.hook_day") %></div>
      <div class="hp-amt"><%= t("landing.hook_amount") %><span><%= t("landing.hook_per") %></span></div>
    </div>
    <div class="m-cta">
      <a class="m-btn solid lg" href="/merchant/signup"><%= t("landing.hero_cta", days: Workspace::TRIAL_DAYS) %></a>
      <a class="m-btn ghost lg" href="#features"><%= t("landing.hero_cta2") %> →</a>
    </div>
    <div class="m-trust"><%= t("landing.trust") %></div>
  </div>

  <div class="m-visual">
    <div class="m-phone">
      <div class="m-mem">
        <span class="bdg">👑 <%= t("landing.hero_tier") %></span>
        <div class="k"><%= t("landing.hero_points_label") %></div>
        <div class="pts">13.990</div>
        <div class="per"><%= t("landing.hero_per_bill") %></div>
        <div class="nm">NGUYEN AN · 0912 •• 456</div>
      </div>
      <div class="m-chips">
        <span><%= ui_icon(:qrcode, size: 18) %></span>
        <span><%= ui_icon(:gift, size: 18) %></span>
        <span><%= ui_icon(:wheel, size: 18) %></span>
        <span><%= ui_icon(:medal, size: 18) %></span>
      </div>
    </div>
  </div>
</div></section>

<%# ---- Stats / value band ---- %>
<section class="m-sec alt" style="padding:48px 0;"><div class="m-in">
  <div class="m-stats">
    <% [:stat1,:stat2,:stat3,:stat4].each do |s| %>
      <div class="m-stat">
        <div class="v"><%= t("landing.#{s}_t") %></div>
        <div class="l"><%= t("landing.#{s}_d") %></div>
      </div>
    <% end %>
  </div>
</div></section>

<%# ---- Features ---- %>
<section class="m-sec" id="features"><div class="m-in">
  <div class="m-head">
    <div class="eyebrow"><%= t("landing.nav_features") %></div>
    <h2><%= t("landing.feat_title") %></h2>
    <p><%= t("landing.feat_sub") %></p>
  </div>
  <div class="m-features">
    <% [[:medal,:f1],[:qrcode,:f2],[:wheel,:f3],[:bell,:f4],[:users,:f5],[:target,:f6]].each do |icon, k| %>
      <div class="m-feat">
        <div class="ic"><%= ui_icon(icon, size: 24) %></div>
        <h3><%= t("landing.#{k}_t") %></h3>
        <p><%= t("landing.#{k}_d") %></p>
      </div>
    <% end %>
  </div>
</div></section>

<%# ---- Industries ---- %>
<section class="m-sec alt"><div class="m-in">
  <div class="m-head">
    <div class="eyebrow">Industries</div>
    <h2><%= t("landing.ind_title") %></h2>
    <p><%= t("landing.ind_sub") %></p>
  </div>
  <div class="m-inds">
    <% [:ind_fnb,:ind_retail,:ind_service].each do |k| %>
      <div class="m-ind">
        <h3><%= t("landing.#{k}_t") %></h3>
        <p><%= t("landing.#{k}_d") %></p>
      </div>
    <% end %>
  </div>
</div></section>

<%# ---- How it works ---- %>
<section class="m-sec" id="how"><div class="m-in">
  <div class="m-head">
    <div class="eyebrow"><%= t("landing.nav_how") %></div>
    <h2><%= t("landing.how_title") %></h2>
  </div>
  <div class="m-steps">
    <% [:s1,:s2,:s3].each_with_index do |k, i| %>
      <div class="m-step">
        <div class="n"><%= i + 1 %></div>
        <h3><%= t("landing.#{k}_t") %></h3>
        <p><%= t("landing.#{k}_d") %></p>
      </div>
    <% end %>
  </div>
</div></section>

<%# ---- Pricing ---- %>
<section class="m-sec alt" id="pricing"><div class="m-in">
  <div class="m-head">
    <div class="eyebrow"><%= t("landing.nav_pricing") %></div>
    <h2><%= t("landing.pricing_title", days: Workspace::TRIAL_DAYS) %></h2>
    <p><%= t("landing.pricing_sub") %></p>
  </div>
  <div class="m-price">
    <% @plans.each do |plan| %>
      <% popular = plan.key == "growth" %>
      <div class="m-plan <%= 'pop' if popular %>">
        <% if popular %><span class="tag"><%= t("landing.price_popular") %></span><% end %>
        <div class="pn"><%= plan.name %></div>
        <div class="pp"><%= number_with_delimiter(plan.price) %><small><%= t("landing.price_mo") %></small></div>
        <ul>
          <% Array(plan.features).each do |feat| %>
            <li><%= ui_icon(:check, size: 16) %><span><%= feat %></span></li>
          <% end %>
        </ul>
        <a class="m-btn <%= popular ? 'solid' : 'ghost' %>" href="/merchant/signup" style="<%= 'border:1px solid var(--line);' unless popular %>"><%= t("landing.price_choose") %></a>
      </div>
    <% end %>
  </div>
  <p style="text-align:center;color:var(--ink-2);font-size:13px;margin-top:20px;"><%= t("landing.price_trial", days: Workspace::TRIAL_DAYS) %></p>
</div></section>

<%# ---- FAQ ---- %>
<section class="m-sec" id="faq"><div class="m-in">
  <div class="m-head"><h2><%= t("landing.faq_title") %></h2></div>
  <div class="m-faq">
    <% [:q1,:q2,:q3,:q4].each_with_index do |q, i| %>
      <details <%= "open" if i.zero? %>>
        <summary><%= t("landing.#{q}") %></summary>
        <p><%= t("landing.a#{i + 1}", days: Workspace::TRIAL_DAYS, grace: Workspace::GRACE_DAYS) %></p>
      </details>
    <% end %>
  </div>
</div></section>

<%# ---- Final CTA ---- %>
<section style="padding:8px 0 80px;"><div class="m-in" style="padding:0;">
  <div class="m-band">
    <h2><%= t("landing.cta_title") %></h2>
    <p><%= t("landing.cta_sub", days: Workspace::TRIAL_DAYS) %></p>
    <div class="m-cta">
      <a class="m-btn solid lg" href="/merchant/signup"><%= t("landing.cta_btn", days: Workspace::TRIAL_DAYS) %></a>
    </div>
  </div>
</div></section>
