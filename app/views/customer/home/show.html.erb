<% content_for :title, current_workspace.name %>
<% content_for :tab, "home" %>
<% tier = @tier %>
<% prog = current_workspace.program %>

<%# ---- header: greeting + notification bell ---- %>
<header class="l-head">
  <div style="min-width:0;">
    <div class="t"><%= t("customer.home.greeting_#{greeting_period}", name: greeting_name(@member)) %></div>
    <div class="s"><%= t("customer.home.greeting_sub", shop: current_workspace.name) %></div>
  </div>
  <div class="sp">
    <%= link_to member_notifications_path, class: "l-iconbtn", "aria-label": t("customer.notifications.title") do %>
      <%= ui_icon(:bell, size: 19) %>
      <% if @unread.to_i.positive? %><span class="dot"></span><% end %>
    <% end %>
  </div>
</header>

<div class="l-screen">
  <%# ---- hero: the shop, then the balance ---- %>
  <div class="l-shopcard">
    <div class="cover"><%= shop_cover(current_workspace, size: 700) %></div>
    <div style="display:flex; align-items:center; gap:11px; margin-top:12px;">
      <%= workspace_avatar(current_workspace, klass: "brandmark") %>
      <div style="flex:1; min-width:0;">
        <div style="font-weight:700; font-size:17px; letter-spacing:-.02em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= current_workspace.name %></div>
        <div style="display:flex; align-items:center; gap:7px; margin-top:5px;">
          <% if @shop_rating.to_f.positive? %><span class="l-pill"><%= @shop_rating %> ★</span><% end %>
          <%# The design shows "Open now" here. It is not drawn while the app has
              no opening hours to read: this badge was a constant, so it told a
              customer standing outside a closed shop at 3am that it was open.
              It comes back with the opening-hours field on the outlet. %>
          <% if (state = shop_open_state(current_workspace)) %>
            <span class="l-pill <%= state[:open] ? 'good' : '' %>"><%= state[:label] %></span>
          <% end %>
        </div>
      </div>
      <% if current_workspace.feedback_public? %>
        <%= link_to t("customer.home.view_details"), member_shop_about_path, class: "l-btn l-btn-primary l-btn-sm", style: "flex:none;" %>
      <% end %>
    </div>
  </div>

  <div class="l-balance" style="margin-top:14px;">
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <div style="flex:1; min-width:0;">
        <div style="font-size:13px; font-weight:600; color:var(--ink-2);"><%= t("customer.home.points_balance") %></div>
        <div class="v" style="font-size:40px;"><%= number_with_delimiter(@member.points_balance) %> <small><%= t("customer.common.points_unit").upcase %></small></div>
      </div>
      <% if tier %>
        <%= link_to member_tier_path, class: "l-pill tier lg", style: "flex:none; background:#{tier.gradient_css}; color:#{tier.ink_color};" do %>
          <%= ui_icon(tier_icon(tier), size: 13, stroke: 2.2) %><%= t("customer.home.tier_badge", name: tier.name) %>
        <% end %>
      <% end %>
    </div>
    <%= link_to member_history_path, class: "link" do %>
      <%= t("customer.home.view_history") %> <%= ui_icon(:chevron_right, size: 14, stroke: 2.4) %>
    <% end %>
  </div>

  <%# ---- Points expiring soon. The design has no slot for it, but it is the one
        thing on this screen with a deadline, so it sits under the balance it
        applies to. ---- %>
  <% exp_amt, exp_date = prog.points_expire? ? @member.points_expiring_soon(within: 30.days) : [0, nil] %>
  <% if exp_amt.to_i > 0 %>
    <%= link_to member_wallet_path, class: "l-note amber", style: "margin-top:12px; text-decoration:none;" do %>
      <%= ui_icon(:clock, size: 17) %>
      <span><%= t("customer.home.expiring_html", n: number_with_delimiter(exp_amt),
                   when: (exp_date ? t("customer.home.expiring_on", date: l(exp_date.to_date, format: :short)) : "")).html_safe %></span>
    <% end %>
  <% end %>

  <%# ---- Featured rewards ---- %>
  <% if @offers.present? %>
    <div class="l-sec">
      <h3><%= t("customer.home.offers_title") %></h3>
      <%= link_to t("customer.common.see_all"), member_wallet_path, class: "l-pill good" %>
    </div>
    <div data-controller="carousel">
      <div class="l-carousel" data-carousel-target="track">
        <% @offers.each do |r| %>
          <% open = r.redeem_open? %>
          <%= link_to member_reward_path(r), class: "l-offer #{'dim' unless open}" do %>
            <div class="ph"><%= reward_art(r, size: 240, emoji_size: 32) %></div>
            <div class="tt"><%= truncate(r.title, length: 40) %></div>
            <div style="margin-top:auto; display:flex; flex-direction:column; gap:8px;">
              <% if r.cost_points %>
                <span class="l-pill good" style="align-self:flex-start;"><%= t("customer.common.points_count", n: number_with_delimiter(r.cost_points)) %></span>
              <% end %>
              <span class="l-btn <%= open ? "l-btn-primary" : "" %> l-btn-xs l-btn-block">
                <%= open ? t("customer.reward.redeem_cta") : t("customer.wallet.state_unavailable") %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="l-dots" data-carousel-target="dots"></div>
    </div>
  <% end %>

  <%# ---- Play & Collect: the lucky spin and the stamp card, side by side ---- %>
  <% spin_on  = prog.gamification_enabled && @wheel.present? %>
  <% stamp_on = prog.stamps_enabled && @stamp_card.present? %>
  <% if spin_on || stamp_on %>
    <div class="l-sec"><h3><%= t("customer.home.play_collect") %></h3></div>
    <div class="l-duo" style="grid-template-columns:repeat(<%= (spin_on && stamp_on) ? 2 : 1 %>,minmax(0,1fr));">
      <% if spin_on %>
        <div class="l-mini">
          <div class="hd">
            <span class="ic"><%= ui_icon(:refresh, size: 18) %></span>
            <div style="min-width:0;">
              <div class="tt"><%= t("customer.wheel.title") %></div>
              <div class="mt"><%= @wheel_free ? t("customer.home.spin_free_today") : t("customer.wheel.spin_cost", n: @wheel.cost_points) %></div>
            </div>
          </div>
          <div style="display:flex; flex-wrap:wrap; align-items:center; gap:6px;">
            <% if @wheel_top_prize.to_i.positive? %>
              <span style="font-size:12px; color:var(--primary); font-weight:700;"><%= t("customer.home.win_up_to", n: number_with_delimiter(@wheel_top_prize)) %></span>
            <% end %>
            <% if @wheel_free %><span class="l-pill amber" style="font-size:11px; padding:3px 9px;"><%= t("customer.home.daily_bonus") %></span><% end %>
          </div>
          <%= link_to t("customer.home.spin_now"), member_wheel_path, class: "l-btn l-btn-primary l-btn-sm l-btn-block", style: "margin-top:auto;" %>
        </div>
      <% end %>
      <% if stamp_on %>
        <% sm = @stamp_membership; left = [@stamp_card.target_count - sm.count, 0].max %>
        <div class="l-mini">
          <div class="hd">
            <span class="ic" style="font-size:17px;"><%= @stamp_card.display_icon %></span>
            <div style="min-width:0;">
              <div class="tt"><%= truncate(@stamp_card.title, length: 30) %></div>
              <div class="mt"><%= t("customer.stamps.title") %></div>
            </div>
          </div>
          <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:8px;">
            <div style="min-width:0;">
              <div style="font-size:12px; font-weight:700;"><%= t("customer.home.stamps_of", n: sm.count, total: @stamp_card.target_count) %></div>
              <% if @stamp_card.reward %>
                <div style="font-size:12px; color:var(--ink-2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= @stamp_card.reward.title %></div>
              <% end %>
            </div>
            <% if left.positive? %><span class="l-pill brand" style="flex:none;"><%= t("customer.home.n_left", n: left) %></span><% end %>
          </div>
          <%= link_to t("customer.home.view_card"), member_stamps_path, class: "l-btn l-btn-outline l-btn-sm l-btn-block", style: "margin-top:auto;" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ---- Missions: two compact cards, the rest behind "See all" ---- %>
  <% if @missions&.any? %>
    <div class="l-sec">
      <h3><%= t("customer.missions.title") %></h3>
      <%= link_to t("customer.common.see_all"), member_missions_path, class: "l-pill good" %>
    </div>
    <div class="l-duo">
      <% @missions.first(2).each do |m| %>
        <% mp = @progress[m] %>
        <% left = [m.goal.to_i - mp.progress.to_i, 0].max %>
        <%= link_to member_missions_path, class: "l-mini" do %>
          <div class="hd">
            <%# The badge counts what is left to DO. A spend goal is money, not a
                count, so that one keeps its icon instead of showing "100000". %>
            <% countable = m.mission_type != "spend" && left <= 99 %>
            <span class="ic count" style="<%= 'font-size:16px;' unless countable %>">
              <%= mp.completed? ? "✓" : (countable ? left : mission_icon(m, size: 16)) %>
            </span>
            <div style="min-width:0;">
              <div class="tt"><%= truncate(m.title, length: 30) %></div>
              <div class="mt"><%= mission_left_text(m, mp) %></div>
            </div>
          </div>
          <div class="ft">
            <span class="l-pill good"><%= t("customer.common.points_count", n: m.reward_points) %></span>
            <span class="l-pill <%= "brand" if mp.completed? %>">
              <%= mp.completed? ? t("customer.missions.done") : t("customer.missions.in_progress") %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
