<% content_for :title, current_workspace.name %>
<% content_for :tab, "home" %>
<% tier = @tier %>

<header class="l-appbar">
  <%= workspace_avatar(current_workspace) %>
  <div style="min-width:0;">
    <div class="nm"><%= current_workspace.name %></div>
    <div class="hi"><%= t("customer.home.greeting", name: @member.name.presence || current_workspace.branding_value("customer_term")) %></div>
  </div>
  <div style="margin-left:auto; display:flex; align-items:center; gap:14px; color:var(--ink);">
    <%= link_to member_notifications_path, style: "position:relative; text-decoration:none; color:inherit; display:grid; place-items:center;" do %>
      <%= ui_icon(:bell, size: 22) %><% if @unread.to_i.positive? %><span style="position:absolute; top:-5px; right:-6px; background:var(--warn); color:#fff; font-size:10px; font-weight:700; min-width:16px; height:16px; border-radius:999px; display:grid; place-items:center; padding:0 4px;"><%= @unread %></span><% end %>
    <% end %>
  </div>
</header>

<div class="l-screen">
  <%# ---- Membership card (theme-coloured, tier as badge) → tier journey ---- %>
  <%= link_to member_tier_path, style: "text-decoration:none; color:#fff; display:block;" do %>
    <div class="l-card" style="--tier-from: var(--primary); --tier-to: color-mix(in srgb, var(--primary) 52%, #000);">
      <% if tier %>
        <div class="tier-badge" style="background:<%= tier.gradient_css %>;"><span class="medal">👑</span><%= t("customer.home.tier_badge", name: tier.name) %></div>
      <% end %>
      <div class="k" style="<%= 'margin-top:22px;' if tier %>"><%= t("customer.home.points_balance") %></div>
      <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:12px;">
        <div class="pts"><%= number_with_delimiter(@member.points_balance) %></div>
        <div style="text-align:right; opacity:.85; font-size:12px; padding-bottom:8px;">
          <% if tier && tier.multiplier.to_f > 1 %><%= t("customer.home.per_bill_html", m: tier.multiplier) %><% else %><%= current_workspace.program.earn_rate_label %><% end %>
        </div>
      </div>
      <div class="name"><%= @member.display_name.upcase %></div>
      <div class="meta">MEMBER · <%= @member.masked_contact %></div>
    </div>
  <% end %>

  <%# ---- Points expiring soon (only when expiry is configured) ---- %>
  <% exp_amt, exp_date = current_workspace.program.points_expire? ? @member.points_expiring_soon(within: 30.days) : [0, nil] %>
  <% if exp_amt.to_i > 0 %>
    <%= link_to member_wallet_path(tab: "rewards"), style: "display:flex; align-items:center; gap:8px; margin-top:12px; padding:11px 14px; border-radius:14px; background:#F7E0DA; color:#B4402F; text-decoration:none; font-size:13px; font-weight:600;" do %>
      ⏳ <span><strong><%= number_with_delimiter(exp_amt) %></strong> điểm sẽ hết hạn <%= "vào #{l(exp_date.to_date, format: :short)}" if exp_date %> — đổi ngay ›</span>
    <% end %>
  <% end %>

  <%# ---- Quick actions — fixed order (My code + Scan already live in the tab
        bar). Each item is shown only when its feature is enabled. ---- %>
  <% prog = current_workspace.program %>
  <%
    items = []
    items << [member_stamps_path,     :stamp,  t("customer.home.chip_stamps"),  false] if prog.stamps_enabled
    items << [member_wheel_path,      :wheel,  t("customer.home.q_wheel"),      false] if prog.gamification_enabled
    items << [member_missions_path,   :target, t("customer.home.q_missions"),   false] if prog.gamification_enabled
    items << [member_refer_path,      :users,  t("customer.home.q_invite"),     false] if prog.referral_enabled
    items << [member_badges_path,     :medal,  t("customer.home.chip_badges"),  false] if prog.gamification_enabled
    items << [member_shop_about_path, "🏬",    t("customer.home.q_about"),      true]  if current_workspace.feedback_public?
    # ≤5 items fit one row; 6+ split into two balanced rows (6 → 3+3).
    cols = items.size > 5 ? (items.size / 2.0).ceil : items.size
  %>
  <div class="l-quick" style="grid-template-columns:repeat(<%= cols %>, 1fr);">
    <% items.each do |path, icon, label, emoji| %>
      <%= link_to path do %>
        <span class="ic"><% if emoji %><span style="font-size:24px; line-height:1;"><%= icon %></span><% else %><%= ui_icon(icon, size: 26) %><% end %></span><%= label %>
      <% end %>
    <% end %>
  </div>

  <%# ---- Offers carousel (real redeemable rewards; each card opens the reward) ---- %>
  <% if @offers.present? %>
    <% grads = ["linear-gradient(135deg,#8C4A2F,#E08A3C)", "linear-gradient(135deg,#3F7A57,#2C5A3E)",
                "linear-gradient(135deg,#4B9FE1,#3574B0)", "linear-gradient(135deg,#7A5C3A,#B08D57)"] %>
    <div class="l-section-h"><h3><%= t("customer.home.offers_title", term: current_workspace.branding_value("customer_term")) %></h3><%= link_to t("customer.common.all"), member_wallet_path(tab: "rewards") %></div>
    <div data-controller="carousel">
      <div class="l-carousel" data-carousel-target="track">
        <% @offers.each_with_index do |r, i| %>
          <% open = r.redeem_open? %>
          <%= link_to member_reward_path(r), class: "l-offer", style: "text-decoration:none; color:#fff; background:#{grads[i % grads.size]}; position:relative;" do %>
            <div class="l-eyebrow" style="color:#fff; opacity:.85;"><%= r.display_icon %> <%= r.value_label %></div>
            <div class="big"><%= r.title %></div>
            <div style="font-size:12.5px; opacity:.9;">
              <% if open %>
                <% if r.cost_points %><%= t("customer.common.points_count", n: number_with_delimiter(r.cost_points)) %> · <% end %><%= t("customer.reward.redeem_cta", default: "Đổi ngay") %> ›
              <% else %>
                🕑 <%= r.redeem_window_hint %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="l-dots" data-carousel-target="dots"></div>
    </div>
  <% end %>

  <%# ---- Today's missions ---- %>
  <% if @missions&.any? %>
    <div class="l-section-h"><h3><%= t("customer.home.missions_today") %></h3><%= link_to t("customer.common.all"), member_missions_path %></div>
    <div class="l-tile">
      <% @missions.each do |m| %>
        <% mp = @progress[m] %>
        <div class="l-check <%= 'done' if mp.completed? %>">
          <span class="box" style="display:grid; place-items:center; line-height:1; font-size:13px; color:#fff;"><%= "✓" if mp.completed? %></span>
          <div style="flex:1;"><div style="font-weight:600;"><%= mission_icon(m, size: 18) %> <%= m.title %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("customer.common.points_plus", n: m.reward_points) %></div></div>
          <% unless mp.completed? %>
            <% if m.mission_type == "checkin" %>
              <%= link_to t("customer.common.checkin"), member_scan_path, class: "l-btn l-btn-soft", style: "padding:6px 12px; font-size:12px; white-space:nowrap;" %>
            <% elsif m.photo_proof? %>
              <% if mp.pending? %>
                <span class="l-chip" style="font-size:11px;"><%= t("customer.missions.pending_review") %></span>
              <% else %>
                <%= link_to (mp.rejected? ? t("customer.missions.resubmit") : t("customer.missions.submit_proof")),
                      member_new_mission_submission_path(m), class: "l-btn l-btn-soft",
                      style: "padding:6px 12px; font-size:12px; white-space:nowrap;" %>
              <% end %>
            <% elsif m.mission_type == "refer" %>
              <%= link_to t("customer.missions.refer", default: "Mời bạn"), member_refer_path, class: "l-btn l-btn-soft", style: "padding:6px 12px; font-size:12px; white-space:nowrap;" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
