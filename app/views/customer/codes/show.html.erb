<% content_for :title, t("customer.my_code.title") %>
<% content_for :tab, "code" %>
<% content_for :no_tabbar, true %>
<% ink = current_workspace.theme_value(:ink).to_s.delete("#") %>

<%# The design presents the member's code as a sheet over a dimmed app, not as
    a page of its own: it is something you hold up for ten seconds and dismiss. %>
<div class="l-sheetwrap"
     data-controller="mycode"
     data-mycode-token-url-value="<%= member_my_code_token_path %>"
     data-mycode-recent-url-value="<%= member_my_code_recent_path %>"
     data-mycode-after-value="<%= @after_id %>"
     data-mycode-ttl-value="<%= MemberQr::TTL %>"
     data-mycode-locale-value="<%= I18n.locale %>">
  <%= link_to "", member_root_path, class: "scrim", "aria-label": t("customer.common.close") %>

  <div class="l-sheet" style="text-align:center; position:relative;">
    <div class="handle"></div>

    <div style="display:flex; align-items:center; justify-content:center; gap:10px;">
      <div style="font-size:18px; font-weight:700; letter-spacing:-.018em;"><%= t("customer.my_code.title") %></div>
      <% if @member.tier %>
        <span class="l-pill tier" style="background:<%= @member.tier.pill_background %>; color:<%= @member.tier.pill_foreground %>;">
          <%= ui_icon(tier_icon(@member.tier), size: 13, fill: true) %><%= t("customer.home.tier_badge", name: @member.tier.name) %>
        </span>
      <% end %>
    </div>

    <div data-mycode-target="qr" style="display:inline-block; padding:16px; background:#fff; border-radius:18px;
         border:1px solid var(--line-soft); margin-top:18px; line-height:0;">
      <%= qr_svg(@token, color: ink, size: 188) %>
    </div>

    <div style="margin-top:16px;">
      <span class="l-countdown">
        <%= ui_icon(:refresh, size: 14) %>
        <%# Seeded with the real TTL: a literal here made the first paint show a
            number that then jumped. %>
        <strong data-mycode-target="count"><%= MemberQr::TTL %></strong>s
        <%= t("customer.my_code.refresh_post") %>
      </span>
    </div>

    <p style="color:var(--ink-2); font-size:13.5px; line-height:1.5; margin:16px auto 0; max-width:290px;">
      <%= t("customer.my_code.show_to_staff", term: current_workspace.branding_value("customer_term")) %>
    </p>

    <%# The camera does two jobs — check in at the counter, and claim a gift from
        a campaign QR on a poster. It used to say only the first, in small
        underlined text. %>
    <%= link_to member_scan_path, class: "l-btn l-btn-outline",
          style: "margin-top:20px; padding:13px 22px; font-size:15px; gap:10px;" do %>
      <%= ui_icon(:scan, size: 22, stroke: 2) %><%= t("customer.my_code.scan_shop_qr") %>
    <% end %>
    <div style="font-size:12px; color:var(--ink-2); margin-top:7px;"><%= t("customer.my_code.scan_shop_qr_sub") %></div>

    <%# The moment the counter rings it up. This used to be a slab of scanner
        black with a bare "+5" on it — the one screen in the app that looked
        like a debug overlay, and the only one the customer is actually
        watching. It is now the same receipt the full earn screen draws, in the
        same light chrome, because it is the same event. %>
    <div data-mycode-target="burst" class="l-burst" style="display:none;">
      <div class="l-result" style="width:100%;">
        <div class="halo solid"><%= ui_icon(:party, size: 34, stroke: 1.9) %></div>
        <span class="l-pill good"><%= t("customer.my_code.verified") %></span>
        <h1><%= t("customer.my_code.earned_heading_pre") %><span data-mycode-target="burstPoints">0</span><%= t("customer.my_code.earned_heading_post") %></h1>
      </div>

      <div class="l-tile" style="margin-top:18px; width:100%; text-align:left;">
        <div style="display:flex; align-items:center; gap:11px;">
          <%= workspace_avatar(current_workspace, klass: "", style: "width:40px; height:40px; border-radius:12px; flex:none; font-size:14px;") %>
          <div style="flex:1; min-width:0;">
            <div style="font-weight:700; font-size:14.5px;" data-mycode-target="burstShop"><%= current_workspace.name %></div>
            <div style="font-size:12px; color:var(--ink-2); margin-top:2px;" data-mycode-target="burstAt"></div>
          </div>
          <%# Dấu cộng nằm trong cùng một node với con số: .l-pill có gap, nên
              tách ra hai phần tử sẽ hiện thành "+ 120". %>
          <span class="l-pill good" style="flex:none;" data-mycode-target="burstPts2">+0</span>
        </div>
        <div data-mycode-target="burstBillRow" hidden
             style="margin-top:12px; padding-top:4px; border-top:1px solid var(--line-soft);">
          <div class="l-kv">
            <span class="k"><%= t("customer.earn_success.bill") %></span>
            <span class="v"><span data-mycode-target="burstAmount"></span>đ</span>
          </div>
        </div>
        <div class="l-delta" style="margin-top:10px;">
          <div><div class="k"><%= t("customer.earn_success.new_balance") %></div></div>
          <div style="text-align:right;">
            <div class="v hi"><span data-mycode-target="burstBalance">0</span> <%= t("customer.common.points_word") %></div>
          </div>
        </div>
      </div>

      <div style="display:flex; flex-direction:column; gap:10px; margin-top:18px; width:100%;">
        <button type="button" data-action="mycode#dismiss" class="l-btn l-btn-primary l-btn-block"><%= t("customer.my_code.got_it") %></button>
        <%= link_to t("customer.home.view_history"), member_history_path, class: "l-btn l-btn-outline l-btn-block" %>
      </div>
    </div>
  </div>
</div>
