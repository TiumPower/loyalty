<% content_for :title, t("customer.transactions.title") %>
<% content_for :tab, "" %>
<header class="l-appbar">
  <%= link_to "←", member_root_path, style: "font-size:22px; text-decoration:none; color:var(--ink);" %>
  <div class="nm l-display" style="font-size:22px;"><%= t("customer.transactions.title") %></div>
  <span class="l-chip l-chip-brand" style="margin-left:auto;"><%= t("customer.common.points_count", n: number_with_delimiter(@member.points_balance)) %></span>
</header>

<div class="l-screen">
  <% if @transactions.empty? %>
    <div class="l-tile" style="text-align:center; padding:40px 20px;">
      <div style="font-size:40px;">🧾</div>
      <p style="font-weight:600; margin-top:8px;"><%= t("customer.transactions.empty") %></p>
      <p style="color:var(--ink-2); font-size:13px;"><%= t("customer.transactions.empty_sub") %></p>
    </div>
  <% else %>
    <div class="l-tile" style="padding:6px 16px;">
      <% @transactions.each do |tx| %>
        <% bill = tx.source_type == "Purchase" ? @purchases[tx.source_id] : nil %>
        <div class="l-check" style="border-color:var(--line);" data-tx-id="<%= tx.id %>">
          <span style="width:38px; height:38px; border-radius:12px; background:var(--surface-2); display:grid; place-items:center; font-size:18px; flex:none;"><%= tx.icon %></span>
          <div style="flex:1; min-width:0;">
            <div style="font-weight:600; overflow-wrap:anywhere;"><%= tx.title %></div>
            <div style="font-size:12px; color:var(--ink-2);">
              <%= l(tx.created_at, format: :short) %><%= " · #{tx.outlet.name}" if tx.outlet %>
              <%# Without the bill behind it, "+25 điểm" is unverifiable. %>
              <% if bill %> · <%= t("customer.transactions.bill", amount: number_with_delimiter(bill.amount)) %><% end %>
            </div>
          </div>
          <div class="l-num" style="font-size:18px; color:<%= tx.credit? ? 'var(--good)' : 'var(--warn)' %>;">
            <%= tx.credit? ? "+" : "" %><%= number_with_delimiter(tx.amount) %>
          </div>
        </div>
      <% end %>
    </div>
    <% if @has_more %>
      <%= link_to t("customer.transactions.load_more"), member_history_path(page: @page + 1), class: "l-btn l-btn-ghost l-btn-block", style: "margin-top:14px;" %>
    <% end %>
  <% end %>
</div>
