<% content_for :title, t("customer.transactions.title") %>
<% content_for :tab, "history" %>
<% tier = @member.tier %>

<header class="l-subhead">
  <%= link_to member_root_path, class: "l-iconbtn", "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;">
    <div class="t"><%= t("customer.transactions.title") %></div>
    <div class="s"><%= t("customer.transactions.subtitle") %></div>
  </div>
</header>

<div class="l-screen">
  <%# Balance plus where it sits on the tier ladder — the two facts that give
      the ledger below its meaning. %>
  <div class="l-balance">
    <div style="display:flex; align-items:flex-start; gap:12px;">
      <div style="flex:1; min-width:0;">
        <div class="l-eyebrow"><%= t("customer.home.points_balance") %></div>
        <div class="v"><%= number_with_delimiter(@member.points_balance) %><small><%= t("customer.common.points_unit") %></small></div>
      </div>
      <% if tier %><span class="l-pill gold lg" style="flex:none;"><%= tier.name %></span><% end %>
    </div>
    <% if @member.next_tier %>
      <div class="l-bar" style="margin-top:14px;"><span style="width:<%= @member.tier_progress_pct %>%;"></span></div>
      <div style="display:flex; justify-content:space-between; gap:10px; font-size:12px; color:var(--ink-2); margin-top:7px;">
        <span><%= tier&.name %></span>
        <span><%= t("customer.tiers.to_next_short", n: number_with_delimiter(@member.points_to_next), tier: @member.next_tier.name) %></span>
      </div>
    <% end %>
  </div>

  <div class="l-seg auto" style="margin-top:16px;">
    <% [["all", t("customer.transactions.f_all")], ["earned", t("customer.transactions.f_earned")], ["redeemed", t("customer.transactions.f_redeemed")]].each do |key, label| %>
      <%= link_to label, member_history_path(filter: (key == "all" ? nil : key)), class: ("active" if @filter == key) %>
    <% end %>
  </div>

  <div style="margin-top:14px;">
    <% if @transactions.empty? %>
      <div class="l-empty">
        <div class="ic"><%= ui_icon(:receipt, size: 26) %></div>
        <div class="tt"><%= t("customer.transactions.empty") %></div>
        <div class="mt"><%= t("customer.transactions.empty_sub") %></div>
      </div>
    <% else %>
      <% @transactions.each do |tx| %>
        <% day = tx.created_at.to_date %>
        <% bill = tx.source_type == "Purchase" ? @purchases[tx.source_id] : nil %>
        <%# data-tx-id is how the paging test tells rows apart. %>
        <div class="l-row" data-tx-id="<%= tx.id %>" style="align-items:flex-start;">
          <span class="ic <%= tx.credit? ? '' : 'muted' %>" style="width:42px; height:42px;"><%= tx.icon %></span>
          <div class="bd">
            <div class="l-eyebrow" style="font-size:10.5px;">
              <%= day == Date.current ? t("customer.common.today") : l(day, format: :short) %>
            </div>
            <div class="tt" style="margin-top:2px;"><%= tx.title %></div>
            <div class="mt">
              <%= tx.created_at.strftime("%H:%M") %><%= " · #{tx.outlet.name}" if tx.outlet %>
              <%# Without the bill behind it, "+25 điểm" is unverifiable. %>
              <% if bill %> · <%= t("customer.transactions.bill", amount: number_with_delimiter(bill.amount)) %><% end %>
            </div>
          </div>
          <div class="tr" style="align-items:center; gap:6px; font-size:15px; font-weight:700; font-variant-numeric:tabular-nums; color:<%= tx.credit? ? 'var(--good)' : 'var(--warn)' %>;">
            <span style="width:6px; height:6px; border-radius:50%; background:currentColor; flex:none;"></span>
            <%= tx.credit? ? "+" : "" %><%= number_with_delimiter(tx.amount) %>
          </div>
        </div>
      <% end %>
      <% if @has_more %>
        <%= link_to t("customer.transactions.load_more"), member_history_path(page: @page + 1, filter: (@filter == "all" ? nil : @filter)),
              class: "l-btn l-btn-outline l-btn-block", style: "margin-top:16px;" %>
      <% end %>
    <% end %>
  </div>
</div>
