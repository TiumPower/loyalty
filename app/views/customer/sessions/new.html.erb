<% content_for :title, t("customer.session.login_title", name: current_workspace.name) %>
<div class="l-screen no-tabs l-auth">
  <%= workspace_avatar(current_workspace, klass: "brandmark") %>
  <div class="shopname"><%= current_workspace.name %></div>
  <div class="tagline"><%= t("customer.session.welcome_to", shop: current_workspace.name) %></div>

  <div style="margin-top:52px;">
    <div class="lead"><%= t("customer.session.welcome_back") %></div>
    <div class="sub"><%= t("customer.session.enter_email") %></div>

    <%= form_with url: member_login_path, method: :post do %>
      <%# Label and field are one control in the design, not a stacked pair. %>
      <label class="l-inlinefield" style="margin-top:20px;">
        <span class="lb"><%= t("customer.session.phone_label") %></span>
        <input type="email" name="email" value="<%= @email %>" autocomplete="email" autofocus
               placeholder="name@example.com">
      </label>
      <p style="color:var(--ink-2); font-size:13px; line-height:1.55; margin-top:14px;">
        <%= t("customer.session.otp_explainer") %>
      </p>
      <p style="color:var(--primary); font-size:13px; line-height:1.55; margin-top:6px;">
        <%= t("customer.session.first_login_note") %>
      </p>
      <%= submit_tag t("customer.session.get_otp"), class: "l-btn l-btn-primary l-btn-block", style: "margin-top:24px;" %>
    <% end %>
  </div>

  <p class="legal"><%= t("customer.session.login_footer") %></p>
</div>
