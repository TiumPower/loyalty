<% content_for :title, t("customer.tiers.title") %>
<% content_for :tab, "" %>
<header class="l-subhead">
  <%= link_to member_profile_path, class: "l-iconbtn",
        data: { controller: "goback", action: "goback#back" }, "aria-label": t("customer.common.back") do %>
    <%= ui_icon(:arrow_left, size: 18) %>
  <% end %>
  <div style="min-width:0;"><div class="t"><%= t("customer.tiers.your_tier") %></div></div>
  <div class="sp"><span class="l-pill brand"><%= t("customer.common.points_count", n: number_with_delimiter(@member.points_balance)) %></span></div>
</header>

<div class="l-screen" style="text-align:center;">
  <%# ---- the crest ---- %>
  <%# The tier's own glyph — a hexagon, a star, an eight-point burst, a diamond
      — outlined in white, which is how the design draws the emblem. Outlined
      and white, not filled and inked: the star and the name are two colours in
      the design, and painting both the same turns the crest into a smudge. %>
  <div class="l-crest lg" style="background: <%= @current&.crest_gradient || 'linear-gradient(180deg,var(--primary-2),color-mix(in srgb,var(--primary-2) 62%,#000))' %>; color: <%= @current&.ink_color || '#fff' %>;">
    <span class="em"><%= ui_icon(tier_icon(@current), size: 46, stroke: 2.2) %></span>
    <div class="nm"><%= @current&.name %></div>
  </div>
  <div style="font-size:21px; font-weight:700; letter-spacing:-.02em; margin-top:18px;"><%= @member.display_name %></div>
  <div style="font-size:13.5px; color:var(--ink-2); margin-top:5px;"><%= t("customer.tiers.earned_this_period", n: number_with_delimiter(@member.points_balance)) %></div>

  <%# ---- how far to the next one ---- %>
  <% if @member.next_tier %>
    <div style="margin-top:24px; text-align:left;">
      <%# As in the design: the rung you are on is labelled in its own colour,
          the one you are climbing towards in the shop's. %>
      <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700;">
        <span style="color:<%= @current&.gradient_to.presence || 'var(--primary)' %>;"><%= @current&.name %></span>
        <span style="color:var(--primary);"><%= @member.next_tier.name %></span>
      </div>
      <div class="l-bar thick" style="margin-top:8px;"><span style="width:<%= @member.tier_progress_pct %>%;"></span></div>
      <div style="font-size:12.5px; color:var(--ink-2); margin-top:8px;">
        <%= t("customer.tiers.to_next_short", n: number_with_delimiter(@member.points_to_next), tier: @member.next_tier.name) %>
      </div>
    </div>
  <% else %>
    <div class="l-pill good" style="margin-top:20px;"><%= t("customer.tiers.top") %></div>
  <% end %>

  <%# ---- what the current tier gets you ---- %>
  <% if @current %>
    <div style="text-align:left; margin-top:26px;">
      <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em;"><%= t("customer.tiers.your_benefits") %></h3>
      <div style="margin-top:8px;">
        <% tier_benefit_rows(@current).each do |icon, label, value| %>
          <div class="l-benefit">
            <span class="ic"><%= ui_icon(icon, size: 17) %></span>
            <span><%= label %></span>
            <% if value %><span class="v"><%= value %></span><% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ---- the ladder ---- %>
  <div style="text-align:left; margin-top:26px;">
    <h3 style="font-size:17px; font-weight:700; letter-spacing:-.015em;"><%= t("customer.tiers.tiers_benefits") %></h3>
    <div style="margin-top:10px;">
      <% @tiers.each do |tier| %>
        <% is_current = tier.key == @current&.key %>
        <% reached = @member.points_balance >= tier.threshold_points.to_i %>
        <div class="l-row" style="<%= 'border-color:var(--primary);' if is_current %>">
          <%# Its own colour and glyph, greyed while it is still out of reach —
              the lock moves next to the name so the rung stays recognisable. %>
          <span class="ic l-tierdot <%= 'locked' unless reached %>" style="background:<%= tier.gradient_css %>; color:<%= tier.ink_color %>;">
            <%= ui_icon(tier_icon(tier), size: 17, fill: true) %>
          </span>
          <div class="bd">
            <div class="tt">
              <%= tier.name %>
              <% if is_current %><span class="l-pill brand" style="margin-left:6px;"><%= t("customer.tiers.current_chip") %></span><% end %>
              <% unless reached %><span style="margin-left:6px; color:var(--ink-2); vertical-align:-2px;"><%= ui_icon(:lock, size: 13) %></span><% end %>
            </div>
            <div class="mt"><%= t("customer.tiers.from_points", n: number_with_delimiter(tier.threshold_points), m: tier.multiplier) %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Badges are a collection of tier moments, so they hang off this screen —
      the design gives them no other entry point. %>
  <% if current_workspace.program.gamification_enabled %>
    <%= link_to member_badges_path, class: "l-action", style: "margin-top:18px;" do %>
      <%= ui_icon(:trophy, size: 18) %>
      <span style="flex:1; min-width:0; text-align:left;"><%= t("customer.badges.title") %></span>
      <%= ui_icon(:chevron_right, size: 16, stroke: 2.2) %>
    <% end %>
  <% end %>
</div>
