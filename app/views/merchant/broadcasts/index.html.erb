<% content_for :title, t("merchant.broadcasts.sent_title") %>
<% content_for :title_en, "BROADCASTS" %>

<style>
  .bc-head{display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:18px;}
  .bc-head .sub{color:var(--ink-2); font-size:13.5px; margin-top:2px;}
  .bc-list{display:flex; flex-direction:column; gap:12px;}
  .bc-card{display:flex; align-items:flex-start; gap:14px; padding:16px; background:var(--surface,#fff);
    border:1px solid var(--line); border-radius:16px; transition:border-color .15s, box-shadow .15s, transform .05s;}
  .bc-card:hover{border-color:var(--primary); box-shadow:0 10px 26px -18px var(--primary);}
  .bc-ava{width:44px; height:44px; flex:none; border-radius:13px; display:grid; place-items:center;
    font-size:20px; background:var(--primary-soft,#F3E6DF); color:var(--primary);}
  .bc-main{flex:1; min-width:0;}
  .bc-title{font-weight:700; font-size:15.5px; line-height:1.25; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .bc-body{font-size:13px; color:var(--ink-2); margin-top:3px; line-height:1.45;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;}
  .bc-meta{display:flex; align-items:center; gap:8px; margin-top:10px; font-size:11.5px; color:var(--ink-2); flex-wrap:wrap;}
  .bc-meta .dot{width:3px; height:3px; border-radius:50%; background:var(--ink-2); opacity:.5;}
  .bc-side{flex:none; display:flex; flex-direction:column; align-items:flex-end; gap:0;}
  .bc-badge{display:inline-flex; align-items:center; gap:5px; padding:5px 11px; border-radius:999px;
    font-size:12px; font-weight:700; white-space:nowrap;}
  .bc-badge.sent{background:var(--primary-soft,#F3E6DF); color:var(--primary);}
  .bc-badge.sched{background:var(--surface-2,#EEF0F3); color:var(--ink-2);}
  @media (max-width:600px){ .bc-card{padding:13px;} .bc-title{white-space:normal;} }
</style>

<div class="bc-head">
  <div>
    <div class="l-eyebrow"><%= t("merchant.broadcasts.sent_title") %></div>
    <div class="sub"><%= t("merchant.broadcasts.list_sub", n: @broadcasts.respond_to?(:total_count) ? @broadcasts.total_count : @broadcasts.size) %></div>
  </div>
  <%= link_to new_merchant_broadcast_path, class: "l-btn l-btn-primary" do %>
    ✉ <%= t("merchant.broadcasts.compose") %>
  <% end %>
</div>

<% if @broadcasts.empty? %>
  <div class="l-panel" style="text-align:center; padding:56px 24px;">
    <div style="font-size:44px;">✉️</div>
    <h3 class="l-display" style="font-size:20px; margin-top:10px;"><%= t("merchant.broadcasts.empty") %></h3>
    <p style="color:var(--ink-2); margin:6px 0 18px;"><%= t("merchant.broadcasts.empty_sub") %></p>
    <%= link_to t("merchant.broadcasts.compose"), new_merchant_broadcast_path, class: "l-btn l-btn-primary" %>
  </div>
<% else %>
  <div class="bc-list">
    <% @broadcasts.each do |b| %>
      <div class="bc-card">
        <div class="bc-ava"><%= MemberSegments.icon(b.segment_key) %></div>
        <div class="bc-main">
          <div class="bc-title"><%= b.title %></div>
          <% if b.body.present? %><div class="bc-body"><%= b.body %></div><% end %>
          <div class="bc-meta">
            <span><%= b.audience_display %></span>
            <span class="dot"></span>
            <span>
              <% if b.scheduled? %>
                🕑 <%= t("merchant.broadcasts.scheduled_chip", time: l(b.scheduled_at, format: :short)) %>
              <% else %>
                <%= l(b.created_at, format: :short) %>
              <% end %>
            </span>
          </div>
        </div>
        <div class="bc-side" style="display:flex; align-items:center; gap:8px;">
          <% if b.scheduled? %>
            <span class="bc-badge sched">🕑 <%= t("merchant.broadcasts.scheduled_word") %></span>
            <%# Scheduling with no way to call it back left a manager who changed
                their mind watching it go out. %>
            <% if current_membership&.can_manage? %>
              <%= button_to t("merchant.broadcasts.cancel"), merchant_broadcast_path(b), method: :delete,
                    class: "l-btn l-btn-ghost", style: "padding:5px 10px; font-size:12px;",
                    form: { style: "display:inline;",
                            data: { turbo_confirm: t("merchant.broadcasts.cancel_confirm",
                                                     time: l(b.scheduled_at, format: :short)) } } %>
            <% end %>
          <% else %>
            <span class="bc-badge sent">👥 <%= t("merchant.broadcasts.count", n: b.sent_count) %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
