<% content_for :title, t("merchant.nav.broadcasts") %>
<% content_for :title_en, "BROADCAST" %>
<% merchant_back merchant_broadcasts_path %>

<div data-controller="campaign-preview" class="l-work wide">
  <%= form_with model: @broadcast, url: merchant_broadcasts_path, method: :post do |f| %>
    <% if @broadcast.errors.any? %>
      <div class="l-panel" style="margin-bottom:16px; background:#F7E0DA; color:#B4402F; border:none;">
        <%= @broadcast.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow"><%= t("merchant.broadcasts.step1") %></div>
      <div style="display:flex; align-items:center; gap:10px; margin-top:8px;">
        <span style="font-size:24px;"><%= MemberSegments.icon(@segment) %></span>
        <div style="flex:1;">
          <div style="font-weight:700;"><%= @audience_label %></div>
          <div style="font-size:13px; color:var(--ink-2);"><%= t("merchant.broadcasts.will_send_html", n: @count).html_safe %></div>
        </div>
        <%= link_to t("merchant.broadcasts.change_group"), merchant_customers_path, class: "l-chip" %>
      </div>
      <%= f.hidden_field :segment_key, value: @segment %>
      <%= f.hidden_field :audience_outlet_id, value: @outlet&.id %>
      <%= f.hidden_field :audience_query, value: @q %>
      <%= f.hidden_field :audience_tier, value: @tier %>
    </div>

    <div class="l-panel" style="margin-bottom:16px;">
      <div class="l-eyebrow"><%= t("merchant.broadcasts.step2") %></div>
      <label class="l-label" style="margin-top:8px;"><%= t("merchant.broadcasts.title") %></label>
      <%= f.text_field :title, class: "l-field", required: true, placeholder: t("merchant.broadcasts.title_ph"),
            data: { campaign_preview_target: "title", action: "input->campaign-preview#update" } %>
      <label class="l-label" style="margin-top:12px;"><%= t("merchant.broadcasts.content") %></label>
      <%= f.text_area :body, class: "l-field", rows: 3, required: true, placeholder: t("merchant.broadcasts.content_ph"),
            data: { campaign_preview_target: "body", action: "input->campaign-preview#update" } %>
      <label class="l-label" style="margin-top:12px;"><%= t("merchant.broadcasts.schedule_label") %></label>
      <input type="datetime-local" name="scheduled_at" value="<%= params[:scheduled_at] %>" class="l-field">
    </div>

    <% if @count.to_i.zero? %>
      <div class="l-chip" style="background:#F7E0DA; color:#B4402F;"><%= t("merchant.broadcasts.empty_group") %></div>
    <% else %>
      <%= f.submit t("merchant.broadcasts.send_now"), class: "l-btn l-btn-primary",
            data: { turbo_confirm: t("merchant.broadcasts.send_confirm", n: @count) } %>
    <% end %>
  <% end %>

  <div style="position:sticky; top:90px;">
    <div class="l-eyebrow" style="margin-bottom:8px;"><%= t("merchant.broadcasts.step3") %></div>
    <div class="l-tile">
      <div style="display:flex; gap:12px;">
        <div style="width:42px; height:42px; border-radius:14px; background:var(--primary); color:#fff; display:grid; place-items:center; font-size:20px; flex:none;">🎁</div>
        <div style="flex:1; min-width:0;">
          <div data-campaign-preview-target="pvTitle" style="font-weight:700;"><%= t("merchant.broadcasts.pv_title") %></div>
          <div data-campaign-preview-target="pvBody" style="font-size:13px; color:var(--ink-2); margin-top:2px;"><%= t("merchant.broadcasts.pv_body") %></div>
          <div style="font-size:11px; color:var(--ink-2); margin-top:6px;"><%= t("merchant.broadcasts.just_now") %> · <%= current_workspace.name %></div>
        </div>
      </div>
    </div>
  </div>
</div>
