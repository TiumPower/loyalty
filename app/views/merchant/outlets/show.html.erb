<% content_for :title, @outlet.name %>
<% content_for :title_en, "OUTLET" %>
<% merchant_back merchant_outlets_path %>

<div>
  <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
    <div>
      <h2 class="l-display" style="font-size:24px;"><%= @outlet.name %></h2>
      <% if @outlet.address.present? %><div style="color:var(--ink-2); font-size:13px;">📍 <%= @outlet.address %></div><% end %>
    </div>
  </div>

  <%# ---- Branch check-in QR — prominent, easy to open/print ---- %>
  <div class="l-panel" style="margin-bottom:16px; display:flex; gap:18px; align-items:center; flex-wrap:wrap;">
    <%= render "merchant/shared/qr_zoom", url: @checkin_url, size: 128,
          title: "#{t('merchant.outlets.checkin_title')} — #{@outlet.name}",
          note: t("merchant.dashboard.checkin_note") %>
    <div style="flex:1; min-width:220px;">
      <div class="l-eyebrow"><%= t("merchant.outlets.checkin_title") %></div>
      <h3 class="l-display" style="font-size:18px; margin:2px 0 4px;"><%= @outlet.name %></h3>
      <p style="color:var(--ink-2); font-size:13px; margin-bottom:12px;"><%= t("merchant.outlets.checkin_desc_html", name: @outlet.name) %></p>
      <%= link_to checkin_qr_merchant_outlet_path(@outlet), class: "l-btn l-btn-primary", data: { turbo: false } do %>
        <%= ui_icon(:launch, size: 16) %> <%= t("merchant.dashboard.download_code") %>
      <% end %>
    </div>
  </div>

  <div class="l-kpis">
    <div class="l-kpi"><div class="k"><%= t("merchant.dashboard.revenue") %></div><div class="v"><%= number_with_delimiter(@revenue) %>đ</div><div class="d"><%= t("merchant.dashboard.transactions", n: @purchases) %></div></div>
    <div class="l-kpi"><div class="k"><%= t("merchant.dashboard.points_issued") %></div><div class="v"><%= number_with_delimiter(@points) %></div></div>
    <div class="l-kpi"><div class="k"><%= t("merchant.dashboard.visited") %></div><div class="v"><%= number_with_delimiter(@customers) %></div></div>
    <div class="l-kpi"><div class="k"><%= t("merchant.dashboard.vouchers_used") %></div><div class="v"><%= number_with_delimiter(@vouchers) %></div></div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1.4fr; gap:16px; margin-top:20px;">
    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:10px;"><%= t("merchant.outlets.detail_staff") %></h3>
      <% if @staff.any? %>
        <% @staff.each do |m| %>
          <div style="display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--line);">
            <span class="av" style="width:32px; height:32px; border-radius:9px; background:var(--surface-2); display:grid; place-items:center; font-size:12px; font-weight:600;"><%= m.user&.initials %></span>
            <div style="flex:1; min-width:0;">
              <div style="font-weight:600; font-size:14px;"><%= m.user&.name %></div>
              <div style="font-size:12px; color:var(--ink-2);"><%= m.user&.email %></div>
            </div>
            <span class="l-chip"><%= m.label %></span>
          </div>
        <% end %>
      <% else %>
        <p style="color:var(--ink-2); font-size:13px;"><%= t("merchant.outlets.no_staff_html", link: link_to(t("merchant.outlets.add_at_staff"), merchant_staff_index_path, style: "color:var(--primary-ink);")).html_safe %></p>
      <% end %>
    </div>

    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:10px;"><%= t("merchant.outlets.recent_txns") %></h3>
      <% if @recent.any? %>
        <table style="width:100%; border-collapse:collapse; font-size:13.5px;">
          <% @recent.each do |tx| %>
            <tr style="border-top:1px solid var(--line);">
              <td style="padding:9px 4px;"><%= tx.member&.display_name %></td>
              <td style="color:var(--ink-2);"><%= tx.title %></td>
              <td style="text-align:right; color:var(--ink-2); white-space:nowrap;"><%= l(tx.created_at, format: :short) %></td>
              <td class="l-num" style="text-align:right; color:<%= tx.credit? ? 'var(--good)' : 'var(--warn)' %>;"><%= tx.credit? ? "+" : "" %><%= number_with_delimiter(tx.amount) %></td>
            </tr>
          <% end %>
        </table>
      <% else %>
        <p style="color:var(--ink-2); font-size:13px;"><%= t("merchant.outlets.no_txns") %></p>
      <% end %>
    </div>
  </div>

</div>
