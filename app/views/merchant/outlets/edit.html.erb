<% content_for :title, t("merchant.outlets.edit_title") %>
<% content_for :title_en, "EDIT OUTLET" %>
<% merchant_back merchant_outlet_path(@outlet) %>
<%# Full width in two columns, like every other editor. %>
<div class="m-editor">
 <div class="l-panel">
  <%= form_with model: @outlet, url: merchant_outlet_path(@outlet), method: :patch,
        data: { controller: "geopick",
                geopick_url_value: geocode_merchant_outlets_path,
                geopick_working_value: t("merchant.outlets.geo_working"),
                geopick_empty_value: t("merchant.outlets.geo_no_address"),
                geopick_failed: t("merchant.outlets.geo_failed") } do |f| %>
    <% if @outlet.errors.any? %>
      <div class="l-note warn" style="margin-bottom:12px;">
        <%= ui_icon(:shield, size: 16) %><span><%= @outlet.errors.full_messages.to_sentence %></span>
      </div>
    <% end %>
    <label class="l-label"><%= t("merchant.outlets.name") %></label>
    <%= f.text_field :name, class: "l-field" %>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
      <div><label class="l-label"><%= t("merchant.outlets.code") %></label><%= f.text_field :code, class: "l-field" %></div>
      <div><label class="l-label"><%= t("merchant.outlets.phone") %></label><%= f.telephone_field :phone, class: "l-field" %></div>
    </div>
    <label class="l-label" style="margin-top:12px;"><%= t("merchant.outlets.address") %></label>
    <%= f.text_field :address, class: "l-field", data: { geopick_target: "address" } %>

    <%# Opening hours. The customer app shows "Mở tới 22:00" from this, and
        shows nothing at all while it is blank rather than guessing. %>
    <label class="l-label" style="margin-top:12px;"><%= t("merchant.outlets.hours") %></label>
    <div style="display:flex; align-items:center; gap:10px;">
      <input type="time" name="outlet[open_hours][open]" value="<%= @outlet.opens_at %>" class="l-field" style="max-width:150px;">
      <span style="color:var(--ink-2); font-size:13px;"><%= t("merchant.outlets.hours_to") %></span>
      <input type="time" name="outlet[open_hours][close]" value="<%= @outlet.closes_at %>" class="l-field" style="max-width:150px;">
    </div>
    <p style="font-size:12px; color:var(--ink-2); margin-top:6px; line-height:1.45;"><%= t("merchant.outlets.hours_hint") %></p>
    <%# Coordinates. Filled in automatically from the address; the fields are
        here because Vietnamese street names repeat across the country and the
        automatic answer is sometimes the wrong street. Typing one marks the
        branch as set by hand, and the automatic lookup then leaves it alone. %>
    <div style="display:flex; align-items:flex-end; gap:10px; margin-top:16px;">
      <label class="l-label" style="flex:1; min-width:0; margin:0;"><%= t("merchant.outlets.coords") %></label>
      <%# Editing an address and waiting for the background job to catch up left
          the merchant with no way to say "look it up again, now". %>
      <button type="button" class="m-minibtn" style="flex:none;"
              data-geopick-target="button" data-action="geopick#fetchCoords">
        <%= ui_icon(:navigate, size: 14) %><%= t("merchant.outlets.geo_cta") %>
      </button>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:6px;">
      <%= f.text_field :latitude,  class: "l-field", placeholder: "10.8012", inputmode: "decimal",
            data: { geopick_target: "lat", action: "input->geopick#typed" } %>
      <%= f.text_field :longitude, class: "l-field", placeholder: "106.7360", inputmode: "decimal",
            data: { geopick_target: "lon", action: "input->geopick#typed" } %>
    </div>
    <%= hidden_field_tag :coords_source, "", data: { geopick_target: "source" } %>
    <p class="m-geostatus" data-geopick-target="status" hidden></p>
    <p style="font-size:12px; color:var(--ink-2); margin-top:6px; line-height:1.45;">
      <% if @outlet.geocode_manual? %>
        <%= t("merchant.outlets.coords_manual") %>
      <% elsif @outlet.located? %>
        <%= t("merchant.outlets.coords_auto", when: (@outlet.geocoded_at ? l(@outlet.geocoded_at.to_date, format: :short) : "—")) %>
      <% else %>
        <%= t("merchant.outlets.coords_pending") %>
      <% end %>
    </p>
    <% if @outlet.geocode_manual? %>
      <label style="display:inline-flex; align-items:center; gap:7px; margin-top:8px; font-size:13px; color:var(--ink-2);">
        <%= check_box_tag :reset_geocode, "1", false, style: "margin:0;" %>
        <%= t("merchant.outlets.coords_reset") %>
      </label>
    <% end %>

    <label style="display:flex; align-items:center; gap:8px; margin-top:12px; font-size:14px;">
      <%= f.check_box :active %> <%= t("merchant.outlets.active") %>
    </label>
    <div style="display:flex; gap:10px; margin-top:18px;">
      <%= link_to t("merchant.outlets.cancel"), merchant_outlets_path, class: "l-btn l-btn-ghost" %>
      <%= f.submit t("merchant.outlets.save"), class: "l-btn l-btn-primary", style: "flex:1;" %>
    </div>
  <% end %>
 </div>

 <%# Where each of these fields ends up. Opening hours in particular are set
     here, per branch, and nowhere else — worth saying on the screen rather than
     leaving a merchant hunting under Brand. %>
 <div class="m-section">
   <div class="hd">
     <div class="t"><%= t("merchant.outlets.where_shown") %></div>
     <div class="s"><%= t("merchant.outlets.where_shown_sub") %></div>
   </div>
   <% [[:pin, :ws_address], [:clock, :ws_hours], [:navigate, :ws_distance], [:qrcode, :ws_qr]].each do |icon, key| %>
     <div style="display:flex; gap:10px; align-items:flex-start; padding:9px 0; font-size:13px; color:var(--ink-2);">
       <span style="flex:none; color:var(--primary); margin-top:1px;"><%= ui_icon(icon, size: 15) %></span>
       <span><%= t("merchant.outlets.#{key}") %></span>
     </div>
   <% end %>
 </div>
</div>
