<% content_for :title, t("merchant.choose.title") %>
<h1><%= t("merchant.choose.title") %></h1>
<p class="sub"><%= t("merchant.choose.sub") %></p>

<% if @workspaces.empty? %>
  <div style="text-align:center; padding:14px 0;">
    <p style="color:var(--ink-2); font-size:14px;"><%= t("merchant.choose.no_shops") %></p>
    <%= link_to t("merchant.choose.create_shop"), merchant_signup_path, class: "l-btn l-btn-primary l-btn-block", style: "margin-top:12px;" %>
  </div>
<% else %>
  <div style="display:flex; flex-direction:column; gap:10px;">
    <% @workspaces.each do |ws| %>
      <%= link_to merchant_url_for(ws, merchant_home_path), data: { turbo: false },
            style: "display:flex; align-items:center; gap:12px; padding:12px 14px; border:1px solid var(--line); border-radius:14px; text-decoration:none; color:var(--ink); background:#fff;" do %>
        <span style="width:40px; height:40px; border-radius:11px; flex:none; overflow:hidden; display:grid; place-items:center; color:#fff; font-weight:700; background:<%= ws.theme_value(:primary) %>;">
          <% if ws.logo.attached? %><%= image_tag url_for(ws.logo), style: "width:100%;height:100%;object-fit:cover;" %><% else %><%= ws.logo_initials %><% end %>
        </span>
        <span style="flex:1; min-width:0;">
          <span style="display:block; font-weight:600;"><%= ws.name %></span>
          <span class="l-mono" style="display:block; font-size:12px; color:var(--ink-2);"><%= workspace_host(ws) %></span>
        </span>
        <% if ws.access_blocked? %>
          <span class="l-chip" style="background:#F3DDD7; color:#B4402F; font-size:11px;"><%= t("merchant.choose.suspended") %></span>
        <% end %>
        <span style="color:var(--ink-2); font-size:18px;">›</span>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= button_to t("merchant.choose.logout"), destroy_user_session_path, method: :delete,
      form: { data: { turbo: false } },
      class: "l-btn l-btn-ghost l-btn-block", style: "margin-top:16px;" %>
