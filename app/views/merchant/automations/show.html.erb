<% content_for :title, t("merchant.nav.automations") %>
<% content_for :title_en, "AUTOMATIONS" %>
<% a = ->(k, **o) { t("merchant.automations.#{k}", **o) } %>

<%= render "merchant/shared/messages_tabs", current: :automations %>

<div class="m-sec">
  <div>
    <h3><%= a.(:list_title) %></h3>
    <div class="sub"><%= a.(:intro) %></div>
  </div>
</div>

<% if @rewards.empty? %>
  <div class="l-note warn" style="margin-bottom:16px;">
    <%= ui_icon(:shield, size: 16) %><span><%= a.(:need_reward) %></span>
  </div>
<% end %>

<div class="l-panel" style="padding:6px 10px;">
  <table class="m-table">
    <thead>
      <tr>
        <th><%= a.(:col_automation) %></th>
        <th><%= a.(:col_trigger) %></th>
        <th><%= a.(:col_gift) %></th>
        <th><%= a.(:col_status) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% Merchant::AutomationsController::KINDS.each do |kind| %>
        <% cfg    = @cfg[kind] || {} %>
        <% on     = cfg["enabled"] %>
        <% reward = @rewards.find { |r| r.id == cfg["reward_id"].to_i } %>
        <tr>
          <td>
            <div class="m-who">
              <span class="av" style="background:var(--primary-soft); color:var(--primary-ink);"><%= ui_icon(automation_icon(kind), size: 16) %></span>
              <div style="min-width:0;">
                <div class="nm"><%= a.("#{kind}_title") %></div>
                <div class="sub"><%= a.("#{kind}_desc") %></div>
              </div>
            </div>
          </td>
          <td style="color:var(--ink-2);">
            <%= kind == "winback" ? a.(:trig_winback, n: (cfg["days"].presence || 30)) : a.("trig_#{kind}") %>
          </td>
          <td>
            <% if reward %>
              <%= reward.display_icon %> <%= reward.title %>
            <% else %>
              <span style="color:var(--ink-2);"><%= a.(:no_gift_set) %></span>
            <% end %>
          </td>
          <td>
            <span class="m-badge <%= 'up' if on %>"><%= on ? a.(:on) : a.(:off) %></span>
          </td>
          <td>
            <%# Trạng thái trước đây chỉ là một con chữ, công tắc thật nằm trong
                Chỉnh sửa — nhìn vào bảng không ai biết bật ở đâu. Đặt luôn hành
                động ngay cạnh trạng thái nó đổi. %>
            <div style="display:flex; align-items:center; gap:14px; justify-content:flex-end;">
              <%= button_to on ? a.(:turn_off) : a.(:turn_on), merchant_toggle_automation_path(kind),
                    method: :post, class: "l-btn l-btn-sm #{on ? 'l-btn-soft' : 'l-btn-primary'}" %>
              <%= link_to a.(:edit), merchant_edit_automation_path(kind),
                    style: "font-size:13px; font-weight:600; color:var(--primary); text-decoration:none;" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="l-note" style="margin-top:16px;">
  <%= ui_icon(:clock, size: 16) %>
  <span><strong><%= a.(:schedule_note) %></strong> <%= a.(:schedule_note_sub) %></span>
</div>
