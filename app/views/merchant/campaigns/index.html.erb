<% content_for :title, t("merchant.nav.campaigns") %>
<% content_for :title_en, "CAMPAIGNS" %>

<div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
  <%= link_to t("merchant.campaigns.create"), new_merchant_campaign_path, class: "l-btn l-btn-primary" %>
</div>

<% if @campaigns.empty? %>
  <div class="l-panel" style="text-align:center; padding:48px;">
    <div style="font-size:40px;">◈</div>
    <h3 class="l-display" style="font-size:20px; margin-top:8px;"><%= t("merchant.campaigns.empty") %></h3>
    <p style="color:var(--ink-2);"><%= t("merchant.campaigns.empty_sub") %></p>
  </div>
<% else %>
  <div class="l-panel" style="padding:0;">
    <div style="overflow-x:auto;">
      <table class="m-table" style="min-width:880px;">
        <thead>
          <tr>
            <th style="padding-left:18px;"><%= t("merchant.campaigns.col_campaign") %></th>
            <th><%= t("merchant.campaigns.col_status") %></th>
            <th><%= t("merchant.campaigns.col_type") %></th>
            <th><%= t("merchant.campaigns.col_audience") %></th>
            <th style="padding-right:18px;"><%= t("merchant.campaigns.col_performance") %></th>
          </tr>
        </thead>
        <tbody>
          <% @campaigns.each do |c| %>
            <% pc = c.promo_codes.first %>
            <tr>
              <td style="padding-left:18px;">
                <%= link_to merchant_campaign_path(c), style: "font-weight:600; color:var(--primary-ink); text-decoration:none;" do %>
                  <%= c.name %>
                <% end %>
                <% if c.reward %>
                  <div style="font-size:12px; color:var(--ink-2);"><%= c.reward.title %></div>
                <% end %>
              </td>
              <td>
                <span class="m-badge <%= 'up' if c.status == 'running' %>"><%= c.status_label %></span>
              </td>
              <td style="color:var(--ink-2); font-size:12.5px;"><%= c.type_label %></td>
              <td style="color:var(--ink-2); font-size:12.5px;"><%= c.audience_label %></td>
              <td style="padding-right:18px; font-size:12.5px;">
                <% if pc %>
                  <%# Scans, claims and uses are three different things: a code
                      scanned but never claimed is a different problem from one
                      claimed but never used. %>
                  <span class="m-num"><%= pc.scan_count %></span> <span style="color:var(--ink-2);"><%= t("merchant.campaigns.w_scans") %></span>
                  · <span class="m-num"><%= pc.claims_count %></span> <span style="color:var(--ink-2);"><%= t("merchant.campaigns.w_claims") %></span>
                  · <span class="m-num" style="color:var(--good);"><%= pc.used_count %></span> <span style="color:var(--ink-2);"><%= t("merchant.campaigns.w_uses") %></span>
                <% else %>
                  <span style="color:var(--ink-2);">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
