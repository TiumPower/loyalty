<% content_for :title, @campaign.name %>
<% content_for :title_en, "CAMPAIGN" %>
<% merchant_back merchant_campaigns_path %>
<%# Static metadata (not clickable): plain labels with dot separators %>
<div style="display:flex; align-items:center; gap:8px; margin-bottom:16px; flex-wrap:wrap; color:var(--ink-2); font-size:13px;">
  <span><%= @campaign.type_label %></span>
  <span style="opacity:.5;">·</span>
  <span style="display:inline-flex; align-items:center; gap:6px; font-weight:700; color:<%= @campaign.status == 'running' ? 'var(--good)' : 'var(--ink)' %>;">
    <% if @campaign.status == "running" %><span style="width:7px; height:7px; border-radius:50%; background:var(--good); display:inline-block;"></span><% end %>
    <%= @campaign.status_label %>
  </span>
  <span style="opacity:.5;">·</span>
  <span><%= @campaign.audience_label %></span>
</div>

<% if current_membership&.can_manage? %>
  <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap;">
    <%= link_to "✏️ #{t('merchant.campaigns.edit')}", edit_merchant_campaign_path(@campaign),
          class: "l-btn l-btn-soft", style: "padding:8px 14px;" %>
    <% if @campaign.status == "running" %>
      <%= button_to "⏸ Tạm dừng", pause_merchant_campaign_path(@campaign), method: :patch,
            class: "l-btn l-btn-soft", style: "border-color:color-mix(in srgb, var(--btn-primary) 32%, transparent);", form: { style: "display:inline;" } %>
    <% elsif @campaign.status == "paused" %>
      <%= button_to "▶ Tiếp tục", resume_merchant_campaign_path(@campaign), method: :patch,
            class: "l-btn l-btn-primary", form: { style: "display:inline;" } %>
    <% end %>
    <%= button_to "🗑 Xoá chiến dịch", merchant_campaign_path(@campaign), method: :delete,
          class: "l-btn l-btn-ghost", style: "color:var(--warn); border-color:color-mix(in srgb, var(--warn) 45%, var(--line));",
          form: { style: "display:inline;", data: { turbo_confirm: "Xoá chiến dịch này? Mã QR phát hành sẽ ngừng hoạt động. Voucher đã phát cho khách vẫn được giữ." } } %>
  </div>
<% end %>

<% if current_membership&.can_manage? %>
  <div class="l-panel" style="margin-bottom:16px;">
    <div class="l-eyebrow" style="margin-bottom:10px;"><%= t("merchant.campaigns.share_push") %></div>
    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
      <input type="text" value="<%= @share_url %>" readonly onclick="this.select()"
             class="l-field" style="flex:1; min-width:220px; font-size:13px;">
      <span data-controller="clipboard" data-clipboard-text-value="<%= @share_url %>">
        <button type="button" class="l-btn l-btn-soft" style="padding:8px 14px; font-size:13px;" data-action="clipboard#copy">
          📋 <span data-clipboard-target="label"><%= t("merchant.campaigns.copy_link") %></span>
        </button>
      </span>
      <a href="<%= @share_url %>" target="_blank" rel="noopener" class="l-btn l-btn-soft" style="padding:8px 14px; font-size:13px;">🔗 <%= t("merchant.campaigns.open_link") %></a>
      <div data-controller="audiencepick" style="position:relative; display:inline-block;">
        <button type="button" class="l-btn l-btn-primary" style="padding:8px 14px; font-size:13px;"
                data-action="audiencepick#toggle" data-audiencepick-target="button">
          <%= t("merchant.campaigns.push_now") %> ▾
        </button>
        <%= form_with url: push_merchant_campaign_path(@campaign), method: :post,
              data: { turbo_confirm: t("merchant.campaigns.push_confirm_multi") } do %>
          <div data-audiencepick-target="panel" hidden
               style="position:absolute; z-index:1000; top:calc(100% + 6px); right:0; width:290px; background:#fff; border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow-lg); padding:10px; max-height:340px; overflow:auto;">
            <div style="font-size:12px; font-weight:700; color:var(--ink-2); text-transform:uppercase; letter-spacing:.06em; padding:4px 6px 8px;"><%= t("merchant.campaigns.push_pick") %></div>
            <% MemberSegments::PRESETS.each do |key, _meta| %>
              <label style="display:flex; align-items:center; gap:10px; padding:8px 6px; border-radius:9px; cursor:pointer; font-size:14px;"
                     onmouseover="this.style.background='var(--surface-2)'" onmouseout="this.style.background='transparent'">
                <input type="checkbox" name="segments[]" value="<%= key %>" <%= 'checked' if key == @campaign.audience %>
                       data-audiencepick-target="check" data-action="audiencepick#update" style="width:16px; height:16px; flex:none;">
                <span style="flex:1;"><%= MemberSegments.icon(key) %> <%= MemberSegments.label(key) %></span>
                <span style="font-size:12px; color:var(--ink-2); font-variant-numeric:tabular-nums;"><%= @counts[key] %></span>
              </label>
            <% end %>
            <button type="submit" class="l-btn l-btn-primary" data-audiencepick-target="send"
                    style="width:100%; margin-top:8px; padding:9px; font-size:13px;">
              <%= t("merchant.campaigns.push_send_prefix") %> <span data-audiencepick-target="count">1</span> <%= t("merchant.campaigns.push_send_suffix") %>
            </button>
          </div>
        <% end %>
      </div>
      <% if AiImageService.configured? %>
        <%= button_to t("merchant.campaigns.gen_banner"), generate_banner_merchant_campaign_path(@campaign), method: :patch,
              class: "l-btn l-btn-soft", style: "padding:8px 14px; font-size:13px;",
              form: { style: "display:inline; margin:0;" } %>
      <% end %>
    </div>
    <p style="font-size:12px; color:var(--ink-2); margin-top:8px;"><%= t("merchant.campaigns.share_note") %></p>
  </div>
<% end %>

<div style="display:grid; grid-template-columns:<%= @promo ? '1fr 360px' : '1fr' %>; gap:20px; align-items:start;">
  <div class="l-panel">
    <% if @campaign.banner.attached? %>
      <%= image_tag @campaign.banner.variant(resize_to_limit: [800, 400]),
            style: "width:100%; border-radius:14px; margin-bottom:14px; display:block;" %>
    <% end %>
    <h2 class="l-display" style="font-size:22px;"><%= @campaign.name %></h2>
    <% if @campaign.content_value("title").present? %>
      <p style="font-weight:600; margin-top:10px;"><%= @campaign.content_value("title") %></p>
      <p style="color:var(--ink-2); font-size:14px;"><%= @campaign.content_value("body") %></p>
    <% end %>
    <% if @campaign.reward %>
      <div class="l-ticket" style="margin-top:16px; max-width:420px;">
        <div class="stub"><div class="v"><%= @campaign.reward.value_label %></div><div class="u"><%= @campaign.reward.kind_label %></div></div>
        <div class="perf"></div>
        <div class="body"><div style="font-weight:700;"><%= @campaign.reward.display_icon %> <%= @campaign.reward.title %></div></div>
      </div>
    <% end %>
    <%# ---- Full config summary (matches what was set at creation) ---- %>
    <div style="margin-top:16px; display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:12px; padding-top:14px; border-top:1px solid var(--line);">
      <div>
        <div style="font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-2);"><%= t("merchant.campaigns.kind") %></div>
        <div style="font-weight:600; font-size:14px;"><%= @campaign.type_label %></div>
      </div>
      <div>
        <div style="font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-2);"><%= t("merchant.campaigns.audience") %></div>
        <div style="font-weight:600; font-size:14px;"><%= @campaign.audience_label %></div>
      </div>
      <div>
        <div style="font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-2);"><%= t("merchant.campaigns.time") %></div>
        <div style="font-weight:600; font-size:13.5px;"><%= @campaign.starts_at ? l(@campaign.starts_at, format: :short) : "—" %> → <%= @campaign.ends_at ? l(@campaign.ends_at, format: :short) : t("merchant.campaigns.unlimited") %></div>
      </div>
      <% if @promo %>
        <div>
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-2);"><%= t("merchant.campaigns.issued") %></div>
          <div style="font-weight:600; font-size:14px;"><%= @promo.claims_count %><%= " / #{@promo.max_claims}" if @promo.max_claims %></div>
        </div>
        <div>
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-2);"><%= t("merchant.campaigns.used") %></div>
          <div style="font-weight:600; font-size:14px;"><%= @promo.used_count %></div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @promo %>
    <div>
      <div class="l-panel" style="text-align:center;">
        <div class="l-eyebrow"><%= t("merchant.campaigns.promo_qr") %></div>
        <div style="display:inline-block; padding:14px; background:#fff; border:1px solid var(--line); border-radius:16px; margin-top:8px;">
          <%= qr_svg(@promo_url, color: "1A1A1A", size: 190) %>
        </div>
        <div class="l-mono" style="margin-top:8px; font-size:13px;"><%= @promo.token %></div>
        <%= link_to t("merchant.campaigns.download_svg"), qr_merchant_campaign_path(@campaign), class: "l-btn l-btn-soft l-btn-block", style: "margin-top:12px;", data: { turbo: false } %>
        <p style="font-size:12px; color:var(--ink-2); margin-top:8px;"><%= t("merchant.campaigns.promo_note") %></p>
      </div>

      <div class="l-panel" style="margin-top:16px;">
        <div class="l-eyebrow" style="margin-bottom:10px;"><%= t("merchant.campaigns.effectiveness") %></div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div><div class="l-num" style="font-size:26px;"><%= @promo.scan_count %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.scan_count") %></div></div>
          <div><div class="l-num" style="font-size:26px;"><%= @promo.claims_count %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.claimed") %><%= " / #{@promo.max_claims}" if @promo.max_claims %></div></div>
          <div><div class="l-num" style="font-size:26px;"><%= @promo.used_count %></div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.used") %></div></div>
          <div><div class="l-num" style="font-size:26px;"><%= @promo.use_rate %>%</div><div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.campaigns.use_rate") %></div></div>
        </div>
        <% if @promo.remaining %>
          <div style="margin-top:12px; height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden;">
            <div style="height:100%; width:<%= @promo.max_claims.zero? ? 0 : (@promo.claims_count.to_f / @promo.max_claims * 100).round %>%; background:var(--primary);"></div>
          </div>
          <div style="font-size:12px; color:var(--ink-2); margin-top:6px;"><%= t("merchant.campaigns.remaining", a: @promo.remaining, b: @promo.max_claims) %></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
