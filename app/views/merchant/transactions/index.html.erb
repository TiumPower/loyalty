<% content_for :title, t("merchant.transactions.title") %>
<% content_for :title_en, "TRANSACTIONS" %>
<% tx = ->(k, **o) { t("merchant.transactions.#{k}", **o) } %>

<%# ---- Filters ---- %>
<%= form_with url: merchant_transactions_path, method: :get, data: { turbo: false } do %>
  <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
    <input type="search" name="q" value="<%= @q %>" placeholder="<%= tx.(:search_ph) %>"
           class="l-field" style="flex:1; min-width:220px;">

    <% is_custom = @range[:key] == 'custom' %>
    <select name="range" class="l-field" style="max-width:170px;"
            onchange="var c=this.value==='custom'; this.closest('form').querySelector('[data-range-custom]').hidden=!c; if(!c){this.form.querySelector('[name=from]').value=''; this.form.querySelector('[name=to]').value=''; this.form.requestSubmit()}"
            aria-label="<%= t('merchant.dashboard.range_label') %>">
      <% %w[7d 30d 90d mtd all].each do |rk| %>
        <option value="<%= rk %>" <%= 'selected' if @range[:key] == rk %>><%= t("merchant.dashboard.range_#{rk}") %></option>
      <% end %>
      <option value="custom" <%= 'selected' if is_custom %>><%= t("merchant.dashboard.range_custom") %></option>
    </select>

    <% if @branches.present? %>
      <select name="outlet" class="l-field" style="max-width:200px;" onchange="this.form.requestSubmit()"
              aria-label="<%= t('merchant.customers.branch_filter') %>">
        <option value=""><%= t('merchant.dashboard.all_branches') %></option>
        <% @branches.each do |o| %>
          <option value="<%= o.id %>" <%= 'selected' if @outlet&.id == o.id %>><%= o.name %></option>
        <% end %>
      </select>
    <% end %>

    <select name="kind" class="l-field" style="max-width:180px;" onchange="this.form.requestSubmit()"
            aria-label="<%= tx.(:th_kind) %>">
      <option value=""><%= tx.(:all_kinds) %></option>
      <% PointTransaction::KINDS.each do |k| %>
        <option value="<%= k %>" <%= 'selected' if @kind == k %>>
          <%= PointTransaction::ICONS[k] %> <%= t("customer.tx.#{k}", default: k.humanize) %>
        </option>
      <% end %>
    </select>

    <%= submit_tag "🔍 #{t('merchant.transactions.search_btn')}", class: "l-btn l-btn-primary", style: "flex:none; padding:9px 18px;" %>
  </div>

  <%# Custom range date inputs — only shown when the preset is "Tùy chọn" %>
  <div data-range-custom <%= 'hidden' unless is_custom %> style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; align-items:center; font-size:13px; color:var(--ink-2);">
    <span><%= t('merchant.dashboard.range_from') %></span>
    <input type="date" name="from" value="<%= @range[:key] == 'custom' ? @range[:from].to_date.iso8601 : '' %>"
           class="l-field" style="width:auto; padding:6px 10px;" onchange="this.form.requestSubmit()">
    <span><%= t('merchant.dashboard.range_to') %></span>
    <input type="date" name="to" value="<%= @range[:key] == 'custom' ? @range[:to].to_date.iso8601 : '' %>"
           class="l-field" style="width:auto; padding:6px 10px;" onchange="this.form.requestSubmit()">
  </div>
<% end %>

<%# ---- Summary: the four figures the filter above resolves to ---- %>
<div class="m-metrics" style="margin-bottom:16px;">
  <div class="m-metric">
    <div class="hd"><span class="k"><%= tx.(:earned) %></span><span class="ic"><%= ui_icon(:sparkles, size: 15) %></span></div>
    <div class="row"><span class="v" style="color:var(--good);">+<%= number_with_delimiter(@earned) %></span></div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= tx.(:spent) %></span><span class="ic"><%= ui_icon(:gift, size: 15) %></span></div>
    <div class="row"><span class="v"><%= @spent.zero? ? "0" : "−#{number_with_delimiter(@spent)}" %></span></div>
  </div>
  <div class="m-metric">
    <%# Lapsed points are not redemptions — shown separately so the two are
        never read as the same number. %>
    <div class="hd"><span class="k"><%= tx.(:expired) %></span><span class="ic"><%= ui_icon(:clock, size: 15) %></span></div>
    <div class="row"><span class="v" style="color:var(--ink-2);"><%= @expired.to_i.zero? ? "0" : "−#{number_with_delimiter(@expired)}" %></span></div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= tx.(:total) %></span><span class="ic"><%= ui_icon(:receipt, size: 15) %></span></div>
    <div class="row"><span class="v"><%= number_with_delimiter(@total) %></span><span class="m-badge"><%= @range[:label] %></span></div>
  </div>
</div>

<%# ---- Ledger: one row per point movement, with the bill behind it ---- %>
<div class="l-panel">
  <div style="overflow-x:auto;">
    <table class="m-table" style="min-width:920px;">
      <thead>
        <tr>
          <th><%= tx.(:th_transaction) %></th>
          <th><%= tx.(:th_customer) %></th>
          <th><%= tx.(:th_branch) %></th>
          <th><%= tx.(:th_amount_bill) %></th>
          <th><%= tx.(:th_points) %></th>
          <th><%= tx.(:th_status) %></th>
          <th><%= tx.(:th_staff) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @transactions.each do |t| %>
          <% bill = @purchases[t.source_id] if t.source_type == "Purchase" %>
          <tr>
            <td>
              <div style="font-weight:600; white-space:nowrap;"><%= t.icon %> <%= t("customer.tx.#{t.kind}", default: t.kind.humanize) %></div>
              <div style="font-size:12px; color:var(--ink-2); white-space:nowrap;"><%= l(t.created_at, format: :short) %></div>
            </td>
            <td>
              <%= link_to t.member.display_name, merchant_customer_path(t.member),
                    style: "font-weight:600; color:var(--primary-ink); text-decoration:none;" %>
              <% if t.note.present? && bill.nil? %>
                <div style="font-size:12px; color:var(--ink-2);"><%= t.note %></div>
              <% end %>
            </td>
            <td style="color:var(--ink-2);"><%= t.outlet&.name || tx.(:no_branch) %></td>
            <td class="m-num"><%= bill ? "#{number_with_delimiter(bill.amount)}đ" : "—" %></td>
            <td class="m-num" style="color:<%= t.credit? ? 'var(--good)' : 'var(--warn)' %>;">
              <%= t.credit? ? "+" : "−" %><%= number_with_delimiter(t.amount.abs) %>
            </td>
            <td>
              <% if bill&.voided? %>
                <span class="m-badge down"><%= tx.(:voided_flag) %></span>
              <% else %>
                <span class="m-badge up"><%= tx.(:posted_flag) %></span>
              <% end %>
            </td>
            <td style="color:var(--ink-2);"><%= t.staff&.name || "—" %></td>
            <%# Undo a mis-keyed bill — only on an earn row that is still posted. %>
            <td style="white-space:nowrap;">
              <% if bill && !bill.voided? && bill.voidable_by?(current_user, current_membership) %>
                <%= link_to tx.(:undo), merchant_confirm_void_purchase_path(bill),
                      class: "l-btn l-btn-ghost", style: "padding:4px 12px; font-size:12px;" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @transactions.empty? %>
          <tr><td colspan="8" style="padding:24px; text-align:center; color:var(--ink-2);"><%= tx.(:empty) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ---- Pagination ---- %>
  <% if @page > 1 || @has_more %>
    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:14px; padding-top:12px; border-top:1px solid var(--line);">
      <% if @page > 1 %>
        <%= link_to tx.(:prev), merchant_transactions_path(request.query_parameters.merge(page: @page - 1)), class: "l-btn l-btn-soft" %>
      <% else %><span></span><% end %>
      <span style="font-size:13px; color:var(--ink-2);"><%= tx.(:page, n: @page) %></span>
      <% if @has_more %>
        <%= link_to tx.(:next), merchant_transactions_path(request.query_parameters.merge(page: @page + 1)), class: "l-btn l-btn-soft" %>
      <% else %><span></span><% end %>
    </div>
  <% end %>
</div>

<p style="font-size:12.5px; color:var(--ink-2); line-height:1.55; margin-top:14px;">
  <%= tx.(:safeguard_note) %>
</p>
