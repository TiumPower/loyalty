<%= turbo_frame_tag "scan_tool" do %>
  <% mult = (current_program.tiers_enabled ? (@member.tier&.multiplier || 1) : 1).to_f %>
  <% if @error %>
    <div class="l-chip" style="background:#F3DDD7; color:#B4402F; margin-bottom:14px;">⚠ <%= @error %></div>
  <% end %>

  <%# ---- Customer profile ---- %>
  <div style="display:flex; align-items:center; gap:14px; padding:6px 0 16px; border-bottom:1px solid var(--line);">
    <div style="width:52px; height:52px; border-radius:16px; background:<%= @member.tier&.gradient_css || 'var(--primary)' %>; color:#fff; display:grid; place-items:center; font-weight:700; font-family:var(--font-display); font-size:20px;">
      <%= @member.initials %>
    </div>
    <div style="flex:1; min-width:0;">
      <div style="font-weight:700; font-size:17px;"><%= @member.display_name %></div>
      <div style="color:var(--ink-2); font-size:13px;"><%= @member.email.presence || @member.phone %></div>
    </div>
    <div style="text-align:right;">
      <div class="l-chip l-chip-brand"><%= @member.tier&.name || "—" %></div>
      <div class="l-num" style="font-size:20px; margin-top:4px;"><%= number_with_delimiter(@member.points_balance) %></div>
    </div>
  </div>

  <%# ---- Bill amount → points ---- %>
  <%= form_with url: merchant_earn_path, method: :post,
        data: { controller: "earn-calc",
                earn_calc_points_value: current_program.earn_points,
                earn_calc_per_value: current_program.earn_per_amount,
                earn_calc_mult_value: mult } do %>
    <input type="hidden" name="member_id" value="<%= @member.id %>">
    <input type="hidden" name="earn_key" value="<%= @earn_key %>">
    <label class="l-label" style="margin-top:16px;"><%= t("merchant.scan.bill_amount") %></label>
    <div style="display:flex; align-items:center; gap:8px;">
      <input name="amount" inputmode="numeric" autofocus autocomplete="off"
             class="l-field" style="font-size:26px; font-family:var(--font-display); text-align:right;"
             placeholder="0" data-earn-calc-target="amount" data-action="input->earn-calc#preview">
      <span style="color:var(--ink-2); font-weight:600;"><%= current_program.currency %></span>
    </div>

    <div style="margin-top:14px; padding:14px; border-radius:14px; background:var(--surface-2); display:flex; align-items:center; justify-content:space-between;">
      <span style="color:var(--ink-2);"><%= t("merchant.scan.points_to_add") %><% if mult > 1 %> <span class="l-chip l-chip-brand" style="margin-left:4px;">×<%= mult %></span><% end %></span>
      <span class="l-num" style="font-size:28px; color:var(--primary-ink);">+<span data-earn-calc-target="preview">0</span></span>
    </div>

    <div style="display:flex; gap:10px; margin-top:16px;">
      <%= link_to t("merchant.scan.cancel"), merchant_scanner_path, class: "l-btn l-btn-ghost", data: { turbo_frame: "scan_tool" } %>
      <%= submit_tag t("merchant.scan.confirm_earn"), class: "l-btn l-btn-primary", style: "flex:1;" %>
    </div>
  <% end %>
<% end %>
