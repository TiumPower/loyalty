<% if local_assigns[:error] || @error %>
  <div class="l-chip" style="background:#F3DDD7; color:#B4402F; margin-bottom:14px;">⚠ <%= @error %></div>
<% end %>

<div data-controller="scanner">
  <div style="position:relative; aspect-ratio:1; border-radius:16px; overflow:hidden; background:#111; display:grid; place-items:center;">
    <video data-scanner-target="video" playsinline muted style="width:100%; height:100%; object-fit:cover;"></video>
    <div data-scanner-target="overlay" style="position:absolute; inset:0; color:#fff;">
      <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:66%; max-width:240px; display:flex; flex-direction:column; align-items:center; gap:10px; text-align:center; overflow-wrap:anywhere;">
        <div style="font-size:40px; line-height:1;">⧉</div>
        <p style="font-size:13px; opacity:.85; margin:0;"><%= t("merchant.scan.earn_prompt") %></p>
        <button type="button" class="l-btn l-btn-primary" data-action="scanner#start"><%= t("merchant.scan.start_camera") %></button>
      </div>
    </div>
    <div style="position:absolute; inset:12%; border:3px solid rgba(255,255,255,.7); border-radius:16px; pointer-events:none;"></div>
  </div>
  <p data-scanner-target="status" style="text-align:center; color:var(--ink-2); font-size:12px; margin-top:8px;"></p>

  <%= form_with url: merchant_earn_lookup_path, method: :post, data: { scanner_target: "form" } do %>
    <input type="hidden" name="token" data-scanner-target="token">
  <% end %>
</div>

<div style="display:flex; align-items:center; gap:10px; margin:16px 0; color:var(--ink-2); font-size:13px;">
  <span style="flex:1; height:1px; background:var(--line);"></span> <%= t("merchant.scan.or_manual") %> <span style="flex:1; height:1px; background:var(--line);"></span>
</div>

<%= form_with url: merchant_earn_lookup_path, method: :post do %>
  <div style="display:flex; gap:8px;">
    <input name="q" type="text" inputmode="email" class="l-field"
           placeholder="<%= t("merchant.scan.lookup_ph") %>" autocomplete="off">
    <%= submit_tag t("merchant.scan.find_customer"), class: "l-btn l-btn-primary", style: "white-space:nowrap;" %>
  </div>
<% end %>
