<% content_for :title, t("merchant.nav.program") %>
<% content_for :title_en, "LOYALTY PROGRAM" %>

<%= form_with model: @program, url: merchant_loyalty_program_path, method: :patch do |f| %>
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; max-width:900px;">
    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:6px;"><%= t("merchant.program.mechanisms") %></h3>
      <p style="color:var(--ink-2); font-size:13px; margin-bottom:8px;"><%= t("merchant.program.mechanisms_note") %></p>
      <% [[:points_enabled, t("merchant.program.m_points")], [:tiers_enabled, t("merchant.program.m_tiers")], [:stamps_enabled, t("merchant.program.m_stamps")], [:gamification_enabled, t("merchant.program.m_gami")]].each do |attr, label| %>
        <div class="l-toggle-row">
          <span><%= label %></span>
          <label class="l-switch"><%= f.check_box attr %><span class="knob"></span></label>
        </div>
      <% end %>
    </div>

    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:6px;"><%= t("merchant.program.earn") %></h3>
      <label class="l-label"><%= t("merchant.program.earn_per") %></label>
      <%# The three fields are fixed-width and this panel sits in a two-column
          grid, so they used to spill out of it on a laptop. %>
      <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
        <%= f.number_field :earn_points, class: "l-field", style: "max-width:100px;", min: 0 %>
        <span style="color:var(--ink-2);"><%= t("merchant.program.points_slash") %></span>
        <%= f.number_field :earn_per_amount, class: "l-field", style: "max-width:140px;", min: 1 %>
        <%= f.text_field :currency, class: "l-field", style: "max-width:80px;" %>
      </div>
      <%# This setting decides how much the shop gives away, but it was three
          bare numbers. Spell out what the saved rate actually does. %>
      <% if @program.earn_per_amount.to_i.positive? %>
        <% sample = 100_000 %>
        <div style="font-size:12.5px; color:var(--ink-2); background:var(--surface-2,#F4ECE3); border-radius:10px; padding:9px 12px; margin-bottom:14px;">
          Đang áp dụng: hoá đơn <strong><%= number_with_delimiter(sample) %><%= @program.currency == "VND" ? "đ" : " #{@program.currency}" %></strong>
          → <strong><%= number_with_delimiter((sample / @program.earn_per_amount.to_i) * @program.earn_points.to_i) %> điểm</strong>
          <span style="opacity:.75;">(chưa tính hệ số hạng)</span>
        </div>
      <% end %>

      <label class="l-label"><%= t("merchant.program.expiry") %></label>
      <div style="display:flex; gap:8px; align-items:center; margin-bottom:14px;">
        <%= f.number_field :points_expiry_months, class: "l-field", style: "max-width:100px;", min: 0 %>
        <span style="color:var(--ink-2); font-size:13px;"><%= t("merchant.program.expiry_note") %></span>
      </div>

      <label class="l-label"><%= t("merchant.program.tier_cycle") %></label>
      <%= f.number_field :tier_cycle_months, class: "l-field", style: "max-width:120px;" %>
    </div>
  </div>

  <%= f.submit t("merchant.program.save"), class: "l-btn l-btn-primary", style: "margin-top:18px;" %>
<% end %>

<%# ---- Membership tiers config ---- %>
<% if @tiers.present? %>
  <div class="l-panel" style="max-width:900px; margin-top:20px;">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= t("merchant.tiers.title") %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px;"><%= t("merchant.tiers.note") %></p>
    <%= form_with url: merchant_tiers_path, method: :patch do %>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:separate; border-spacing:0 12px; font-size:13.5px; min-width:560px;">
          <thead><tr style="text-align:left; color:var(--ink-2); font-size:11px; text-transform:uppercase; letter-spacing:.05em;">
            <th style="padding:6px 8px;"><%= t("merchant.tiers.th_tier") %></th>
            <th><%= t("merchant.tiers.th_name") %></th>
            <th><%= t("merchant.tiers.th_threshold") %></th>
            <th><%= t("merchant.tiers.th_multiplier") %></th>
            <th><%= t("merchant.tiers.th_benefits") %></th>
            <th><%= t("merchant.tiers.th_colors") %></th>
          </tr></thead>
          <tbody>
            <% @tiers.each do |tier| %>
              <tr>
                <td style="padding:9px 8px;"><span style="display:inline-block; width:22px; height:22px; border-radius:6px; background:<%= tier.gradient_css %>; vertical-align:middle;"></span></td>
                <td><input type="text" name="tiers[<%= tier.id %>][name]" value="<%= tier.name %>" class="l-field" style="min-width:120px;"></td>
                <td><input type="number" name="tiers[<%= tier.id %>][threshold_points]" value="<%= tier.threshold_points %>" class="l-field" style="max-width:110px;" min="0"></td>
                <td><input type="number" step="0.1" name="tiers[<%= tier.id %>][multiplier]" value="<%= tier.multiplier %>" class="l-field" style="max-width:80px;" min="1"></td>
                <td>
                  <% effective = Array(tier.benefits).presence || default_benefits(tier) %>
                  <textarea name="tiers[<%= tier.id %>][benefits]" class="l-field" rows="3"
                            style="min-width:220px; resize:vertical; line-height:1.5;"
                            placeholder="<%= t('merchant.tiers.benefits_ph') %>"><%= effective.join("\n") %></textarea>
                </td>
                <td style="white-space:nowrap;">
                  <input type="color" name="tiers[<%= tier.id %>][gradient_from]" value="<%= tier.gradient_from.presence || '#B08D57' %>" style="width:34px; height:32px; border:1px solid var(--line); border-radius:8px; padding:2px; vertical-align:middle;">
                  <input type="color" name="tiers[<%= tier.id %>][gradient_to]" value="<%= tier.gradient_to.presence || '#7A5C3A' %>" style="width:34px; height:32px; border:1px solid var(--line); border-radius:8px; padding:2px; vertical-align:middle;">
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p style="color:var(--ink-2); font-size:12px; margin:10px 0;"><%= t("merchant.tiers.multiplier_hint") %></p>
      <%= submit_tag t("merchant.tiers.save"), class: "l-btn l-btn-primary" %>
    <% end %>
  </div>
<% end %>
