<% content_for :title, t("merchant.nav.program") %>
<% content_for :title_en, "LOYALTY PROGRAM" %>

<%# A refused save re-rendered this page with nothing to show for it, so a
    rejected value simply looked like a save that did nothing. %>
<% if @program.errors.any? %>
  <div style="background:#F7E0DA; color:#B4402F; border-radius:12px; padding:11px 14px; font-size:14px; margin-bottom:16px; max-width:900px;">
    <%= @program.errors.full_messages.to_sentence %>
  </div>
<% end %>

<%= form_with model: @program, url: merchant_loyalty_program_path, method: :patch do |f| %>
  <%# Two fixed 1fr columns squeezed the right-hand panel to 137px on a phone —
      narrower than the earn-rate fields inside it. auto-fit drops to one column
      instead (same idiom as the retention panel). %>
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px; max-width:900px;">
    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:6px;"><%= t("merchant.program.mechanisms") %></h3>
      <p style="color:var(--ink-2); font-size:13px; margin-bottom:8px;"><%= t("merchant.program.mechanisms_note") %></p>
      <%# Mechanisms the plan doesn't include were accepted by the form and then
          forced back off on save, so the merchant got "Đã lưu" and a toggle that
          had flipped itself back with no explanation. Show the lock instead. %>
      <% [[:points_enabled, t("merchant.program.m_points"), nil],
          [:tiers_enabled, t("merchant.program.m_tiers"), nil],
          [:stamps_enabled, t("merchant.program.m_stamps"), :stamps],
          [:gamification_enabled, t("merchant.program.m_gami"), :gamification]].each do |attr, label, feature| %>
        <% locked = feature && feature_locked?(feature) %>
        <div class="l-toggle-row">
          <span>
            <%= label %>
            <% if locked %>
              <%= link_to t("merchant.program.plan_locked"), merchant_billing_path,
                          style: "font-size:11px; color:var(--ink-2); text-decoration:underline; margin-left:6px; white-space:nowrap;" %>
            <% end %>
          </span>
          <%# A locked mechanism is off whatever the stored flag says (every
              screen behind it is gated on the plan, not the flag), so don't
              draw it as on. %>
          <% opts = { disabled: locked } %>
          <% opts[:checked] = false if locked %>
          <label class="l-switch" style="<%= 'opacity:.45; cursor:not-allowed;' if locked %>">
            <%= f.check_box attr, opts %><span class="knob"></span>
          </label>
        </div>
      <% end %>
    </div>

    <div class="l-panel">
      <h3 class="l-display" style="font-size:18px; margin-bottom:6px;"><%= t("merchant.program.earn") %></h3>
      <label class="l-label"><%= t("merchant.program.earn_per") %></label>
      <%# The three fields are fixed-width and this panel sits in a two-column
          grid, so they used to spill out of it on a laptop. %>
      <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
        <%= f.number_field :earn_points, class: "l-field", style: "max-width:100px;", min: 1, max: LoyaltyProgram::MAX_EARN_POINTS %>
        <span style="color:var(--ink-2);"><%= t("merchant.program.points_slash") %></span>
        <%= f.number_field :earn_per_amount, class: "l-field", style: "max-width:140px;", min: 1, max: LoyaltyProgram::MAX_EARN_PER %>
        <%= f.text_field :currency, class: "l-field", style: "max-width:80px; text-transform:uppercase;", maxlength: 3, pattern: "[A-Za-z]{3}" %>
      </div>
      <%# This setting decides how much the shop gives away, but it was three
          bare numbers. Spell out what the saved rate actually does. %>
      <% if @program.earn_per_amount.to_i.positive? %>
        <% sample = 100_000 %>
        <div style="font-size:12.5px; color:var(--ink-2); background:var(--surface-2,#F4ECE3); border-radius:10px; padding:9px 12px; margin-bottom:14px;">
          Đang áp dụng: hoá đơn <strong><%= number_with_delimiter(sample) %><%= @program.currency == "VND" ? "đ" : " #{@program.currency}" %></strong>
          → <strong><%= number_with_delimiter((sample / @program.earn_per_amount.to_i) * @program.earn_points.to_i) %> điểm</strong>
          <span style="opacity:.75;">(chưa tính hệ số hạng)</span>
        </div>
      <% end %>

      <label class="l-label"><%= t("merchant.program.expiry") %></label>
      <div style="display:flex; gap:8px; align-items:center; margin-bottom:14px;">
        <%= f.number_field :points_expiry_months, class: "l-field", style: "max-width:100px;", min: 0, max: LoyaltyProgram::MAX_MONTHS %>
        <span style="color:var(--ink-2); font-size:13px;"><%= t("merchant.program.expiry_note") %></span>
      </div>

      <label class="l-label"><%= t("merchant.program.tier_cycle") %></label>
      <%# 0 here used to reset every customer to the bottom tier. %>
      <%= f.number_field :tier_cycle_months, class: "l-field", style: "max-width:120px;", min: 1, max: LoyaltyProgram::MAX_MONTHS %>
      <p style="font-size:12.5px; color:var(--ink-2); margin-top:6px;">
        <%= t("merchant.program.tier_cycle_note", n: @program.cycle_months) %>
      </p>
    </div>
  </div>

  <%= f.submit t("merchant.program.save"), class: "l-btn l-btn-primary", style: "margin-top:18px;" %>
<% end %>

