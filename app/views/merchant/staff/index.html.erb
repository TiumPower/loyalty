<% content_for :title, t("merchant.staff.title") %>
<% content_for :title_en, "STAFF" %>
<% s = ->(k, **a) { t("merchant.staff.#{k}", **a) } %>
<% manage = current_membership&.can_manage? %>
<%# The workspace must always keep one owner. Show that up front rather than
    letting the controller bounce the change after the fact. %>
<% sole_owner_id = (owners = current_workspace.memberships.select(&:owner?)).one? ? owners.first.id : nil %>

<div data-controller="modal">
  <div class="m-sec">
    <div>
      <h3><%= s.(:team) %></h3>
      <div class="sub"><%= s.(:team_sub) %></div>
    </div>
    <% if manage %>
      <button type="button" class="l-btn l-btn-primary" data-action="modal#open">＋ <%= s.(:invite) %></button>
    <% end %>
  </div>

  <div class="m-summary" style="margin-bottom:16px;">
    <div>
      <div class="v"><%= @total_count %></div>
      <div class="k"><%= s.(:sum_people) %></div>
      <div class="d"><%= s.(:sum_people_hint) %></div>
    </div>
    <div>
      <div class="v"><%= @all_roles.values_at("owner", "manager").compact.sum %></div>
      <div class="k"><%= s.(:sum_managers) %></div>
      <div class="d"><%= s.(:sum_managers_hint) %></div>
    </div>
    <div>
      <div class="v"><%= @all_roles.values_at("staff", "cashier").compact.sum %></div>
      <div class="k"><%= s.(:sum_counter) %></div>
      <div class="d"><%= s.(:sum_counter_hint) %></div>
    </div>
    <div>
      <div class="v"><%= @unassigned %></div>
      <div class="k"><%= s.(:sum_unassigned) %></div>
      <div class="d"><%= s.(:sum_unassigned_hint) %></div>
    </div>
  </div>

  <div class="l-panel" style="padding:0; overflow:hidden;">
    <%= form_with url: merchant_staff_index_path, method: :get, data: { turbo: false } do %>
      <div class="m-filters">
        <input type="search" name="q" value="<%= @q %>" class="l-field grow"
               placeholder="<%= s.(:search_ph) %>" aria-label="<%= s.(:search_ph) %>">
        <select name="role" class="l-field" onchange="this.form.requestSubmit()" aria-label="<%= s.(:role) %>">
          <option value=""><%= s.(:filter_role_all) %></option>
          <% Membership::ROLES.each do |r| %>
            <option value="<%= r %>" <%= "selected" if @role == r %>><%= t("merchant.roles.#{r}") %></option>
          <% end %>
        </select>
        <%= submit_tag s.(:search_btn), class: "l-btn l-btn-soft", style: "flex:none; padding:9px 16px; font-size:13.5px;" %>
      </div>
    <% end %>

    <% if @memberships.empty? %>
      <div style="padding:40px 20px; text-align:center; color:var(--ink-2); font-size:14px;">
        <%= s.(:none_match) %>
        <%= link_to s.(:clear_filters), merchant_staff_index_path, style: "color:var(--primary); font-weight:600; text-decoration:none;" if @filtered %>
      </div>
    <% else %>
      <div style="overflow-x:auto;">
        <table class="m-table" style="min-width:820px;">
          <thead>
            <tr>
              <th style="padding-left:18px;"><%= s.(:col_person) %></th>
              <th><%= s.(:col_role) %></th>
              <th><%= s.(:col_access) %></th>
              <th style="padding-right:18px;"><%= s.(:col_actions) %></th>
            </tr>
          </thead>
          <tbody>
            <% @memberships.each do |m| %>
              <% locked = m.id == sole_owner_id %>
              <tr>
                <td style="padding-left:18px;">
                  <div class="m-who">
                    <span class="av"><%= m.user.initials %></span>
                    <div style="min-width:0;">
                      <div class="nm"><%= m.user.name %></div>
                      <div class="sub"><%= m.user.email %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <% if manage && !locked %>
                    <%= form_with url: merchant_staff_path(m), method: :patch, style: "margin:0;" do %>
                      <select name="role" class="l-field" style="padding:6px 10px; font-size:13px; max-width:150px;"
                              onchange="this.form.requestSubmit()">
                        <% Membership::ROLES.each do |r| %>
                          <option value="<%= r %>" <%= "selected" if m.role == r %>><%= t("merchant.roles.#{r}") %></option>
                        <% end %>
                      </select>
                    <% end %>
                  <% else %>
                    <span class="m-badge <%= 'up' if m.admin? %>"><%= m.label %></span>
                  <% end %>
                </td>
                <td style="font-size:12.5px;">
                  <% if m.outlet %>
                    <div><%= m.outlet.name %></div>
                    <div style="color:var(--ink-2); margin-top:2px;"><%= s.(:access_one_outlet) %></div>
                  <% else %>
                    <div><%= s.(:access_all) %></div>
                    <div style="color:var(--ink-2); margin-top:2px;"><%= s.(:access_all_hint) %></div>
                  <% end %>
                </td>
                <td style="padding-right:18px;">
                  <% if locked %>
                    <span title="<%= s.(:sole_owner_hint) %>"
                          style="display:inline-flex; align-items:center; gap:6px; font-size:11.5px; color:var(--ink-2); background:var(--surface-2); border-radius:999px; padding:5px 10px; white-space:nowrap;">
                      <%= ui_icon(:lock, size: 13) %><%= s.(:sole_owner_badge) %>
                    </span>
                  <% elsif manage %>
                    <div class="m-rowact">
                      <%= button_to merchant_staff_path(m), method: :delete, class: "danger",
                            form: { data: { turbo_confirm: s.(:remove_confirm) } },
                            title: s.(:remove), "aria-label": s.(:remove) do %>
                        <%= ui_icon(:trash, size: 16) %>
                      <% end %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div style="padding:12px 18px; border-top:1px solid var(--line-soft); font-size:12.5px; color:var(--ink-2);">
        <%= s.(:footer_count, shown: @memberships.size, total: @total_count) %>
      </div>
    <% end %>
  </div>

  <%# What each role may actually do — otherwise the picker above is a guess. %>
  <div class="l-panel" style="margin-top:16px;">
    <div class="m-sec" style="margin-bottom:8px;">
      <div>
        <h3 style="font-size:16px;"><%= s.(:perms_title) %></h3>
        <div class="sub"><%= s.(:perms_sub) %></div>
      </div>
    </div>
    <% Membership::ROLES.each do |r| %>
      <div class="m-role">
        <span class="dot" style="background:<%= %w[owner manager].include?(r) ? 'var(--primary)' : 'var(--ink-2)' %>;"></span>
        <div style="flex:1; min-width:0;">
          <div class="nm"><%= t("merchant.roles.#{r}") %></div>
          <div class="ds"><%= s.("perm_#{r}") %></div>
        </div>
      </div>
    <% end %>
    <div class="l-note" style="margin-top:14px;">
      <%= ui_icon(:shield, size: 16) %><span><%= s.(:sole_owner_hint) %></span>
    </div>
  </div>

  <% if manage %>
    <dialog class="l-modal" data-modal-target="dialog" data-action="click->modal#backdrop">
      <div class="l-modal-card">
        <div class="l-modal-head">
          <h3 class="l-display" style="font-size:19px; margin:0;"><%= s.(:invite) %></h3>
          <button type="button" class="l-modal-x" data-action="modal#close" aria-label="<%= t("merchant.campaigns.ed_cancel") %>">✕</button>
        </div>
        <%= form_with url: merchant_staff_index_path, method: :post do %>
          <label class="l-label"><%= s.(:email) %></label>
          <%= email_field_tag :email, nil, class: "l-field", placeholder: s.(:email_ph) %>
          <label class="l-label" style="margin-top:12px;"><%= s.(:name) %></label>
          <%= text_field_tag :name, nil, class: "l-field", placeholder: s.(:name_ph) %>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
            <div>
              <label class="l-label"><%= s.(:role) %></label>
              <%= select_tag :role, options_for_select([[t("merchant.roles.cashier"), "cashier"], [t("merchant.roles.staff"), "staff"], [t("merchant.roles.manager"), "manager"]], "staff"), class: "l-field" %>
            </div>
            <div>
              <label class="l-label"><%= s.(:branch) %></label>
              <%= select_tag :outlet_id, options_from_collection_for_select(@outlets, :id, :name), include_blank: "—", class: "l-field" %>
            </div>
          </div>
          <p style="font-size:12px; color:var(--ink-2); margin-top:10px; line-height:1.5;"><%= s.(:note_html).html_safe %></p>
          <div style="display:flex; gap:10px; margin-top:16px;">
            <%= submit_tag s.(:send_invite), class: "l-btn l-btn-primary" %>
            <button type="button" class="l-btn l-btn-ghost" data-action="modal#close"><%= t("merchant.campaigns.ed_cancel") %></button>
          </div>
        <% end %>
      </div>
    </dialog>
  <% end %>
</div>
