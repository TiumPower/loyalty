<% content_for :title, t("merchant.staff.title") %>
<% content_for :title_en, "STAFF" %>

<div class="l-work">
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;"><%= t("merchant.staff.team") %></h3>
    <%# The workspace must always keep one owner. Show that up front rather than
        letting the controller bounce the change after the fact. %>
    <% sole_owner_id = (owners = @memberships.select(&:owner?)).one? ? owners.first.id : nil %>
    <% @memberships.each do |m| %>
      <% locked = m.id == sole_owner_id %>
      <div style="display:flex; align-items:center; gap:12px; padding:12px 0; border-top:1px solid var(--line);">
        <div class="l-avatar" style="width:38px; height:38px; border-radius:11px; background:var(--surface-2); display:grid; place-items:center; font-weight:600;"><%= m.user.initials %></div>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:600;"><%= m.user.name %></div>
          <div style="font-size:12px; color:var(--ink-2);"><%= m.user.email %><%= " · #{m.outlet.name}" if m.outlet %></div>
        </div>
        <%= form_with url: merchant_staff_path(m), method: :patch, style: "display:flex; gap:6px;" do %>
          <select name="role" class="l-field" style="padding:6px 10px; font-size:13px;"
                  onchange="this.form.requestSubmit()" <%= "disabled" if locked %>
                  title="<%= t("merchant.staff.sole_owner_hint") if locked %>">
            <% Membership::ROLES.each do |r| %>
              <option value="<%= r %>" <%= "selected" if m.role == r %>><%= { "owner" => t("merchant.roles.owner"), "manager" => t("merchant.roles.manager"), "staff" => t("merchant.roles.staff"), "cashier" => t("merchant.roles.cashier") }[r] %></option>
            <% end %>
          </select>
        <% end %>
        <% if locked %>
          <span title="<%= t("merchant.staff.sole_owner_hint") %>"
                style="font-size:11px; color:var(--ink-2); background:var(--surface-2,#F4ECE3); border-radius:999px; padding:5px 10px; white-space:nowrap;">
            <%= t("merchant.staff.sole_owner_badge") %>
          </span>
        <% else %>
          <%= button_to "✕", merchant_staff_path(m), method: :delete, class: "l-btn l-btn-ghost", style: "padding:6px 10px;", form: { data: { turbo_confirm: t("merchant.staff.remove_confirm") } } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="l-panel" style="position:sticky; top:90px;">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;"><%= t("merchant.staff.invite") %></h3>
    <%= form_with url: merchant_staff_index_path, method: :post do %>
      <label class="l-label"><%= t("merchant.staff.email") %></label>
      <%= email_field_tag :email, nil, class: "l-field", placeholder: t("merchant.staff.email_ph") %>
      <label class="l-label" style="margin-top:12px;"><%= t("merchant.staff.name") %></label>
      <%= text_field_tag :name, nil, class: "l-field", placeholder: t("merchant.staff.name_ph") %>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
        <div>
          <label class="l-label"><%= t("merchant.staff.role") %></label>
          <%= select_tag :role, options_for_select([[t("merchant.roles.cashier"), "cashier"], [t("merchant.roles.staff"), "staff"], [t("merchant.roles.manager"), "manager"]], "staff"), class: "l-field" %>
        </div>
        <div>
          <label class="l-label"><%= t("merchant.staff.branch") %></label>
          <%= select_tag :outlet_id, options_from_collection_for_select(@outlets, :id, :name), include_blank: "—", class: "l-field" %>
        </div>
      </div>
      <%= submit_tag t("merchant.staff.send_invite"), class: "l-btn l-btn-primary", style: "margin-top:14px;" %>
    <% end %>
    <p style="font-size:12px; color:var(--ink-2); margin-top:10px;"><%= t("merchant.staff.note_html").html_safe %></p>
  </div>
</div>
