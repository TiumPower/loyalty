<% content_for :title, t("merchant.nav.dashboard") %>
<% content_for :title_en, "DASHBOARD" %>
<% d = ->(k, **o) { t("merchant.dashboard.#{k}", **o) } %>

<%# ---- Unified filter bar: date-range + branch scope in one panel/form ---- %>
<% if @range || @branches.present? %>
  <style>
    .flt-bar{display:flex; align-items:flex-end; gap:14px 22px; flex-wrap:wrap; margin:0;}
    .flt-grp{display:flex; flex-direction:column; gap:6px;}
    .flt-lbl{font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-2); font-weight:700;}
    .flt-row{display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
    .flt-row .sep{color:var(--ink-2); font-size:13px;}
    .flt-divider{align-self:stretch; width:1px; background:var(--line); margin:2px 0;}
    @media (max-width:640px){ .flt-divider{display:none;} }
  </style>
  <div class="l-panel" style="margin-bottom:16px;">
    <%= form_with url: merchant_root_path, method: :get, data: { turbo: false }, class: "flt-bar" do %>
      <% if @range %>
        <div class="flt-grp">
          <span class="flt-lbl"><%= d.(:range_label) %></span>
          <% is_custom = @range[:key] == 'custom' %>
          <div class="flt-row">
            <select name="range" class="l-field" style="width:auto; padding:8px 12px;"
                    onchange="var c=this.value==='custom'; this.closest('form').querySelector('[data-range-custom]').hidden=!c; if(!c){this.form.querySelector('[name=from]').value=''; this.form.querySelector('[name=to]').value=''; this.form.requestSubmit()}"
                    aria-label="<%= d.(:range_label) %>">
              <% %w[7d 30d 90d mtd all].each do |rk| %>
                <option value="<%= rk %>" <%= 'selected' if @range[:key] == rk %>><%= d.("range_#{rk}") %></option>
              <% end %>
              <option value="custom" <%= 'selected' if is_custom %>><%= d.(:range_custom) %></option>
            </select>
            <span data-range-custom <%= 'hidden' unless is_custom %> style="display:inline-flex; align-items:center; gap:8px;">
              <span class="sep"><%= d.(:range_from) %></span>
              <input type="date" name="from" value="<%= is_custom ? @range[:from].to_date.iso8601 : '' %>"
                     class="l-field" style="width:auto; padding:6px 10px;" onchange="this.form.requestSubmit()" aria-label="<%= d.(:range_from) %>">
              <span class="sep"><%= d.(:range_to) %></span>
              <input type="date" name="to" value="<%= is_custom ? @range[:to].to_date.iso8601 : '' %>"
                     class="l-field" style="width:auto; padding:6px 10px;" onchange="this.form.requestSubmit()" aria-label="<%= d.(:range_to) %>">
            </span>
          </div>
        </div>
      <% end %>

      <% if @range && @branches.present? %><div class="flt-divider"></div><% end %>

      <% if @branches.present? %>
        <div class="flt-grp">
          <span class="flt-lbl"><%= d.(:view_scope) %></span>
          <div class="flt-row">
            <select name="outlet" class="l-field" style="max-width:300px; padding:8px 12px;" onchange="this.form.requestSubmit()">
              <option value="" <%= 'selected' unless @branch %>><%= d.(:all_branches) %></option>
              <% @branches.each do |o| %>
                <option value="<%= o.id %>" <%= 'selected' if @branch&.id == o.id %>><%= o.name %></option>
              <% end %>
            </select>
          </div>
        </div>
      <% else %>
        <input type="hidden" name="outlet" value="<%= params[:outlet] %>">
      <% end %>

      <% if @range %>
        <div style="flex-basis:100%; font-size:12px; color:var(--ink-2); margin-top:2px;"><%= d.(:range_note) %> · <strong><%= @range[:label] %></strong></div>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @branch %>
  <%# ---- Branch-scoped dashboard ---- %>
  <div class="l-panel" style="margin-bottom:16px;">
    <div class="l-eyebrow"><%= d.(:branch) %></div>
    <div class="l-display" style="font-size:22px;"><%= @branch.name %></div>
    <p style="color:var(--ink-2); font-size:13px;"><%= d.(:branch_note) %></p>
  </div>
  <div class="l-kpis">
    <div class="l-kpi"><div class="k"><%= d.(:revenue) %></div><div class="v"><%= number_with_delimiter(@revenue) %>đ</div><div class="d"><%= d.(:transactions, n: @purchases_count) %></div></div>
    <div class="l-kpi"><div class="k"><%= d.(:points_issued) %></div><div class="v"><%= number_with_delimiter(@points_issued) %></div></div>
    <div class="l-kpi"><div class="k"><%= d.(:visited) %></div><div class="v"><%= number_with_delimiter(@members_count) %></div></div>
    <div class="l-kpi"><div class="k"><%= d.(:vouchers_used) %></div><div class="v"><%= number_with_delimiter(@vouchers_used) %></div></div>
  </div>
  <%= render "merchant/dashboard/retention", r: @retention, d: d %>
  <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap;">
    <%= link_to merchant_scanner_path, class: "l-btn l-btn-primary" do %><%= ui_icon(:scan, size: 16) %> <%= t("merchant.nav.scanner") %><% end %>
    <%= link_to merchant_customers_path, class: "l-btn l-btn-soft" do %><%= ui_icon(:users, size: 16) %> <%= t("merchant.nav.customers") %><% end %>
  </div>
<% else %>

<% if @sub_warning %>
  <% w = @sub_warning %>
  <div class="l-subwarn <%= w[:level] %>">
    <div style="flex:1; min-width:200px;">
      <strong><%= d.("warn_#{w[:kind]}") %></strong>
      <div style="font-size:13px; opacity:.9; margin-top:2px; max-width:760px;">
        <%= d.("warn_#{w[:kind]}_body", days: w[:days]) %>
      </div>
    </div>
    <% trial_cta = %i[trial trial_over].include?(w[:kind]) %>
    <%= link_to d.(trial_cta ? :choose_plan_cta : :pay_now), merchant_billing_path, class: "l-btn l-btn-primary", style: "flex:none;" %>
  </div>
<% end %>

<%# ---- KPI strip ----
     Two of these follow the selected range and two are all-time totals. Without
     saying which, "4.266 điểm đã phát" sitting next to "27.870 chưa dùng" reads
     as a contradiction rather than as two different questions. ---- %>
<% range_tag = @range[:key] == "all" ? d.(:scope_all) : @range[:label] %>
<%# ---- The design's two metric rows: the business first, then the programme.
      Each card carries the scope it is measured over, because mixing a range
      figure with an all-time one in the same row reads as a contradiction. ---- %>
<div class="m-metrics">
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:revenue) %></span><span class="ic"><%= ui_icon(:coins, size: 15) %></span></div>
    <div class="row"><span class="v"><%= number_with_delimiter(@revenue) %>đ</span><span class="m-badge"><%= range_tag %></span></div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:transactions_label) %></span><span class="ic"><%= ui_icon(:receipt, size: 15) %></span></div>
    <div class="row"><span class="v"><%= number_with_delimiter(@purchases_count) %></span><span class="m-badge"><%= range_tag %></span></div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:members) %></span><span class="ic"><%= ui_icon(:users, size: 15) %></span></div>
    <div class="row">
      <span class="v"><%= number_with_delimiter(@members_count) %></span>
      <span class="m-badge up"><%= d.(:active_suffix, n: number_with_delimiter(@active_members)) %></span>
    </div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:new_members_label) %></span><span class="ic"><%= ui_icon(:user, size: 15) %></span></div>
    <div class="row"><span class="v"><%= number_with_delimiter(@new_members.to_i) %></span><span class="m-badge"><%= range_tag %></span></div>
  </div>
</div>

<div class="m-metrics" style="margin-top:16px;">
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:points_issued) %></span><span class="ic"><%= ui_icon(:sparkles, size: 15) %></span></div>
    <div class="row"><span class="v"><%= number_with_delimiter(@points_issued) %></span><span class="m-badge"><%= range_tag %></span></div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:points_redeemed) %></span><span class="ic"><%= ui_icon(:gift, size: 15) %></span></div>
    <div class="row">
      <span class="v"><%= number_with_delimiter(@points_redeemed) %></span>
      <span class="m-badge <%= @redemption_rate.to_i >= 30 ? 'up' : '' %>"><%= d.(:redemption_rate_suffix, n: @redemption_rate) %></span>
    </div>
  </div>
  <div class="m-metric">
    <%# Expired points used to be lumped into redemptions, which read as if
        customers had spent them. %>
    <div class="hd"><span class="k"><%= d.(:points_expired_label) %></span><span class="ic"><%= ui_icon(:clock, size: 15) %></span></div>
    <div class="row"><span class="v"><%= number_with_delimiter(@points_expired.to_i) %></span><span class="m-badge"><%= range_tag %></span></div>
  </div>
  <div class="m-metric">
    <div class="hd"><span class="k"><%= d.(:outstanding) %></span><span class="ic"><%= ui_icon(:wallet_cards, size: 15) %></span></div>
    <div class="row">
      <span class="v"><%= number_with_delimiter(@points_outstanding) %></span>
      <span class="m-badge"><%= d.(:scope_all) %></span>
    </div>
  </div>
</div>
</div>

<%# ---- Operational overview: what just happened, and what is waiting on you.
      The design puts these together at the bottom of the dashboard. ---- %>
<div class="m-ops" style="margin-top:16px;">
  <div class="l-panel">
    <div class="m-sec">
      <div style="min-width:0;">
        <h3><%= d.(:recent_tx) %></h3>
        <div class="sub"><%= d.(:recent_tx_sub) %></div>
      </div>
      <%= link_to d.(:view_all), merchant_transactions_path, class: "act" %>
    </div>
    <% if @recent_tx.blank? %>
      <p style="color:var(--ink-2); font-size:13.5px;"><%= d.(:no_tx) %></p>
    <% else %>
      <div style="overflow-x:auto;">
        <table class="m-table">
          <thead>
            <tr>
              <th><%= d.(:col_customer) %></th>
              <th><%= d.(:col_type) %></th>
              <th><%= d.(:col_points) %></th>
              <th><%= d.(:col_time) %></th>
            </tr>
          </thead>
          <tbody>
            <% @recent_tx.each do |tx| %>
              <tr>
                <td>
                  <div class="m-who">
                    <span class="av"><%= tx.member&.initials %></span>
                    <div style="min-width:0;">
                      <div class="nm"><%= tx.member&.display_name %></div>
                      <div class="sub"><%= tx.outlet&.name || current_workspace.name %></div>
                    </div>
                  </div>
                </td>
                <td><span class="l-chip" style="font-size:11.5px;"><%= tx.title %></span></td>
                <td class="m-num" style="color:<%= tx.credit? ? 'var(--good)' : 'var(--warn)' %>;">
                  <%= tx.credit? ? "+" : "" %><%= number_with_delimiter(tx.amount) %>
                </td>
                <td style="color:var(--ink-2); white-space:nowrap;"><%= l(tx.created_at, format: :short) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div>
    <div class="l-panel">
      <div class="m-sec" style="margin-bottom:10px;">
        <h3 style="font-size:16px;"><%= d.(:alerts_title) %></h3>
        <% if @alert_count.to_i.positive? %><span class="m-badge down"><%= @alert_count %></span><% end %>
      </div>
      <% if @open_alerts.blank? %>
        <p style="color:var(--ink-2); font-size:13.5px;"><%= d.(:alerts_none) %></p>
      <% else %>
        <% @open_alerts.each do |a| %>
          <%= link_to (a.link.presence || merchant_alerts_path), class: "m-alert" do %>
            <span class="ic"><%= ui_icon(:shield, size: 15) %></span>
            <div class="bd">
              <div class="tt"><%= a.title %></div>
              <div class="mt"><%= a.body %></div>
            </div>
            <%= ui_icon(:chevron_right, size: 14, stroke: 2.2) %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="l-panel" style="margin-top:16px;">
      <h3 style="font-size:16px; font-weight:700; margin-bottom:12px;"><%= d.(:quick_links) %></h3>
      <div class="m-quick">
        <%= link_to merchant_scanner_path do %>
          <div class="hd"><span class="ic"><%= ui_icon(:scan, size: 15) %></span><%= ui_icon(:launch, size: 14) %></div>
          <div class="tt"><%= d.(:ql_counter) %></div>
          <div class="mt"><%= d.(:ql_counter_sub) %></div>
        <% end %>
        <%= link_to merchant_rewards_path do %>
          <div class="hd"><span class="ic"><%= ui_icon(:gift, size: 15) %></span><%= ui_icon(:launch, size: 14) %></div>
          <div class="tt"><%= d.(:ql_rewards) %></div>
          <div class="mt"><%= d.(:ql_rewards_sub) %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# ---- Doanh thu & giữ chân: câu trả lời cho "chương trình này có sinh tiền không?" ---- %>
<%= render "merchant/dashboard/retention", r: @retention, d: d %>

<%# ---- Khách mới đến từ đâu ---- %>
<% if @new_sources && @new_sources[:total].positive? %>
  <div class="l-panel" style="margin-top:16px;">
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px;">
      <div>
        <h3 class="l-display" style="font-size:18px;"><%= d.(:acquisition_title) %></h3>
        <p style="color:var(--ink-2); font-size:13px;"><%= d.(:acquisition_note) %></p>
      </div>
      <div style="text-align:right;">
        <div class="l-num" style="font-size:24px;"><%= number_with_delimiter(@new_sources[:total]) %></div>
        <div style="color:var(--ink-2); font-size:12px;"><%= d.(:acquisition_total) %></div>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:12px; margin-top:14px;">
      <% @new_sources[:rows].each do |row| %>
        <div>
          <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
            <span style="font-weight:600;"><%= Member.join_source_icon(row[:key]) %> <%= Member.join_source_label(row[:key]) %></span>
            <span style="color:var(--ink-2); font-variant-numeric:tabular-nums;"><%= number_with_delimiter(row[:count]) %> · <%= row[:pct] %>%</span>
          </div>
          <div style="height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden;">
            <div style="height:100%; width:<%= row[:pct] %>%; border-radius:999px; background:var(--primary);"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ---- Growth chart + loyalty snapshot ---- %>
<div style="display:grid; grid-template-columns:1.5fr 1fr; gap:16px; margin-top:20px;">
  <div class="l-panel">
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:6px;">
      <div>
        <h3 class="l-display" style="font-size:18px;"><%= d.(:new_members_by_month) %></h3>
        <p style="color:var(--ink-2); font-size:13px;"><%= d.(:last_6_months) %></p>
      </div>
      <div style="text-align:right;">
        <div class="l-num" style="font-size:24px;"><%= number_with_delimiter(@members_count) %></div>
        <div style="color:var(--ink-2); font-size:12px;"><%= d.(:total_members) %></div>
      </div>
    </div>
    <div style="color:var(--primary); margin-top:10px;">
      <%= bar_chart_svg(@member_growth) %>
    </div>
  </div>

  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;"><%= d.(:loyalty_snapshot) %></h3>
    <% total_tiered = @tier_counts.sum { |_, c| c } %>
    <% if total_tiered.positive? %>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <% @tier_counts.each do |t, c| %>
          <% pct = (c.to_f / total_tiered * 100).round %>
          <div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
              <span style="font-weight:600;"><%= t.name %></span>
              <span style="color:var(--ink-2);"><%= number_with_delimiter(c) %> · <%= pct %>%</span>
            </div>
            <div style="height:8px; border-radius:999px; background:var(--surface-2); overflow:hidden;">
              <div style="height:100%; width:<%= pct %>%; border-radius:999px; background:<%= t.gradient_css %>;"></div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p style="color:var(--ink-2); font-size:13px;"><%= d.(:no_tier_data) %></p>
    <% end %>
    <div style="display:flex; gap:10px; margin-top:16px; padding-top:14px; border-top:1px solid var(--line);">
      <div style="flex:1;"><div class="l-num" style="font-size:20px;"><%= @redemption_rate %>%</div><div style="font-size:11px; color:var(--ink-2);"><%= d.(:redemption_rate) %> <span class="sc"><%= range_tag %></span></div></div>
      <div style="flex:1;"><div class="l-num" style="font-size:20px;"><%= @earning_members.to_i.positive? ? number_with_delimiter((@points_issued / @earning_members)) : 0 %></div><div style="font-size:11px; color:var(--ink-2);"><%= d.(:avg_points_per_member) %> <span class="sc"><%= range_tag %></span></div></div>
    </div>
  </div>
</div>

<%# ---- Per-branch performance ---- %>
<% if @outlet_stats&.any? %>
  <% max_rev = [@outlet_stats.map { |r| r[:revenue] }.max, 1].max %>
  <div class="l-panel" style="margin-top:16px;">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= d.(:branch_performance) %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px;"><%= d.(:branch_performance_note) %></p>
    <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:13.5px; min-width:560px;">
        <thead><tr style="text-align:left; color:var(--ink-2); font-size:11px; text-transform:uppercase; letter-spacing:.06em;">
          <th style="padding:8px 10px;"><%= d.(:th_branch) %></th>
          <th style="text-align:right;"><%= d.(:th_revenue) %></th>
          <th style="text-align:right;"><%= d.(:th_points) %></th>
          <th style="text-align:right;"><%= d.(:th_txns) %></th>
          <th style="text-align:right;"><%= d.(:th_customers) %></th>
          <th style="text-align:right;"><%= d.(:th_vouchers) %></th>
        </tr></thead>
        <tbody>
          <% @outlet_stats.each do |r| %>
            <tr style="border-top:1px solid var(--line);">
              <td style="padding:11px 10px; min-width:180px;">
                <div style="font-weight:600;">
                  <% if r[:id] %><%= link_to r[:name], merchant_outlet_path(r[:id]), style: "color:var(--ink); text-decoration:none;" %><% else %><%= r[:name] %><% end %>
                </div>
                <div style="height:6px; border-radius:999px; background:var(--surface-2); overflow:hidden; margin-top:5px;">
                  <div style="height:100%; width:<%= (r[:revenue].to_f / max_rev * 100).round %>%; background:var(--primary); border-radius:999px;"></div>
                </div>
              </td>
              <td style="text-align:right; font-weight:700; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:revenue]) %>đ</td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:points]) %></td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:purchases]) %></td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:customers]) %></td>
              <td style="text-align:right; font-variant-numeric:tabular-nums;"><%= number_with_delimiter(r[:vouchers]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<%# ---- Busy-hour heatmap + AI insight (AJAX: branch switch + refresh) ---- %>
<% if @busy_hours %>
  <div class="l-panel" style="margin-top:16px;" data-controller="busyhour"
       data-busyhour-url-value="<%= merchant_busy_hour_insight_path %>"
       data-busyhour-refresh-url-value="<%= merchant_refresh_busy_hour_insight_path %>"
       data-busyhour-range-value="<%= @range[:key] %>">
    <div data-busyhour-target="panel">
      <%= render "merchant/dashboard/busy_hour" %>
    </div>
  </div>
<% end %>

<%# ---- Program mechanisms + check-in QR ---- %>
<div style="display:grid; grid-template-columns:1.5fr 1fr; gap:16px; margin-top:16px;">
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= d.(:loyalty_program) %></h3>
    <p style="color:var(--ink-2); font-size:14px; margin-bottom:16px;"><%= d.(:mechanisms_on) %></p>
    <% if @program %>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <% { mech_points: @program.points_enabled, mech_tiers: @program.tiers_enabled, mech_stamp: @program.stamps_enabled, mech_gamification: @program.gamification_enabled }.each do |key, on| %>
          <span class="l-chip <%= 'l-chip-brand' if on %>"><%= on ? "●" : "○" %> <%= d.(key) %></span>
        <% end %>
      </div>
      <p style="margin-top:16px; color:var(--ink-2);"><%= d.(:earn_rate) %> <strong><%= @program.earn_rate_label %></strong></p>
      <%= link_to d.(:configure_program), merchant_loyalty_program_path, class: "l-btn l-btn-soft", style: "margin-top:16px;" %>
    <% end %>
  </div>

  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:10px;"><%= d.(:tiers) %></h3>
    <% @tiers.each do |t| %>
      <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--line);">
        <span style="width:26px; height:26px; border-radius:8px; background:<%= t.gradient_css %>;"></span>
        <strong><%= t.name %></strong>
        <span style="margin-left:auto; color:var(--ink-2);"><%= d.(:points_n, n: number_with_delimiter(t.threshold_points)) %></span>
      </div>
    <% end %>
    <div style="margin-top:12px; padding-top:10px; border-top:1px solid var(--line);">
