<% content_for :title, t("merchant.nav.billing") %>
<% content_for :title_en, "BILLING" %>

<div style="max-width:820px;">
  <div class="l-panel" style="display:flex; align-items:center; gap:16px; margin-bottom:16px;">
    <div style="flex:1;">
      <div class="l-eyebrow"><%= t("merchant.billing.current_plan") %></div>
      <% if @workspace.trial? %>
        <div class="l-display" style="font-size:26px;">Dùng thử</div>
        <div style="color:var(--ink-2); font-size:14px;">Full tính năng · <%= t("merchant.customers.count", n: number_with_delimiter(@members)) %> · chọn gói khi thanh toán</div>
      <% else %>
        <div class="l-display" style="font-size:26px;"><%= @plan.name %></div>
        <div style="color:var(--ink-2); font-size:14px;"><%= @workspace.status_label %> · <%= t("merchant.customers.count", n: number_with_delimiter(@members)) %><%= " / #{@plan.max_members}" if @plan.max_members %></div>
      <% end %>
    </div>
    <% unless @workspace.trial? %>
      <div style="text-align:right;">
        <div class="l-num" style="font-size:30px;"><%= @plan.price_label %></div>
        <div style="color:var(--ink-2); font-size:13px;"><%= t("merchant.billing.per_month") %></div>
      </div>
    <% end %>
  </div>

  <%# ---- Subscription status + pay ---- %>
  <div class="l-panel" style="margin-bottom:20px;">
    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
      <div style="flex:1; min-width:220px;">
        <div class="l-eyebrow"><%= t("merchant.billing.sub_status") %></div>
        <% if @workspace.trial? %>
          <div style="font-weight:700; color:var(--primary); margin-top:4px;"><%= t("merchant.billing.trial_status") %></div>
          <div style="color:var(--ink-2); font-size:13px;"><%= t("merchant.billing.trial_until", date: l(@workspace.paid_until.to_date, format: :long), n: @workspace.subscription_days_left) %></div>
        <% elsif @workspace.subscription_active? %>
          <div style="font-weight:700; color:var(--good); margin-top:4px;"><%= t("merchant.billing.active") %></div>
          <div style="color:var(--ink-2); font-size:13px;"><%= t("merchant.billing.paid_until", date: l(@workspace.paid_until.to_date, format: :long), n: @workspace.subscription_days_left) %></div>
        <% else %>
          <div style="font-weight:700; color:var(--warn); margin-top:4px;"><%= t("merchant.billing.unpaid") %></div>
          <div style="color:var(--ink-2); font-size:13px;"><%= t("merchant.billing.unpaid_note") %></div>
        <% end %>
      </div>
      <% if @workspace.trial? %>
        <span class="l-chip l-chip-brand" style="flex:none;">Chọn gói bên dưới để kích hoạt →</span>
      <% elsif @workspace.payment_state == :owing && @payos_ready %>
        <%= button_to merchant_billing_pay_path, method: :post, class: "l-btn l-btn-primary",
              style: "flex:none;", form: { target: "_blank", data: { turbo: false } } do %>
          <%= ui_icon(:wallet, size: 18) %> <%= t("merchant.billing.pay", price: @plan.price_label) %>
        <% end %>
      <% elsif @workspace.payment_state == :owing %>
        <span class="l-chip"><%= t("merchant.billing.payos_missing") %></span>
      <% end %>
    </div>

    <% if @payos_ready %>
      <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:16px; padding-top:14px; border-top:1px solid var(--line);">
        <div>
          <div style="font-weight:600; font-size:14px;"><%= t("merchant.billing.auto_renew_title") %></div>
          <div style="color:var(--ink-2); font-size:12px; max-width:520px;">
            <%= t("merchant.billing.auto_renew_note") %>
          </div>
        </div>
        <%= button_to merchant_billing_auto_renew_path, method: :patch,
              params: { auto_renew: @workspace.auto_renew ? "0" : "1" },
              class: "l-switch-btn", form: { style: "flex:none;" },
              "aria-label": (@workspace.auto_renew ? t("merchant.billing.auto_renew_off") : t("merchant.billing.auto_renew_on")) do %>
          <span class="l-switch <%= 'on' if @workspace.auto_renew %>"><span class="knob"></span></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @invoices.any? %>
    <div class="l-panel" style="margin-bottom:20px;">
      <div class="l-eyebrow" style="margin-bottom:8px;"><%= t("merchant.billing.invoices") %></div>
      <%# The invoice table has four columns and a button; give it its own
          scroller so it can never push the page sideways on a phone. %>
      <div style="overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-size:13px; min-width:340px;">
        <% @invoices.each do |inv| %>
          <tr style="border-top:1px solid var(--line);">
            <td style="padding:8px 4px;"><%= inv.period_label %></td>
            <td><%= inv.plan %></td>
            <td style="text-align:right; font-weight:600;"><%= number_with_delimiter(inv.amount) %>đ</td>
            <td style="text-align:right;">
              <% color = { "paid" => "var(--good)", "pending" => "var(--primary)", "failed" => "var(--warn)", "cancelled" => "var(--ink-2)" }[inv.status] %>
              <span class="l-chip" style="background:<%= color %>22; color:<%= color %>;"><%= { "paid"=>t("merchant.billing.st_paid"),"pending"=>t("merchant.billing.st_pending"),"failed"=>t("merchant.billing.st_failed"),"cancelled"=>t("merchant.billing.st_cancelled") }[inv.status] %></span>
              <% if inv.pending? %><%= button_to t("merchant.billing.repay"), merchant_billing_repay_path(inv), method: :post,
                    class: "l-chip l-chip-brand", style: "border:none; cursor:pointer;",
                    form: { style: "display:inline;", target: "_blank", data: { turbo: false } } %><% end %>
            </td>
          </tr>
        <% end %>
      </table>
      </div>
    </div>
  <% end %>

  <div class="l-eyebrow" style="margin-bottom:10px;"><%= t("merchant.billing.plans") %></div>
  <%# A hard N-column grid squeezed three plans into 375px, clipping the last
      card off the screen. Let them wrap instead. %>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px;">
    <% @plans.each do |plan| %>
      <% current = !@workspace.trial? && @workspace.plan == plan.key %>
      <div class="l-panel" style="<%= 'border:2px solid var(--primary);' if current %>">
        <div style="font-weight:700; font-size:16px;"><%= plan.name %></div>
        <div class="l-num" style="font-size:24px; margin:6px 0;"><%= plan.price_label %></div>
        <ul style="list-style:none; font-size:13px; color:var(--ink-2); display:flex; flex-direction:column; gap:6px; margin:10px 0;">
          <% plan.localized_features.each do |feat| %><li>✓ <%= feat %></li><% end %>
        </ul>
        <% if current %>
          <span class="l-chip l-chip-brand" style="width:100%; justify-content:center;"><%= t("merchant.billing.using") %></span>
        <% elsif @payos_ready %>
          <% fdata = { turbo: false }
             # Only warn when the current plan is already paid & active (switching
             # wastes remaining paid time). Owing/trial shops just proceed to pay.
             if @workspace.payment_state == :paid
               fdata[:controller] = "confirmsubmit"
               fdata[:confirmsubmit_message_value] = t("merchant.billing.switch_confirm",
                 current: @plan.name, expiry: @workspace.paid_until.to_date.strftime("%d/%m/%Y"),
                 plan: plan.name, price: plan.price_label)
               fdata[:action] = "submit->confirmsubmit#check"
             end %>
          <%= button_to merchant_billing_pay_path, method: :post, params: { plan: plan.key },
                class: "l-btn l-btn-primary l-btn-block", form: { target: "_blank", data: fdata } do %>
            <% if @workspace.trial? %>
              Chọn & thanh toán <%= number_with_delimiter(@workspace.prorated_amount(plan.price)) %>đ
            <% else %>
              Chuyển sang gói này
            <% end %>
          <% end %>
          <% if @workspace.trial? %>
            <% s, e = @workspace.first_billing_period %>
            <div style="font-size:11px; color:var(--ink-2); margin-top:6px; text-align:center;">
              Kỳ đầu <%= s.strftime("%d/%m") %>–<%= e.strftime("%d/%m") %> (còn lại của tháng), sau đó <%= plan.price_label %>/tháng
            </div>
          <% end %>
        <% else %>
          <button class="l-btn l-btn-soft l-btn-block" disabled><%= t("merchant.billing.payos_missing") %></button>
        <% end %>
      </div>
    <% end %>
  </div>
  <p style="font-size:12px; color:var(--ink-2); margin-top:14px;"><%= t("merchant.billing.plans_note") %></p>
</div>
