<% content_for :title, t("merchant.nav.customers") %>
<% content_for :title_en, "CUSTOMERS" %>

<%= form_with url: merchant_customers_path, method: :get, data: { turbo: false } do %>
  <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
    <select name="segment" class="l-field" style="max-width:260px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.nav.customers') %>">
      <% MemberSegments::PRESETS.each do |key, meta| %>
        <option value="<%= key %>" <%= 'selected' if @segment == key %>>
          <%= meta[:icon] %> <%= meta[:label] %> · <%= @counts[key] %>
        </option>
      <% end %>
    </select>
    <input type="search" name="q" value="<%= @q %>" placeholder="<%= t('merchant.segments.search_ph') %>" class="l-field" style="flex:1; min-width:200px;">
    <% if @branches.present? %>
      <select name="outlet" class="l-field" style="max-width:220px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.customers.branch_filter') %>">
        <option value=""><%= t('merchant.customers.branch_all') %></option>
        <% @branches.each do |o| %>
          <option value="<%= o.id %>" <%= 'selected' if @outlet&.id == o.id %>><%= o.name %></option>
        <% end %>
      </select>
    <% end %>
    <% if @tiers.present? %>
      <select name="tier" class="l-field" style="max-width:180px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.customers.th_tier') %>">
        <option value=""><%= t('merchant.customers.tier_all') %></option>
        <% @tiers.each do |ti| %>
          <option value="<%= ti.key %>" <%= 'selected' if @tier == ti.key %>><%= ti.name %></option>
        <% end %>
      </select>
    <% end %>
    <select name="sort" class="l-field" style="max-width:200px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.segments.sort_label') %>">
      <option value="recent" <%= 'selected' unless %w[points spend].include?(@sort) %>><%= t('merchant.segments.sort_recent') %></option>
      <option value="points" <%= 'selected' if @sort == 'points' %>><%= t('merchant.segments.sort_points') %></option>
      <option value="spend"  <%= 'selected' if @sort == 'spend' %>><%= t('merchant.segments.sort_spend') %></option>
    </select>
    <%= submit_tag "🔍 #{t('merchant.transactions.search_btn')}", class: "l-btn l-btn-primary", style: "flex:none; padding:9px 18px;" %>
    <% filtered = @applied_outlet.present? || @q.present? || @tier.present? %>
    <% if @segment != "all" || filtered %>
      <%= link_to t("merchant.customers.send_group"), new_merchant_broadcast_path(@compose_params),
            class: "l-btn l-btn-primary", style: "margin-left:auto; padding:8px 14px; font-size:13px; flex:none;" %>
    <% else %>
      <%= link_to t("merchant.customers.compose"), new_merchant_broadcast_path(@compose_params),
            class: "l-btn l-btn-soft", style: "margin-left:auto; padding:8px 14px; font-size:13px; flex:none;" %>
    <% end %>
  </div>
<% end %>

<div class="l-panel">
  <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
    <strong><%= MemberSegments.icon(@segment) %> <%= MemberSegments.label(@segment) %></strong>
    <span style="color:var(--ink-2); font-size:13px;"><%= t("merchant.customers.count", n: @total) %></span>
  </div>
  <%# Shops rename their tiers, so the list must show the shop's own names —
      this printed the internal key ("gold"), which meant the filter above said
      "Vàng" while the column beside it said "Gold". Indexed from @tiers, which
      is already loaded, rather than Member#tier's per-row lookup. %>
  <% tier_names = @tiers.index_by(&:key).transform_values(&:name) %>
  <table style="width:100%; border-collapse:collapse;">
    <thead><tr style="text-align:left; color:var(--ink-2); font-size:12px; text-transform:uppercase; letter-spacing:.08em;">
      <th style="padding:10px 8px;"><%= t("merchant.customers.th_name") %></th><th>Email</th><th><%= t("merchant.customers.th_phone") %></th><th><%= t("merchant.customers.th_points") %></th><th><%= t("merchant.customers.th_tier") %></th><th><%= t("merchant.customers.th_birthday") %></th><th><%= t("merchant.customers.th_joined") %></th>
    </tr></thead>
    <tbody>
      <% @members.each do |m| %>
        <tr style="border-top:1px solid var(--line); cursor:pointer;">
          <td style="padding:12px 8px; font-weight:600;"><%= link_to m.display_name, merchant_customer_path(m), style: "color:var(--primary-ink); text-decoration:none;" %></td>
          <td class="l-mono"><%= m.email.presence || "—" %></td>
          <td class="l-mono"><%= m.phone.presence || "—" %></td>
          <td><%= number_with_delimiter(m.points_balance) %></td>
          <td><%= tier_names[m.tier_key] || "—" %></td>
          <td style="color:var(--ink-2);"><%= m.birthday ? l(m.birthday, format: :short) : "—" %></td>
          <td style="color:var(--ink-2); display:flex; align-items:center; gap:8px;"><%= l(m.created_at.to_date, format: :short) %> <%= link_to t("merchant.customers.view"), merchant_customer_path(m), class: "l-chip", style: "font-size:11px;" %></td>
        </tr>
      <% end %>
      <% if @members.empty? %><tr><td colspan="7" style="padding:20px; text-align:center; color:var(--ink-2);"><%= t("merchant.customers.empty") %></td></tr><% end %>
    </tbody>
  </table>

  <%# ---- Pagination ---- %>
  <% if @page > 1 || @has_more %>
    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:14px; padding-top:12px; border-top:1px solid var(--line);">
      <% if @page > 1 %>
        <%= link_to t("merchant.pagination.prev"), merchant_customers_path(request.query_parameters.merge(page: @page - 1)), class: "l-btn l-btn-soft" %>
      <% else %><span></span><% end %>
      <span style="font-size:13px; color:var(--ink-2);"><%= t("merchant.pagination.page", n: @page) %></span>
      <% if @has_more %>
        <%= link_to t("merchant.pagination.next"), merchant_customers_path(request.query_parameters.merge(page: @page + 1)), class: "l-btn l-btn-soft" %>
      <% else %><span></span><% end %>
    </div>
  <% end %>
</div>
