<% content_for :title, @member.display_name %>
<% content_for :title_en, "CUSTOMER" %>
<% merchant_back merchant_customers_path %>

<div>
  <%# ---- Header ---- %>
  <div class="l-panel" style="margin-top:12px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
    <div class="av" style="width:56px; height:56px; border-radius:16px; background:<%= @member.tier&.gradient_css || 'var(--primary)' %>; color:#fff; display:grid; place-items:center; font-weight:700; font-size:20px; flex:none;"><%= @member.initials %></div>
    <div style="flex:1; min-width:180px;">
      <div style="font-size:20px; font-weight:700;"><%= @member.display_name %></div>
      <div style="color:var(--ink-2); font-size:13px;"><%= [@member.email.presence, @member.phone.presence].compact.join(" · ").presence || "—" %></div>
      <div style="margin-top:6px; display:flex; gap:8px; flex-wrap:wrap;">
        <% if @member.tier %><span class="l-chip l-chip-brand"><%= @member.tier.name %></span><% end %>
        <% if @member.birthday %><span class="l-chip">🎂 <%= l(@member.birthday, format: :short) %></span><% end %>
        <span class="l-chip"><%= t("merchant.customer.joined", date: l(@member.created_at.to_date, format: :short)) %></span>
      </div>
    </div>
  </div>

  <%# ---- KPIs ---- %>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-top:16px;">
    <% [[t("merchant.customer.kpi_balance"), number_with_delimiter(@member.points_balance)],
        [t("merchant.customer.kpi_lifetime"), number_with_delimiter(@member.lifetime_points)],
        [t("merchant.customer.kpi_purchases"), @purchase_count],
        [t("merchant.customer.kpi_spend"), "#{number_with_delimiter(@total_spend.to_i)}đ"]].each do |label, val| %>
      <div class="l-panel" style="padding:14px 16px;">
        <div class="l-eyebrow"><%= label %></div>
        <div class="l-num" style="font-size:26px; margin-top:4px;"><%= val %></div>
      </div>
    <% end %>
  </div>

  <%# ---- Manual points adjustment (managers) ---- %>
  <% if current_membership&.can_manage? %>
    <div class="l-panel" style="margin-top:16px;">
      <h3 class="l-display" style="font-size:17px; margin-bottom:4px;"><%= t("merchant.customer.adjust_title") %></h3>
      <p style="color:var(--ink-2); font-size:13px; margin-bottom:12px;"><%= t("merchant.customer.adjust_note") %></p>
      <%= form_with url: adjust_merchant_customer_path(@member), method: :post do %>
        <%# Fixed three-column grid squeezed the reason box on a laptop. %>
        <div style="display:grid; grid-template-columns:130px minmax(0,1fr) auto; gap:8px; align-items:end;">
          <div>
            <label class="l-label"><%= t("merchant.customer.amount") %></label>
            <%= number_field_tag :amount, nil, class: "l-field", placeholder: "VD: 100 / -50",
                  min: -Merchant::CustomersController::MAX_ADJUST, max: Merchant::CustomersController::MAX_ADJUST %>
          </div>
          <div>
            <%# The reason is required — an unexplained manual change to what the
                shop owes a customer is the one nobody can account for later. %>
            <label class="l-label"><%= t("merchant.customer.reason") %> <span style="color:#B4402F;">*</span></label>
            <%= text_field_tag :note, nil, class: "l-field", placeholder: "VD: Đền bù đồ uống lỗi", required: true %>
          </div>
          <%= submit_tag t("merchant.customer.apply"), class: "l-btn l-btn-primary" %>
        </div>
        <p style="color:var(--ink-2); font-size:12px; margin-top:8px;">
          <%= t("merchant.customer.adjust_limits",
                max: number_with_delimiter(Merchant::CustomersController::MAX_ADJUST),
                balance: number_with_delimiter(@member.points_balance)) %>
        </p>
      <% end %>
    </div>
  <% end %>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:16px; align-items:start;">
    <%# ---- Points history ---- %>
    <div class="l-panel">
      <h3 class="l-display" style="font-size:17px; margin-bottom:10px;"><%= t("merchant.customer.history") %></h3>
      <% if @transactions.empty? %>
        <p style="color:var(--ink-2); font-size:13px;"><%= t("merchant.customer.no_history") %></p>
      <% else %>
        <% @transactions.each do |t| %>
          <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--line);">
            <span style="font-size:18px;"><%= t.icon %></span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:600;"><%= t.title %></div>
              <div style="font-size:11px; color:var(--ink-2);"><%= l(t.created_at, format: :short) %><%= " · #{t.staff.name}" if t.staff %><%= " · #{t.outlet.name}" if t.outlet %></div>
            </div>
            <div class="l-num" style="font-weight:700; color:<%= t.credit? ? 'var(--good)' : 'var(--warn)' %>;"><%= t.credit? ? "+" : "" %><%= number_with_delimiter(t.amount) %></div>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# ---- Vouchers ---- %>
    <div class="l-panel">
      <h3 class="l-display" style="font-size:17px; margin-bottom:10px;"><%= t("merchant.customer.wallet") %></h3>
      <% if @vouchers.empty? %>
        <p style="color:var(--ink-2); font-size:13px;"><%= t("merchant.customer.no_vouchers") %></p>
      <% else %>
        <% @vouchers.each do |v| %>
          <% st = v.expired? ? "expired" : v.state %>
          <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--line);">
            <span style="font-size:18px;"><%= v.reward&.display_icon %></span>
            <div style="flex:1; min-width:0;">
              <div style="font-size:14px; font-weight:600;"><%= v.reward&.title %></div>
              <div style="font-size:11px; color:var(--ink-2);"><%= v.reward&.value_label %> · <span class="l-mono"><%= v.code %></span></div>
            </div>
            <span class="l-chip" style="font-size:11px;<%= ' color:var(--good);' if st == 'active' %><%= ' color:var(--ink-2);' if st != 'active' %>">
              <%= { "active" => t("merchant.customer.state_active"), "used" => t("merchant.customer.state_used"), "expired" => t("merchant.customer.state_expired") }[st] || st %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ---- Danger zone: permanently delete the customer (owner only) ---- %>
  <% if current_membership&.owner? %>
    <div class="l-panel" style="margin-top:16px; border:1px solid color-mix(in srgb, var(--warn) 40%, transparent);">
      <h3 class="l-display" style="font-size:17px; margin-bottom:4px; color:var(--warn);"><%= t("merchant.customer.delete_title") %></h3>
      <p style="color:var(--ink-2); font-size:13px; margin-bottom:12px;"><%= t("merchant.customer.delete_note") %></p>
      <%= button_to t("merchant.customer.delete"), merchant_customer_path(@member), method: :delete,
            class: "l-btn l-btn-ghost", style: "color:var(--warn); border-color:var(--warn);",
            form: { data: { turbo_confirm: t("merchant.customer.delete_confirm", name: @member.display_name) }, style: "display:inline;" } %>
    </div>
  <% end %>
</div>
