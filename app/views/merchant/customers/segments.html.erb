<% content_for :title, t("merchant.nav.segments") %>
<% content_for :title_en, "SEGMENTS" %>
<% sg = ->(k, **o) { t("merchant.segs.#{k}", **o) } %>

<div style="display:flex; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:16px;">
  <div style="flex:1; min-width:220px;">
    <h2 class="l-display" style="font-size:22px;"><%= sg.(:title) %></h2>
    <p style="color:var(--ink-2); font-size:13.5px; margin-top:4px;"><%= sg.(:subtitle) %></p>
  </div>
  <span class="m-badge"><%= sg.(:system_badge) %></span>
</div>

<%# These rules are evaluated live, so nothing here can drift out of date — and
    equally, there is no history to draw a trend from. %>
<div class="l-note" style="margin-bottom:16px;">
  <%= ui_icon(:refresh, size: 16) %><span><%= sg.(:live_note) %></span>
</div>

<div class="m-ops" style="grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);">
  <div class="l-panel" style="padding:0;">
    <div style="padding:16px 18px; border-bottom:1px solid var(--line);">
      <div style="font-weight:700; font-size:15px;"><%= sg.(:list_title) %></div>
      <div style="font-size:12.5px; color:var(--ink-2); margin-top:2px;"><%= sg.(:list_sub) %></div>
    </div>
    <div style="overflow-x:auto;">
      <table class="m-table" style="min-width:560px;">
        <thead>
          <tr>
            <th style="padding-left:18px;"><%= sg.(:col_segment) %></th>
            <th><%= sg.(:col_rule) %></th>
            <th style="padding-right:18px;"><%= sg.(:col_members) %></th>
          </tr>
        </thead>
        <tbody>
          <% @keys.each do |key| %>
            <tr style="<%= 'background:var(--primary-soft);' if key == @key %>">
              <td style="padding-left:18px;">
                <%= link_to merchant_segments_path(key: key), style: "display:flex; align-items:center; gap:10px; text-decoration:none; color:inherit;" do %>
                  <span style="width:30px; height:30px; border-radius:9px; flex:none; display:grid; place-items:center; background:var(--surface-2); font-size:15px;">
                    <%= MemberSegments.icon(key) %>
                  </span>
                  <span style="font-weight:600;"><%= MemberSegments.label(key) %></span>
                <% end %>
              </td>
              <td style="color:var(--ink-2); font-size:12.5px;"><%= sg.("rule_#{key}") %></td>
              <td class="m-num" style="padding-right:18px;"><%= number_with_delimiter(@counts[key].to_i) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div style="padding:14px 18px; border-top:1px solid var(--line); font-size:12.5px; color:var(--ink-2); display:flex; align-items:center; gap:8px;">
      <span style="width:7px; height:7px; border-radius:50%; background:var(--good);"></span>
      <%= sg.(:footer, n: @keys.size) %>
    </div>
  </div>

  <%# ---- The selected audience ---- %>
  <div>
    <div class="l-panel">
      <div style="display:flex; align-items:flex-start; gap:14px;">
        <div style="flex:1; min-width:0;">
          <div class="l-eyebrow"><%= sg.(:detail_eyebrow) %></div>
          <div style="font-weight:700; font-size:18px; margin-top:3px;"><%= MemberSegments.icon(@key) %> <%= MemberSegments.label(@key) %></div>
        </div>
        <div style="text-align:right; flex:none;">
          <div style="font-size:22px; font-weight:700; letter-spacing:-.03em;"><%= number_with_delimiter(@size) %></div>
          <div style="font-size:11.5px; color:var(--ink-2);"><%= sg.(:members) %></div>
        </div>
      </div>

      <p style="font-size:13px; color:var(--ink-2); line-height:1.5; margin-top:12px;"><%= sg.("rule_#{@key}") %></p>

      <div style="display:flex; flex-direction:column; gap:10px; margin-top:16px;">
        <%= link_to merchant_customers_path(segment: @key), class: "l-btn l-btn-primary l-btn-block" do %>
          <%= ui_icon(:users, size: 16) %><%= sg.(:view_members) %>
        <% end %>
        <div style="display:flex; gap:10px;">
          <%= link_to sg.(:send_broadcast), merchant_broadcasts_path(segment: @key), class: "l-btn l-btn-ghost", style: "flex:1;" %>
          <%= link_to sg.(:new_campaign), merchant_campaigns_path, class: "l-btn l-btn-ghost", style: "flex:1;" %>
        </div>
      </div>
    </div>

    <%# ---- Who is actually in it ---- %>
    <% if @sample.any? %>
      <div class="l-panel" style="margin-top:16px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:10px;">
          <h3 style="font-size:15px; font-weight:700;"><%= sg.(:preview_title) %></h3>
          <span style="font-size:12px; color:var(--ink-2);"><%= sg.(:preview_of, n: number_with_delimiter(@size)) %></span>
        </div>
        <div style="margin-top:10px;">
          <% @sample.each do |m| %>
            <%= link_to merchant_customer_path(m), class: "l-row", style: "margin-top:8px;" do %>
              <span class="ic muted" style="border-radius:50%;"><%= m.initials %></span>
              <div class="bd">
                <div class="tt"><%= m.display_name %></div>
                <div class="mt"><%= number_with_delimiter(m.points_balance) %> <%= t("customer.common.points_unit") %><%= " · #{m.tier&.name}" if m.tier %></div>
              </div>
              <span class="tr"><%= ui_icon(:chevron_right, size: 15, stroke: 2.2) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ---- Tier mix of this audience ---- %>
    <% if @mix.any? { |_, n| n.positive? } %>
      <div class="l-panel" style="margin-top:16px;">
        <h3 style="font-size:15px; font-weight:700; margin-bottom:12px;"><%= sg.(:mix_title) %></h3>
        <% @mix.each do |tier, n| %>
          <% pct = @size.positive? ? (n * 100.0 / @size).round : 0 %>
          <div style="margin-bottom:10px;">
            <div style="display:flex; justify-content:space-between; font-size:12.5px; margin-bottom:4px;">
              <span><%= tier.name %></span>
              <span style="color:var(--ink-2);"><%= n %> · <%= pct %>%</span>
            </div>
            <span class="l-bar" style="display:block; height:5px;"><span style="width:<%= pct %>%;"></span></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
