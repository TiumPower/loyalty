<%= turbo_frame_tag "scan_tool" do %>
  <% r = @voucher.reward %>
  <div style="display:flex; align-items:center; gap:14px; padding:6px 0 16px; border-bottom:1px solid var(--line);">
    <div style="width:52px; height:52px; border-radius:16px; background:var(--primary-soft); display:grid; place-items:center; font-size:26px;"><%= r.display_icon %></div>
    <div style="flex:1; min-width:0;">
      <div style="font-weight:700; font-size:17px;"><%= r.title %></div>
      <div style="color:var(--ink-2); font-size:13px;"><%= t("merchant.scan.customer") %>: <%= @voucher.member.display_name %> · <%= @voucher.member.email.presence || @voucher.member.phone %></div>
    </div>
    <span class="l-chip" style="background:var(--good); color:#fff;"><%= t("merchant.scan.valid") %></span>
  </div>

  <div style="display:flex; justify-content:space-around; padding:16px 0;">
    <div style="text-align:center;"><div class="l-eyebrow"><%= t("merchant.scan.value") %></div><div class="l-display" style="font-size:22px;"><%= r.value_label %></div></div>
    <div style="text-align:center;"><div class="l-eyebrow"><%= t("merchant.scan.voucher_code") %></div><div class="l-mono" style="font-weight:700;"><%= @voucher.code %></div></div>
    <div style="text-align:center;"><div class="l-eyebrow"><%= t("merchant.scan.expiry") %></div><div style="font-weight:600;"><%= @voucher.expires_at ? l(@voucher.expires_at.to_date, format: :short) : "—" %></div></div>
  </div>

  <%= form_with url: merchant_redeem_path, method: :post do %>
    <input type="hidden" name="voucher_id" value="<%= @voucher.id %>">
    <%# The confirm step re-verifies this, so the one-time code gates the write
        and not just the lookup. %>
    <input type="hidden" name="token" value="<%= @voucher.redeem_token %>">
    <div style="display:flex; gap:10px; margin-top:8px;">
      <%= link_to t("merchant.scan.cancel"), merchant_scanner_path(tab: "redeem"), class: "l-btn l-btn-ghost", data: { turbo_frame: "scan_tool" } %>
      <%= submit_tag t("merchant.scan.confirm_used"), class: "l-btn l-btn-primary", style: "flex:1;" %>
    </div>
  <% end %>
<% end %>
