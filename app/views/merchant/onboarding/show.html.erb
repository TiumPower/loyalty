<% content_for :title, t("merchant.onboarding.setup_title") %>
<% steps = { 1 => t("merchant.onboarding.st_brand"), 2 => t("merchant.onboarding.st_mech"), 3 => t("merchant.onboarding.st_staff"), 4 => t("merchant.onboarding.st_done") } %>

<div>
  <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
    <% steps.each do |n, label| %>
      <div style="flex:1; height:6px; border-radius:999px; background:<%= n <= @step ? 'var(--primary)' : 'var(--surface-2)' %>;"></div>
    <% end %>
  </div>
  <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
    <div class="l-eyebrow"><%= t("merchant.onboarding.step_label", n: @step, label: steps[@step]) %></div>
    <%= button_to t("merchant.onboarding.skip_setup"), merchant_skip_onboarding_path, method: :post, class: "l-mono",
          style: "background:none; border:none; color:var(--ink-2); font-size:12px; cursor:pointer;" %>
  </div>

  <% case @step %>
  <% when 1 %>
    <div data-controller="onboardpreview" style="display:grid; grid-template-columns:1.2fr .8fr; gap:20px; align-items:start;">
      <div class="l-panel">
        <h2 class="l-display" style="font-size:22px;"><%= t("merchant.onboarding.s1_title") %></h2>
        <p style="color:var(--ink-2); font-size:14px; margin-bottom:16px;"><%= t("merchant.onboarding.s1_note") %></p>
        <%= form_with url: merchant_onboarding_path, method: :patch do %>
          <input type="hidden" name="step" value="1">
          <label class="l-label"><%= t("merchant.onboarding.palette") %></label>
          <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:16px;">
            <% @presets.each do |key, p| %>
              <% th = p['theme'] %>
              <label class="l-preset" style="cursor:pointer;">
                <input type="radio" name="preset" value="<%= key %>" <%= "checked" if @workspace.theme == th %> style="display:none;"
                       data-onboardpreview-target="radio" data-action="change->onboardpreview#apply"
                       data-primary="<%= th['primary'] %>" data-primary2="<%= th['primary_2'] %>"
                       data-surface="<%= th['surface'] %>" data-surface2="<%= th['surface_2'] %>"
                       data-ink="<%= th['ink'] %>" data-ink2="<%= th['ink_2'] %>" data-on-primary="<%= th['on_primary'] %>">
                <span class="sw"><span style="background:<%= th['primary'] %>"></span><span style="background:<%= th['primary_2'] %>"></span><span style="background:<%= th['surface_2'] %>"></span></span>
                <strong style="font-size:13px;"><%= p['label'] %></strong>
              </label>
            <% end %>
          </div>
          <label class="l-label"><%= t("merchant.onboarding.tagline") %></label>
          <%= text_field_tag "branding[tagline]", @workspace.branding_value("tagline"), class: "l-field", placeholder: t("merchant.onboarding.tagline_ph"), data: { onboardpreview_target: "tagline", action: "input->onboardpreview#syncText" } %>
          <label class="l-label" style="margin-top:12px;"><%= t("merchant.onboarding.customer_term") %></label>
          <%= text_field_tag "branding[customer_term]", @workspace.branding_value("customer_term"), class: "l-field", placeholder: t("merchant.onboarding.customer_term_ph") %>
          <%= submit_tag t("merchant.onboarding.continue"), class: "l-btn l-btn-primary", style: "margin-top:18px;" %>
        <% end %>
      </div>

      <%# ---- Live customer-app demo — recolors with the chosen palette ---- %>
      <div>
        <div class="l-eyebrow" style="margin-bottom:8px; text-align:center;"><%= t("merchant.onboarding.preview_label") %></div>
        <div data-onboardpreview-target="demo" class="l-appdemo">
          <div class="l-appdemo-card">
            <div class="l-appdemo-card-top">
              <span><%= @workspace.name.presence || "Cửa hàng của bạn" %></span>
              <span class="l-appdemo-tier">Vàng</span>
            </div>
            <div class="l-appdemo-pts">1.250 <small><%= t("merchant.onboarding.demo_points") %></small></div>
            <div class="l-appdemo-tagline" data-onboardpreview-target="taglineOut"><%= @workspace.branding_value("tagline").presence || t("merchant.onboarding.demo_tagline") %></div>
          </div>
          <div class="l-appdemo-row">
            <span class="l-appdemo-chip">🎁 <%= t("merchant.onboarding.demo_reward") %></span>
            <span class="l-appdemo-chip">⭐ 4.9</span>
          </div>
          <button type="button" class="l-appdemo-btn"><%= t("merchant.onboarding.demo_cta") %></button>
        </div>
      </div>
    </div>

  <% when 2 %>
    <div class="l-panel">
      <h2 class="l-display" style="font-size:22px;"><%= t("merchant.onboarding.s2_title") %></h2>
      <p style="color:var(--ink-2); font-size:14px; margin-bottom:16px;"><%= t("merchant.onboarding.s2_note") %></p>
      <%= form_with model: @program, url: merchant_onboarding_path, method: :patch do |f| %>
        <input type="hidden" name="step" value="2">
        <% [[:points_enabled, t("merchant.onboarding.m_points")], [:tiers_enabled, t("merchant.onboarding.m_tiers")], [:stamps_enabled, t("merchant.onboarding.m_stamps")], [:gamification_enabled, t("merchant.onboarding.m_gami")]].each do |attr, label| %>
          <div class="l-toggle-row"><span><%= label %></span>
            <label class="l-switch"><%= f.check_box attr %><span class="knob"></span></label>
          </div>
        <% end %>
        <label class="l-label" style="margin-top:14px;"><%= t("merchant.onboarding.earn_rate") %></label>
        <div style="display:flex; align-items:center; gap:8px;">
          <%= f.number_field :earn_points, class: "l-field", style: "max-width:90px;" %>
          <span style="color:var(--ink-2);"><%= t("merchant.onboarding.points_slash") %></span>
          <%= f.number_field :earn_per_amount, class: "l-field", style: "max-width:140px;" %>
          <span style="color:var(--ink-2);">đ</span>
        </div>
        <%= f.submit t("merchant.onboarding.continue"), class: "l-btn l-btn-primary", style: "margin-top:18px;" %>
      <% end %>
    </div>

  <% when 3 %>
    <div class="l-panel">
      <h2 class="l-display" style="font-size:22px;"><%= t("merchant.onboarding.s3_title") %></h2>
      <p style="color:var(--ink-2); font-size:14px; margin-bottom:16px;"><%= t("merchant.onboarding.s3_note") %></p>
      <%= form_with url: merchant_onboarding_path, method: :patch do %>
        <input type="hidden" name="step" value="3">
        <label class="l-label"><%= t("merchant.onboarding.staff_email") %></label>
        <%= email_field_tag :email, nil, class: "l-field", placeholder: t("merchant.staff.email_ph") %>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
          <div><label class="l-label"><%= t("merchant.onboarding.name") %></label><%= text_field_tag :name, nil, class: "l-field" %></div>
          <div><label class="l-label"><%= t("merchant.staff.role") %></label><%= select_tag :role, options_for_select([[t("merchant.roles.cashier"), "cashier"], [t("merchant.roles.staff"), "staff"], [t("merchant.roles.manager"), "manager"]], "cashier"), class: "l-field" %></div>
        </div>
        <div style="display:flex; gap:10px; margin-top:18px;">
          <%= button_to t("merchant.onboarding.skip_step"), merchant_onboarding_path(step: 3), method: :patch, params: { step: 3 }, class: "l-btn l-btn-ghost" %>
          <%= submit_tag t("merchant.onboarding.invite_continue"), class: "l-btn l-btn-primary", style: "flex:1;" %>
        </div>
      <% end %>
      <p style="color:var(--ink-2); font-size:12.5px; margin-top:16px; padding-top:14px; border-top:1px solid var(--line);">
        💡 <%= t("merchant.onboarding.staff_later") %>
      </p>
    </div>

  <% when 4 %>
    <div class="l-panel" style="text-align:center;" data-controller="pointburst">
      <div style="font-size:56px;">🎉</div>
      <h2 class="l-display" style="font-size:24px; margin-top:8px;"><%= t("merchant.onboarding.s4_title") %></h2>
      <p style="color:var(--ink-2); margin:8px 0 20px;"><%= t("merchant.onboarding.done_html", name: @workspace.name, host: "#{@workspace.subdomain}.loyalty.tiumpower.com").html_safe %></p>
      <div style="display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:20px;">
        <span class="l-chip"><%= t("merchant.onboarding.chip_brand") %></span>
        <span class="l-chip">✓ <%= [@program.points_enabled && "Điểm", @program.tiers_enabled && "Hạng", @program.stamps_enabled && "Tem", @program.gamification_enabled && "Game"].select(&:itself).join(" · ") %></span>
        <span class="l-chip"><%= t("merchant.onboarding.chip_staff", n: @workspace.memberships.count) %></span>
      </div>
      <%= form_with url: merchant_onboarding_path, method: :patch do %>
        <input type="hidden" name="step" value="4">
        <%= submit_tag t("merchant.onboarding.enter_dashboard"), class: "l-btn l-btn-primary l-btn-block" %>
      <% end %>
    </div>
  <% end %>
</div>
