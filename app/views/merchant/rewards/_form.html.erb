<%= form_with model: reward, url: url, method: method, multipart: true, data: { controller: "rewardform", turbo_frame: "_top",
      rewardform_vnd_label_value: t("merchant.reward_units.vnd_label"),
      rewardform_percent_label_value: t("merchant.reward_units.percent_label"),
      rewardform_item_label_value: t("merchant.reward_units.item_label"),
      rewardform_vnd_ph_value: t("merchant.reward_units.vnd_ph"),
      rewardform_percent_ph_value: t("merchant.reward_units.percent_ph"),
      rewardform_item_ph_value: t("merchant.reward_units.item_ph") } do |f| %>
  <% if reward.errors.any? %>
    <div class="l-note warn" style="margin-bottom:14px;">
      <%= ui_icon(:shield, size: 16) %><span><%= reward.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <%# The design edits in two columns: grouped sections on the left, and a phone
      showing what the customer ends up seeing on the right. %>
  <div class="m-editor">
    <div>
      <div class="m-section">
        <div class="hd">
          <div class="t"><%= t("merchant.rewards.sec_what") %></div>
          <div class="s"><%= t("merchant.rewards.sec_what_sub") %></div>
        </div>
  <label class="l-label"><%= t("merchant.rewards.name") %></label>
  <%= f.text_field :title, class: "l-field", placeholder: t("merchant.rewards.name_ph") %>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;">
    <div>
      <label class="l-label"><%= t("merchant.rewards.kind") %></label>
      <%= f.select :kind, [[t("merchant.rewards.kind_voucher"), "voucher"], [t("merchant.rewards.kind_gift"), "gift"], [t("merchant.rewards.kind_discount"), "discount"]], {},
            class: "l-field", data: { rewardform_target: "kind", action: "change->rewardform#kindChanged" } %>
    </div>
    <div data-controller="iconpick" style="position:relative;">
      <label class="l-label"><%= t("merchant.rewards.icon") %></label>
      <%= f.text_field :icon, class: "l-field", placeholder: "🎁",
            data: { iconpick_target: "input", action: "focus->iconpick#show click->iconpick#show" } %>
      <div class="l-iconpick" data-iconpick-target="panel" hidden>
        <% %w[🎁 ☕ 🧋 🍰 🥐 🍩 🍔 🍜 🥤 🍺 🎟️ 🏷️ 🛍️ 👜 ✨ 💆 ⭐ 🔥 🎉 💎].each do |e| %>
          <button type="button" class="l-iconpick-btn" data-action="iconpick#pick" data-emoji="<%= e %>"><%= e %></button>
        <% end %>
      </div>
    </div>
  </div>

  <%# Photo of the reward. The customer app leads with it in the catalogue,
      the wallet and the voucher; without one it falls back to the emoji above. %>
  <label class="l-label" style="margin-top:12px;"><%= t("merchant.rewards.image") %></label>
  <div style="display:flex; align-items:center; gap:14px;">
    <div style="width:74px; height:74px; border-radius:12px; flex:none; overflow:hidden; background:var(--surface-2);
                display:grid; place-items:center; font-size:30px;">
      <%= reward_art(reward, size: 160) %>
    </div>
    <div style="flex:1; min-width:0;">
      <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "l-field", style: "padding:10px 12px; font-size:13px;" %>
      <div style="font-size:12px; color:var(--ink-2); margin-top:6px;"><%= t("merchant.rewards.image_hint") %></div>
      <% if reward.image.attached? %>
        <label style="display:inline-flex; align-items:center; gap:7px; margin-top:8px; font-size:13px; color:var(--ink-2); cursor:pointer;">
          <%= f.check_box :remove_image, { style: "margin:0;" }, "1", "0" %> <%= t("merchant.rewards.image_remove") %>
        </label>
      <% end %>
    </div>
  </div>

      </div>

      <div class="m-section">
        <div class="hd">
          <div class="t"><%= t("merchant.rewards.sec_cost") %></div>
          <div class="s"><%= t("merchant.rewards.sec_cost_sub") %></div>
        </div>
  <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
    <div>
      <label class="l-label"><%= t("merchant.rewards.cost") %></label>
      <%= f.number_field :cost_points, class: "l-field", placeholder: "300" %>
    </div>
    <div>
      <label class="l-label" data-rewardform-target="valueLabel"><%= t("merchant.rewards.value") %></label>
      <%= f.number_field :value, class: "l-field", min: 0, step: "any", placeholder: "30",
            data: { rewardform_target: "value" } %>
    </div>
    <div>
      <label class="l-label"><%= t("merchant.rewards.unit") %></label>
      <%= f.select :value_unit, [["đ", "vnd"], ["%", "percent"], [t("merchant.rewards.unit_item"), "item"]], {},
            class: "l-field", data: { rewardform_target: "unit", action: "change->rewardform#syncLabel" } %>
    </div>
  </div>

  <div style="margin-top:12px;">
    <label class="l-label"><%= t("merchant.rewards.stock") %></label>
    <%= f.number_field :stock, class: "l-field", placeholder: "∞" %>
  </div>

      </div>

      <%# ---- Time: availability window + voucher validity ---- %>
      <div class="m-section">
        <div class="hd">
          <div class="t"><%= t("merchant.rewards.sec_time") %></div>
          <div class="s"><%= t("merchant.rewards.sec_time_sub") %></div>
        </div>
  <div data-controller="expirymode">
    <div style="font-size:15px; font-weight:800; color:var(--ink); text-transform:uppercase; letter-spacing:.04em; margin-bottom:10px;"><%= t("merchant.rewards.time_title") %></div>

    <%# 1) Availability window: when customers can redeem this offer %>
    <div style="font-weight:700; font-size:14px; color:var(--ink); margin-bottom:6px;"><%= t("merchant.rewards.avail_window") %></div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
      <div>
        <label class="l-sublabel" style="font-size:11.5px; color:var(--ink-2);"><%= t("merchant.rewards.sched_from") %></label>
        <%= f.datetime_local_field :starts_at, value: f.object.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "l-field" %>
      </div>
      <div>
        <label class="l-sublabel" style="font-size:11.5px; color:var(--ink-2);"><%= t("merchant.rewards.sched_to") %></label>
        <%= f.datetime_local_field :ends_at, value: f.object.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "l-field" %>
      </div>
    </div>
    <p style="color:var(--ink-2); font-size:11.5px; margin:5px 0 0;"><%= t("merchant.rewards.avail_hint") %></p>

    <%# 2) Voucher validity after claiming: relative (N days) or a fixed date %>
    <% fixed = f.object.expires_at.present? %>
    <div style="font-weight:700; font-size:14px; color:var(--ink); margin-top:16px; margin-bottom:2px;"><%= t("merchant.rewards.validity_title") %></div>
    <p style="color:var(--ink-2); font-size:12.5px; margin:0 0 10px;"><%= t("merchant.rewards.validity_hint") %></p>
    <div style="display:flex; flex-direction:column; gap:10px;">
      <label data-expirymode-target="relativeRow" style="display:flex; align-items:center; gap:8px; font-size:13.5px; transition:opacity .12s;">
        <input type="radio" name="reward[expiry_mode]" value="relative" <%= "checked" unless fixed %>
               data-expirymode-target="radio" data-action="expirymode#switch">
        <%= t("merchant.rewards.validity_relative_pre") %>
        <%= f.number_field :valid_days, value: (f.object.valid_days || 30), class: "l-field",
              style: "width:80px; padding:6px 8px;", data: { expirymode_target: "relativeInput" }, disabled: fixed %>
        <%= t("merchant.rewards.validity_relative_suf") %>
      </label>
      <label data-expirymode-target="fixedRow" style="display:flex; align-items:center; gap:8px; font-size:13.5px; flex-wrap:wrap; transition:opacity .12s;">
        <input type="radio" name="reward[expiry_mode]" value="fixed" <%= "checked" if fixed %>
               data-expirymode-target="radio" data-action="expirymode#switch">
        <%= t("merchant.rewards.validity_fixed_pre") %>
        <%= f.datetime_local_field :expires_at, value: f.object.expires_at&.strftime("%Y-%m-%dT%H:%M"), class: "l-field",
              style: "width:auto; padding:6px 8px;", data: { expirymode_target: "fixedInput" }, disabled: !fixed %>
      </label>
    </div>

    <label class="l-label" style="margin-top:14px;"><%= t("merchant.rewards.sched_days") %></label>
    <% windows = f.object.schedule_windows %>
    <% windows = [{}] if windows.empty? %>
    <div data-controller="schedwindows">
      <div data-schedwindows-target="list" style="display:flex; flex-direction:column; gap:10px;">
        <% windows.each_with_index do |w, i| %>
          <%= render "merchant/rewards/window_row", w: w, idx: i %>
        <% end %>
      </div>
      <template data-schedwindows-target="template">
        <%= render "merchant/rewards/window_row", w: {}, idx: "IDX" %>
      </template>
      <button type="button" data-action="schedwindows#add" class="l-btn l-btn-soft" style="margin-top:10px; font-size:13px;">
        ➕ <%= t("merchant.rewards.sched_add_window") %>
      </button>
    </div>
    <p style="color:var(--ink-2); font-size:12px; margin-top:8px;"><%= t("merchant.rewards.sched_hint") %></p>
  </div>

      </div>

      <div class="m-section">
        <div class="hd">
          <div class="t"><%= t("merchant.rewards.sec_copy") %></div>
          <div class="s"><%= t("merchant.rewards.sec_copy_sub") %></div>
        </div>
  <label class="l-label"><%= t("merchant.rewards.description") %></label>
  <%= f.text_area :description, class: "l-field", rows: 2, placeholder: t("merchant.rewards.description_ph") %>

      </div>

      <div class="m-savebar">
        <label style="display:flex; align-items:center; gap:8px; font-size:14px; flex:1; min-width:180px;">
          <%= f.check_box :active %> <%= t("merchant.rewards.active") %>
        </label>
        <%= f.submit submit_label, class: "l-btn l-btn-primary", style: "flex:none;" %>
      </div>
    </div>

    <%# ---- What the customer will see ---- %>
    <div>
      <div class="m-previewlabel"><%= t("merchant.rewards.preview_label") %></div>
      <div class="m-phone">
        <div class="scr">
          <div class="art"><%= reward_art(reward, size: 420, emoji_size: 38, ratio: 16.0 / 10) %></div>
          <div class="bd">
            <div class="tt"><%= reward.title.presence || t("merchant.rewards.preview_untitled") %></div>
            <% if reward.description.present? %>
              <div class="ds"><%= truncate(reward.description, length: 90) %></div>
            <% end %>
            <div style="display:flex; align-items:center; gap:8px; margin-top:10px; flex-wrap:wrap;">
              <% if reward.cost_points.to_i.positive? %>
                <span class="l-chip l-chip-brand" style="font-size:11.5px;"><%= t("merchant.rewards.points_n", n: number_with_delimiter(reward.cost_points)) %></span>
              <% end %>
              <% if reward.persisted? && reward.value.to_i.positive? %>
                <span class="l-chip" style="font-size:11.5px;"><%= reward.value_label %></span>
              <% end %>
            </div>
            <div class="cta"><%= t("customer.reward.redeem_cta") %></div>
          </div>
        </div>
      </div>
      <p style="font-size:12px; color:var(--ink-2); line-height:1.5; margin-top:10px;">
        <%= t("merchant.rewards.preview_note") %>
      </p>
    </div>
  </div>
<% end %>
