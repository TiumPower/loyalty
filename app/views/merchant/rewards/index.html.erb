<% content_for :title, t("merchant.nav.rewards") %>
<% content_for :title_en, "REWARDS" %>

<div data-controller="modal">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px; flex-wrap:wrap;">
    <p style="color:var(--ink-2); font-size:14px; max-width:560px; margin:0;"><%= t("merchant.rewards.intro") %></p>
    <%= link_to new_merchant_reward_path, class: "l-btn l-btn-primary", style: "white-space:nowrap;",
          data: { turbo_frame: "reward_form", action: "modal#open" } do %>
      ＋ <%= t("merchant.rewards.add") %>
    <% end %>
  </div>

  <% filtering = @q.present? || @kind.present? || @status.present? %>

  <%# ---- Search + filters ---- %>
  <% if filtering || @rewards.any? %>
    <%= form_with url: merchant_rewards_path, method: :get, data: { turbo: false } do %>
      <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
        <input type="search" name="q" value="<%= @q %>" placeholder="<%= t('merchant.rewards.search_ph') %>"
               class="l-field" style="flex:1; min-width:200px;">
        <select name="kind" class="l-field" style="max-width:180px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.rewards.kind') %>">
          <option value=""><%= t('merchant.rewards.all_kinds') %></option>
          <option value="voucher"  <%= 'selected' if @kind == 'voucher' %>>🎟️ Voucher</option>
          <option value="gift"     <%= 'selected' if @kind == 'gift' %>>🎁 <%= t('merchant.rewards.kind_gift') %></option>
          <option value="discount" <%= 'selected' if @kind == 'discount' %>>🏷️ <%= t('merchant.rewards.kind_discount') %></option>
        </select>
        <select name="status" class="l-field" style="max-width:170px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.rewards.all_status') %>">
          <option value=""><%= t('merchant.rewards.all_status') %></option>
          <option value="active"   <%= 'selected' if @status == 'active' %>><%= t('merchant.rewards.status_active') %></option>
          <option value="inactive" <%= 'selected' if @status == 'inactive' %>><%= t('merchant.rewards.status_inactive') %></option>
        </select>
        <%= submit_tag "🔍", class: "l-btn l-btn-soft", style: "flex:none;" %>
      </div>
    <% end %>
  <% end %>

  <% if @rewards.empty? && filtering %>
    <div class="l-panel" style="text-align:center; padding:40px; color:var(--ink-2);">
      <div style="font-size:40px;">🔍</div>
      <p style="font-weight:600; margin-top:8px; color:var(--ink);"><%= t("merchant.rewards.no_matches") %></p>
      <p style="font-size:13px;"><%= t("merchant.rewards.no_matches_sub") %></p>
    </div>
  <% elsif @rewards.empty? %>
    <div class="l-panel" style="text-align:center; padding:48px 40px; color:var(--ink-2);">
      <div style="font-size:44px;">🎁</div>
      <p style="font-weight:600; margin-top:8px; color:var(--ink);"><%= t("merchant.rewards.empty") %></p>
      <p style="font-size:13px;"><%= t("merchant.rewards.empty_sub") %></p>
      <%= link_to new_merchant_reward_path, class: "l-btn l-btn-primary", style: "margin-top:16px;",
            data: { turbo_frame: "reward_form", action: "modal#open" } do %>
        ＋ <%= t("merchant.rewards.add") %>
      <% end %>
    </div>
  <% else %>
    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:14px;">
      <% @rewards.each do |r| %>
        <div class="l-panel" style="padding:16px; <%= 'opacity:.55;' unless r.active? %>">
          <div style="display:flex; align-items:center; gap:10px;">
            <span style="font-size:26px;"><%= r.display_icon %></span>
            <div style="flex:1; min-width:0;">
              <div style="font-weight:700;"><%= r.title %></div>
              <div style="font-size:12px; color:var(--ink-2);"><%= r.value_label %> · <%= r.kind_label %></div>
            </div>
            <span class="l-chip" style="font-size:11px; flex:none; <%= r.active? ? 'background:var(--good-soft,#DEEBE1); color:var(--good);' : 'color:var(--ink-2);' %>">
              <%= r.active? ? t("merchant.rewards.status_active") : t("merchant.rewards.status_inactive") %>
            </span>
          </div>
          <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
            <% if r.cost_points %><span class="l-chip l-chip-brand"><%= t("merchant.rewards.points_n", n: number_with_delimiter(r.cost_points)) %></span><% end %>
            <span class="l-chip"><%= r.stock.nil? ? "∞" : r.remaining %> <%= t("merchant.rewards.uses") %></span>
            <span class="l-chip"><%= t("merchant.rewards.redeemed", n: r.vouchers.count) %></span><span class="l-chip"><%= t("merchant.rewards.used", n: r.vouchers.where(state: "used").count) %></span>
            <% if r.schedule_summary %><span class="l-chip" style="background:var(--primary)18; color:var(--primary-ink);">🕒 <%= r.schedule_summary %></span><% end %>
          </div>
          <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
            <%= link_to t("merchant.rewards.edit"), edit_merchant_reward_path(r), class: "l-btn l-btn-ghost",
                  style: "padding:6px 12px; font-size:13px;", data: { turbo_frame: "reward_form", action: "modal#open" } %>
            <%= button_to (r.active? ? t("merchant.rewards.turn_off") : t("merchant.rewards.turn_on")),
                  toggle_merchant_reward_path(r, request.query_parameters), method: :patch,
                  class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px;", form: { style: "display:inline; margin:0;" } %>
            <%= button_to t("merchant.rewards.delete"), merchant_reward_path(r), method: :delete, form: { data: { turbo_confirm: t("merchant.rewards.delete_confirm") } },
                  class: "l-btn l-btn-ghost", style: "padding:6px 12px; font-size:13px; color:var(--warn);" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <dialog class="l-modal" data-modal-target="dialog" data-action="click->modal#backdrop">
    <%= turbo_frame_tag "reward_form", data: { modal_target: "frame" } do %>
      <div class="l-modal-loading"><%= t("merchant.rewards.loading") %></div>
    <% end %>
  </dialog>
</div>
