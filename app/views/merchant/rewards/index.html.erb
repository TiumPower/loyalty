<% content_for :title, t("merchant.nav.rewards") %>
<% content_for :title_en, "REWARDS" %>

<div data-controller="modal">
  <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px; flex-wrap:wrap;">
    <p style="color:var(--ink-2); font-size:14px; max-width:560px; margin:0;"><%= t("merchant.rewards.intro") %></p>
    <%= link_to new_merchant_reward_path, class: "l-btn l-btn-primary", style: "white-space:nowrap;",
          data: { turbo_frame: "reward_form", action: "modal#open" } do %>
      ＋ <%= t("merchant.rewards.add") %>
    <% end %>
  </div>

  <% filtering = @q.present? || @kind.present? || @status.present? %>

  <%# ---- Search + filters ---- %>
  <% if filtering || @rewards.any? %>
    <%= form_with url: merchant_rewards_path, method: :get, data: { turbo: false } do %>
      <div style="display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
        <input type="search" name="q" value="<%= @q %>" placeholder="<%= t('merchant.rewards.search_ph') %>"
               class="l-field" style="flex:1; min-width:200px;">
        <select name="kind" class="l-field" style="max-width:180px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.rewards.kind') %>">
          <option value=""><%= t('merchant.rewards.all_kinds') %></option>
          <option value="voucher"  <%= 'selected' if @kind == 'voucher' %>>🎟️ Voucher</option>
          <option value="gift"     <%= 'selected' if @kind == 'gift' %>>🎁 <%= t('merchant.rewards.kind_gift') %></option>
          <option value="discount" <%= 'selected' if @kind == 'discount' %>>🏷️ <%= t('merchant.rewards.kind_discount') %></option>
        </select>
        <select name="status" class="l-field" style="max-width:170px;" onchange="this.form.requestSubmit()" aria-label="<%= t('merchant.rewards.all_status') %>">
          <option value=""><%= t('merchant.rewards.all_status') %></option>
          <option value="active"   <%= 'selected' if @status == 'active' %>><%= t('merchant.rewards.status_active') %></option>
          <option value="inactive" <%= 'selected' if @status == 'inactive' %>><%= t('merchant.rewards.status_inactive') %></option>
        </select>
        <%= submit_tag "🔍", class: "l-btn l-btn-soft", style: "flex:none;" %>
      </div>
    <% end %>
  <% end %>

  <% if @rewards.empty? && filtering %>
    <div class="l-panel" style="text-align:center; padding:40px; color:var(--ink-2);">
      <div style="font-size:40px;">🔍</div>
      <p style="font-weight:600; margin-top:8px; color:var(--ink);"><%= t("merchant.rewards.no_matches") %></p>
      <p style="font-size:13px;"><%= t("merchant.rewards.no_matches_sub") %></p>
    </div>
  <% elsif @rewards.empty? %>
    <div class="l-panel" style="text-align:center; padding:48px 40px; color:var(--ink-2);">
      <div style="font-size:44px;">🎁</div>
      <p style="font-weight:600; margin-top:8px; color:var(--ink);"><%= t("merchant.rewards.empty") %></p>
      <p style="font-size:13px;"><%= t("merchant.rewards.empty_sub") %></p>
      <%= link_to new_merchant_reward_path, class: "l-btn l-btn-primary", style: "margin-top:16px;",
            data: { turbo_frame: "reward_form", action: "modal#open" } do %>
        ＋ <%= t("merchant.rewards.add") %>
      <% end %>
    </div>
  <% else %>
    <%# ---- The design's compact list: one row per reward, sized for scanning
          a whole catalogue rather than reading one card at a time. ---- %>
    <div class="l-panel" style="padding:0;">
      <div style="display:flex; align-items:center; gap:14px; padding:16px 18px; border-bottom:1px solid var(--line);">
        <div style="flex:1; min-width:0;">
          <div style="font-weight:700; font-size:15px;"><%= t("merchant.rewards.list_title") %></div>
          <div style="font-size:12.5px; color:var(--ink-2); margin-top:2px;"><%= t("merchant.rewards.list_sub") %></div>
        </div>
        <span class="m-badge"><%= t("merchant.rewards.n_rewards", n: @rewards.size) %></span>
      </div>

      <div style="overflow-x:auto;">
        <table class="m-table" style="min-width:900px;">
          <thead>
            <tr>
              <th style="padding-left:18px;"><%= t("merchant.rewards.col_reward") %></th>
              <th><%= t("merchant.rewards.col_status") %></th>
              <th><%= t("merchant.rewards.col_cost") %></th>
              <th><%= t("merchant.rewards.col_stock") %></th>
              <th><%= t("merchant.rewards.col_usage") %></th>
              <th style="padding-right:18px;"></th>
            </tr>
          </thead>
          <tbody>
            <% @rewards.each do |r| %>
              <% state = r.redeem_state %>
              <% low = r.remaining && r.remaining.positive? && r.remaining <= Merchant::RewardsController::LOW_STOCK %>
              <% c = @voucher_counts[r.id] || { issued: 0, used: 0 } %>
              <tr style="<%= 'opacity:.6;' unless r.active? %>">
                <td style="padding-left:18px;">
                  <div style="display:flex; align-items:center; gap:11px;">
                    <span style="width:40px; height:40px; border-radius:11px; flex:none; overflow:hidden; background:var(--surface-2); display:grid; place-items:center; font-size:19px;">
                      <%= reward_art(r, size: 120, emoji_size: 19) %>
                    </span>
                    <div style="min-width:0;">
                      <div style="font-weight:600;"><%= r.title %></div>
                      <div style="font-size:12px; color:var(--ink-2);"><%= r.value_label %> · <%= r.kind_label %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <% if !r.active? %>
                    <span class="m-badge"><%= t("merchant.rewards.status_inactive") %></span>
                  <% elsif state == :open %>
                    <span class="m-badge up"><%= t("merchant.rewards.status_active") %></span>
                  <% else %>
                    <%# On, but customers still cannot redeem it — the card used
                        to look healthy and say nothing. %>
                    <span class="m-badge down"><%= t("merchant.rewards.state_#{state}") %></span>
                  <% end %>
                </td>
                <td class="m-num"><%= r.cost_points ? number_with_delimiter(r.cost_points) : "—" %></td>
                <td>
                  <span class="m-num" style="<%= 'color:var(--warn);' if state == :out_of_stock %><%= 'color:var(--amber);' if low %>">
                    <%= r.stock.nil? ? "∞" : r.remaining %>
                  </span>
                  <span style="color:var(--ink-2); font-size:12px;"><%= t("merchant.rewards.uses") %></span>
                </td>
                <td style="font-size:12.5px; color:var(--ink-2);">
                  <%= t("merchant.rewards.redeemed", n: c[:issued]) %> · <%= t("merchant.rewards.used", n: c[:used]) %>
                  <% if r.schedule_summary %><div style="font-size:12px;">🕒 <%= r.schedule_summary %></div><% end %>
                </td>
                <td style="padding-right:18px; white-space:nowrap;">
                  <%= link_to t("merchant.rewards.edit"), edit_merchant_reward_path(r), class: "l-btn l-btn-ghost",
                        style: "padding:5px 12px; font-size:12.5px;", data: { turbo_frame: "reward_form", action: "modal#open" } %>
                  <%= button_to (r.active? ? t("merchant.rewards.turn_off") : t("merchant.rewards.turn_on")),
                        toggle_merchant_reward_path(r, request.query_parameters), method: :patch,
                        class: "l-btn l-btn-ghost", style: "padding:5px 12px; font-size:12.5px;", form: { style: "display:inline; margin:0;" } %>
                  <%= button_to t("merchant.rewards.delete"), merchant_reward_path(r), method: :delete,
                        form: { data: { turbo_confirm: t("merchant.rewards.delete_confirm") }, style: "display:inline; margin:0;" },
                        class: "l-btn l-btn-ghost", style: "padding:5px 12px; font-size:12.5px; color:var(--warn);" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div style="padding:14px 18px; border-top:1px solid var(--line); font-size:12.5px; color:var(--ink-2);">
        <%= t("merchant.rewards.list_footer", n: @rewards.size) %>
      </div>
    </div>
  <% end %>

  <dialog class="l-modal" data-modal-target="dialog" data-action="click->modal#backdrop">
    <%= turbo_frame_tag "reward_form", data: { modal_target: "frame" } do %>
      <div class="l-modal-loading"><%= t("merchant.rewards.loading") %></div>
    <% end %>
  </dialog>
</div>
