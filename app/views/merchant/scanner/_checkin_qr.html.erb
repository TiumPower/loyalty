<%# Branch check-in QR (standalone screen, peer of the scanner). Owner may pick
    any branch; manager/staff see only their own (scoped in the controller). %>
<% if @qr_outlet.nil? %>
  <div style="text-align:center; padding:40px 16px; color:var(--ink-2);">
    <div style="font-size:34px;">🏬</div>
    <p style="font-weight:600; color:var(--ink); margin-top:8px;"><%= t("merchant.scan.checkin_none") %></p>
    <p style="font-size:13px;"><%= t("merchant.scan.checkin_none_sub") %></p>
  </div>
<% else %>
  <% checkin_url = customer_scan_url(current_workspace, checkin: Checkin.encode(current_workspace, @qr_outlet)) %>
  <div style="text-align:center; max-width:420px; margin:0 auto;">
    <% if @qr_outlets.size > 1 %>
      <%= form_with url: merchant_scanner_checkin_qr_path, method: :get, data: { turbo: false }, style: "margin-bottom:16px;" do %>
        <label class="l-label"><%= t("merchant.scan.checkin_pick_branch") %></label>
        <select name="qr_outlet" class="l-field" onchange="this.form.requestSubmit()">
          <% @qr_outlets.each do |o| %>
            <option value="<%= o.id %>" <%= "selected" if @qr_outlet.id == o.id %>><%= o.name %></option>
          <% end %>
        </select>
      <% end %>
    <% end %>

    <div class="l-eyebrow" style="margin-bottom:2px;"><%= t("merchant.outlets.checkin_title") %></div>
    <h3 class="l-display" style="font-size:22px; margin:2px 0 4px;"><%= @qr_outlet.name %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:16px;"><%= t("merchant.scan.checkin_show_hint") %></p>

    <div style="display:inline-block; padding:18px; background:#fff; border-radius:20px; box-shadow:var(--shadow);">
      <%= qr_svg(checkin_url, size: 260) %>
    </div>

    <%# The poster carries a static token, so rotating the nonce is the only way
        to kill a QR that has been photographed and shared. It had no entry
        point anywhere in the app. Managers only — it revokes every branch. %>
    <% if current_membership&.can_manage? %>
      <div style="margin-top:22px; padding-top:16px; border-top:1px solid var(--line);">
        <p style="color:var(--ink-2); font-size:12.5px; margin-bottom:10px;">
          <%= t("merchant.scan.checkin_rotate_note") %>
        </p>
        <%= button_to t("merchant.scan.checkin_rotate"), merchant_rotate_checkin_path,
                      method: :post, class: "l-btn l-btn-soft",
                      form: { data: { turbo_confirm: t("merchant.scan.checkin_rotate_confirm") } } %>
      </div>
    <% end %>
  </div>
<% end %>
