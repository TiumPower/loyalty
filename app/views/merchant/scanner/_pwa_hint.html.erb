<%# Collapsible "install as an app" guidance for staff scanning phones.
    Keeping the launcher on the home screen means one tap to the scanner and a
    session that survives app switches. Steps differ per platform (iOS Safari vs
    Android Chrome), so we show both. %>
<details data-controller="pwahint" style="margin-top:22px; width:100%; text-align:left;
                border:1px solid var(--line); border-radius:16px; background:var(--card, #fff); overflow:hidden;">
  <summary style="list-style:none; cursor:pointer; padding:14px 16px; font-weight:700; font-size:14px;
                  display:flex; align-items:center; gap:10px;">
    <span style="font-size:18px;">📲</span>
    <span style="flex:1;"><%= t("merchant.scan.pwa_title") %></span>
    <span style="color:var(--ink-2); font-size:12px;">▾</span>
  </summary>
  <div style="padding:2px 16px 16px;">
    <p style="font-size:12.5px; color:var(--ink-2); margin:0 0 12px;"><%= t("merchant.scan.pwa_intro") %></p>

    <div style="font-weight:700; font-size:12.5px; margin-bottom:4px;"><%= t("merchant.scan.pwa_ios") %></div>
    <ol style="margin:0 0 12px; padding-left:18px; font-size:12.5px; color:var(--ink-2); line-height:1.6;">
      <li><%= t("merchant.scan.pwa_ios_1") %></li>
      <li><%= t("merchant.scan.pwa_ios_2") %></li>
      <li><%= t("merchant.scan.pwa_ios_3") %></li>
    </ol>

    <div style="font-weight:700; font-size:12.5px; margin-bottom:4px;"><%= t("merchant.scan.pwa_android") %></div>
    <ol style="margin:0; padding-left:18px; font-size:12.5px; color:var(--ink-2); line-height:1.6;">
      <li><%= t("merchant.scan.pwa_android_1") %></li>
      <li><%= t("merchant.scan.pwa_android_2") %></li>
    </ol>
  </div>
</details>
