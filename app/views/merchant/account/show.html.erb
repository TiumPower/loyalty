<% content_for :title, t("merchant.nav.account") %>
<% content_for :title_en, "ACCOUNT" %>

<div style="max-width:560px;">
  <% if @user.errors.any? %>
    <div style="background:#F7E0DA; color:#B4402F; border-radius:12px; padding:11px 14px; font-size:14px; margin-bottom:16px;">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="l-panel" style="margin-bottom:16px;">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= t("merchant.account.info") %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:16px;"><%= t("merchant.account.email_role", email: @user.email, role: current_membership&.label) %></p>
    <%# The email is the login identifier and is not editable here; saying so
        beats leaving someone hunting for a field that does not exist. %>
    <p style="color:var(--ink-2); font-size:12.5px; margin:-8px 0 14px;"><%= t("merchant.account.email_fixed") %></p>
    <%= form_with model: @user, url: merchant_account_path, method: :patch do |f| %>
      <label class="l-label"><%= t("merchant.account.display_name") %></label>
      <%= f.text_field :name, class: "l-field", placeholder: t("merchant.account.name_ph") %>
      <%= f.submit t("merchant.account.save_name"), class: "l-btn l-btn-primary", style: "margin-top:14px;" %>
    <% end %>
  </div>

  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= t("merchant.account.change_password") %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:16px;"><%= t("merchant.account.pw_note") %></p>
    <%= form_with model: @user, url: merchant_account_path, method: :patch, html: { autocomplete: "off" } do |f| %>
      <div class="m-field">
        <label class="l-label"><%= t("merchant.account.current_pw") %></label>
        <%= f.password_field :current_password, class: "l-field", autocomplete: "current-password" %>
      </div>
      <div class="m-field">
        <label class="l-label"><%= t("merchant.account.new_pw") %></label>
        <%= f.password_field :password, class: "l-field", autocomplete: "new-password", placeholder: t("merchant.account.new_pw_ph") %>
      </div>
      <div class="m-field">
        <label class="l-label"><%= t("merchant.account.confirm_pw") %></label>
        <%= f.password_field :password_confirmation, class: "l-field", autocomplete: "new-password" %>
      </div>
      <%= f.submit t("merchant.account.save_pw"), class: "l-btn l-btn-primary", style: "margin-top:6px;" %>
    <% end %>
  </div>

  <%# ---- Quick login on phone (self-login QR → mobile scanner) ---- %>
  <div class="l-panel" style="margin-top:16px; text-align:center;"
       data-controller="qrrefresh" data-qrrefresh-url-value="<%= merchant_quick_login_qr_path %>">
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= t("merchant.quick_login.title") %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px; max-width:360px; margin-left:auto; margin-right:auto;"><%= t("merchant.quick_login.note") %></p>
    <div data-qrrefresh-target="box" style="display:inline-block; padding:12px; background:#fff; border:1px solid var(--line); border-radius:16px;">
      <%= qr_svg(merchant_quick_login_url(token: StaffLogin.encode(current_user, current_workspace), host: request.host_with_port), size: 180) %>
    </div>
    <p style="color:var(--ink-3); font-size:11.5px; margin-top:10px;"><%= t("merchant.quick_login.expiry_hint", min: (StaffLogin::TTL / 60).to_i) %></p>
  </div>

  <%# Sign-out lived only in the sidebar, which is a drawer on phones — the
      account page is where people look for it. %>
  <div class="l-panel" style="margin-top:16px;">
    <%= button_to t("merchant.nav.logout", default: "Đăng xuất"), destroy_user_session_path, method: :delete,
          class: "l-btn l-btn-ghost l-btn-block", style: "color:#B4402F;",
          form: { data: { turbo: false, turbo_confirm: t("merchant.nav.logout_confirm") } } %>
  </div>
</div>
