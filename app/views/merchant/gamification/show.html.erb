<% content_for :title, t("merchant.nav.gamification") %>
<% content_for :title_en, "GAMES" %>

<% unless @program.gamification_enabled %>
  <div class="l-panel" style="margin-bottom:16px; display:flex; align-items:center; gap:12px;">
    <span style="font-size:22px;">⚠️</span>
    <div style="flex:1;"><%= t("merchant.gami.disabled") %></div>
    <%= link_to t("merchant.gami.enable_now"), merchant_loyalty_program_path, class: "l-btn l-btn-soft" %>
  </div>
<% end %>

<div data-controller="tabs" data-tabs-key-value="gamification">
  <%# ---- Tab bar ---- %>
  <style>
    /* Make the active gamification tab clearly stand out (solid primary pill). */
    [role="tablist"] .l-chip-brand{
      background:var(--primary); color:var(--on-primary,#fff); font-weight:700;
      box-shadow:0 6px 16px -6px var(--primary);
    }
    [role="tablist"] .l-chip-brand:hover{ background:var(--primary); color:var(--on-primary,#fff); }
  </style>
  <div role="tablist" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
    <% [["stamps", t("merchant.gami.stamps")], ["missions", t("merchant.gami.missions")],
        ["badges", t("merchant.gami.badges")], ["wheel", t("merchant.gami.wheel")]].each do |key, label| %>
      <button type="button" class="l-chip" data-tabs-target="tab" data-tab="<%= key %>"
              data-action="tabs#select" style="cursor:pointer; border:none; font-size:14px; padding:9px 16px;">
        <%= label %>
      </button>
    <% end %>
  </div>

  <%# ---- Stamp cards ---- %>
  <div class="l-panel" data-tabs-target="panel" data-tab="stamps">
    <h3 class="l-display" style="font-size:18px; margin-bottom:10px;"><%= t("merchant.gami.stamps") %></h3>
    <%= render "merchant/gamification/reward_source", context: :stamp %>
    <style>
      /* Shared "saved item" card look for stamp cards & missions (created rows vs the new-item form) */
      .stampcard,.taskcard{border:1px solid var(--line); border-radius:14px; background:var(--surface); margin-bottom:10px;
        transition:border-color .15s, background .15s, box-shadow .15s;}
      .stampcard>summary,.taskcard>summary{display:flex; align-items:center; gap:10px; padding:12px; cursor:pointer; list-style:none;}
      .stampcard>summary::-webkit-details-marker,.taskcard>summary::-webkit-details-marker{display:none;}
      .stampcard[open],.taskcard[open]{border-color:var(--primary); background:var(--primary-soft);
        box-shadow:0 8px 22px -14px var(--primary);}
      .stampcard .sc-body,.taskcard .sc-body{padding:0 12px 12px;}
      .sc-del{border:none; background:transparent; color:var(--ink-2); cursor:pointer; font-size:16px; line-height:1;
        padding:6px 8px; border-radius:9px; transition:background .12s, color .12s;}
      .sc-del:hover{background:color-mix(in srgb, var(--warn) 12%, #fff); color:var(--warn);}
      .sc-new{border-top:1px dashed var(--line); margin-top:16px; padding-top:14px;}
    </style>
    <% @stamp_cards.each do |c| %>
      <details class="stampcard" data-controller="stamptoggle"
               data-stamptoggle-url-value="<%= toggle_merchant_stamp_card_path(c) %>"
               data-stamptoggle-active-value="<%= c.active? %>"
               data-stamptoggle-run-value="<%= t("merchant.gami.stamp_run") %>"
               data-stamptoggle-pause-value="<%= t("merchant.gami.stamp_pause") %>"
               data-stamptoggle-working-value="<%= t("merchant.gami.stamp_toggling") %>">
        <summary>
          <span style="font-size:20px;"><%= c.display_icon %></span>
          <div style="flex:1;">
            <strong><%= c.title %></strong>
            <span class="l-chip" data-stamptoggle-target="chip" <%= "hidden" if c.active? %>
                  style="font-size:10px; margin-left:6px; background:var(--surface-2);">⏸ <%= t("merchant.gami.stamp_paused") %></span>
            <div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.gami.stamp_desc", n: c.target_count, reward: c.reward&.title || "—") %></div>
          </div>
          <%# Pause/run is one click and saves on its own — it used to be a
              checkbox that only took effect when the whole card was saved. %>
          <button type="button" data-stamptoggle-target="button" data-action="stamptoggle#toggle"
                  class="l-btn <%= c.active? ? "l-btn-soft" : "l-btn-primary" %>"
                  style="padding:5px 12px; font-size:12px; white-space:nowrap;">
            <%= c.active? ? t("merchant.gami.stamp_pause") : t("merchant.gami.stamp_run") %>
          </button>
          <span class="l-chip" style="font-size:11px;"><%= t("merchant.gami.edit_chip") %></span>
          <%= button_to "🗑", merchant_stamp_card_path(c), method: :delete, class: "sc-del",
                title: t("merchant.gami.delete_stamp"),
                form: { data: { turbo_confirm: t("merchant.gami.delete_stamp_confirm") }, style: "display:inline; margin:0;" } %>
        </summary>
        <div class="sc-body">
          <%= form_with model: c, url: merchant_stamp_card_path(c), method: :patch, scope: :stamp_card do |f| %>
            <%= f.text_field :title, class: "l-field", style: "margin:4px 0 8px;" %>
            <div style="display:grid; grid-template-columns:80px 1fr; gap:8px;">
              <%= f.number_field :target_count, class: "l-field" %>
              <%= f.select :reward_id, @rewards.map { |r| [reward_option_label(r), r.id] }, { include_blank: t("merchant.gami.reward_blank") }, class: "l-field" %>
            </div>
            <div style="margin-top:8px;"><%= render "merchant/shared/icon_field", name: "stamp_card[icon]", value: c.icon, placeholder: "🧋" %></div>
            <%# Tạm dừng / Chạy đã có nút riêng ở hàng tiêu đề (lưu ngay). %>
            <div style="display:flex; gap:8px; margin:12px 0 4px;">
              <%= f.submit t("merchant.gami.save"), class: "l-btn l-btn-primary" %>
              <button type="button" class="l-btn l-btn-ghost" onclick="this.closest('details').open=false"><%= t("merchant.gami.collapse") %></button>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <div class="sc-new">
      <div class="l-eyebrow" style="margin-bottom:8px;"><%= t("merchant.gami.stamp_new") %></div>
      <%= form_with url: merchant_stamp_cards_path, method: :post, scope: :stamp_card do |f| %>
        <input type="text" name="stamp_card[title]" class="l-field" placeholder="<%= t("merchant.gami.stamp_title_ph") %>">
        <div style="display:grid; grid-template-columns:80px 1fr; gap:8px; margin-top:8px;">
          <%= f.number_field :target_count, value: 9, class: "l-field", placeholder: t("merchant.gami.num") %>
          <%= f.select :reward_id, @rewards.map { |r| [reward_option_label(r), r.id] }, { include_blank: t("merchant.gami.reward_blank") }, class: "l-field" %>
        </div>
        <div style="margin-top:8px;"><%= render "merchant/shared/icon_field", name: "stamp_card[icon]", placeholder: "🧋" %></div>
        <%= f.hidden_field :active, value: true %>
        <%= f.submit t("merchant.gami.add_stamp"), class: "l-btn l-btn-primary", style: "margin-top:10px;" %>
      <% end %>
    </div>
  </div>

  <%# ---- Missions ---- %>
  <div class="l-panel" data-tabs-target="panel" data-tab="missions" hidden>
    <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px;">
      <h3 class="l-display" style="font-size:18px; margin:0;"><%= t("merchant.gami.missions") %></h3>
      <% pending = MissionProgress.where(mission_id: current_workspace.missions.where(mission_type: Mission::PHOTO_PROOF_TYPES).select(:id), approval_status: "pending").count %>
      <%= link_to merchant_mission_submissions_path, class: "l-btn l-btn-soft", style: "padding:6px 12px; font-size:13px; white-space:nowrap;" do %>
        📋 <%= t("merchant.gami.review_queue") %><%= " · #{pending}" if pending.positive? %>
      <% end %>
    </div>
    <% @missions.each do |m| %>
      <details class="taskcard">
        <summary>
          <span style="font-size:20px;"><%= mission_icon(m, size: 22) %></span>
          <div style="flex:1;">
            <strong><%= m.title %></strong>
            <% unless m.active? %><span class="l-chip" style="font-size:10px; margin-left:6px; background:var(--surface-2);">⏸ <%= t("merchant.gami.stamp_paused") %></span><% end %>
            <div style="font-size:12px; color:var(--ink-2);"><%= t("merchant.gami.period_#{m.period}", default: m.period) %> · <%= t("merchant.gami.points_plus", n: m.reward_points) %></div>
          </div>
          <span class="l-chip" style="font-size:11px;"><%= t("merchant.gami.edit_chip") %></span>
          <%= button_to "🗑", merchant_mission_path(m), method: :delete, class: "sc-del",
                title: t("merchant.gami.delete_mission"),
                form: { data: { turbo_confirm: t("merchant.gami.delete_mission_confirm") }, style: "display:inline; margin:0;" } %>
        </summary>
        <div class="sc-body">
          <%= form_with model: m, url: merchant_mission_path(m), method: :patch, scope: :mission,
                data: { controller: "missionform" } do |f| %>
            <div style="display:grid; grid-template-columns:1fr auto; gap:8px; align-items:start;">
              <%= f.text_field :title, class: "l-field", placeholder: t("merchant.gami.mission_title_ph") %>
              <div style="width:120px;"><%= render "merchant/shared/icon_field", name: "mission[icon]", value: m.icon, placeholder: "🎯" %></div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
              <%= f.select :mission_type,
                    [["Check-in", "checkin"], [t("merchant.gami.mtype_spend"), "spend"], [t("merchant.gami.mtype_visit"), "visit"],
                     [t("merchant.gami.mtype_review"), "review"], [t("merchant.gami.mtype_social"), "social_share"]],
                    {}, class: "l-field",
                    data: { missionform_target: "type", action: "change->missionform#typeChanged" } %>
              <%= f.select :period, [[t("merchant.gami.period_once"), "once"], [t("merchant.gami.daily"), "daily"], [t("merchant.gami.weekly"), "weekly"]], {}, class: "l-field", data: { missionform_target: "period" } %>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
              <div data-missionform-target="goalWrap">
                <label class="l-label"><%= t("merchant.gami.goal_label") %></label>
                <%= f.number_field :goal, class: "l-field", placeholder: t("merchant.gami.goal_ph") %>
              </div>
              <div>
                <label class="l-label" data-missionform-target="pointsLabel"><%= t("merchant.gami.points_label") %></label>
                <%= f.number_field :reward_points, class: "l-field", placeholder: t("merchant.gami.points_ph") %>
              </div>
            </div>

            <%# Per-platform points (only for social_share) %>
            <div data-missionform-target="platforms" hidden style="margin-top:10px; padding:10px 12px; border:1px solid var(--line); border-radius:10px;">
              <div class="l-eyebrow" style="margin-bottom:4px;"><%= t("merchant.gami.platform_allow") %></div>
              <p style="font-size:11.5px; color:var(--ink-2); margin:0 0 8px;"><%= t("merchant.gami.platform_allow_hint") %></p>
              <% cfg = m.proof_config['platforms'].to_h %>
              <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                <% Mission::PROOF_PLATFORMS.each do |plat| %>
                  <label style="display:flex; align-items:center; gap:6px; font-size:13px;">
                    <input type="checkbox" name="mission[proof_config][enabled][<%= plat %>]" value="1" <%= 'checked' if cfg.blank? || cfg.key?(plat) %> style="flex:none;">
                    <span style="width:64px;"><%= Mission::PLATFORM_LABELS[plat] %></span>
                    <input type="number" name="mission[proof_config][platforms][<%= plat %>]" min="0" class="l-field" placeholder="<%= t('merchant.gami.platform_pts_ph') %>" style="padding:6px 8px;" value="<%= cfg[plat].to_i.positive? ? cfg[plat] : nil %>">
                  </label>
                <% end %>
              </div>
            </div>

            <label style="display:flex; align-items:center; gap:8px; margin-top:10px; font-size:13px; color:var(--ink-2); cursor:pointer;">
              <%= f.check_box :active %> <%= t("merchant.gami.stamp_active") %>
            </label>
            <div style="display:flex; gap:8px; margin:12px 0 4px;">
              <%= f.submit t("merchant.gami.save"), class: "l-btn l-btn-primary" %>
              <button type="button" class="l-btn l-btn-ghost" onclick="this.closest('details').open=false"><%= t("merchant.gami.collapse") %></button>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <div class="sc-new">
      <div class="l-eyebrow" style="margin-bottom:8px;"><%= t("merchant.gami.mission_new") %></div>
      <%= form_with url: merchant_missions_path, method: :post, scope: :mission,
            data: { controller: "missionform" } do |f| %>
        <div style="display:grid; grid-template-columns:1fr auto; gap:8px; align-items:start;">
          <input type="text" name="mission[title]" class="l-field" placeholder="<%= t("merchant.gami.mission_title_ph") %>">
          <div style="width:120px;"><%= render "merchant/shared/icon_field", name: "mission[icon]", placeholder: "🎯" %></div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
          <%= f.select :mission_type,
                [["Check-in", "checkin"], [t("merchant.gami.mtype_spend"), "spend"], [t("merchant.gami.mtype_visit"), "visit"],
                 [t("merchant.gami.mtype_review"), "review"], [t("merchant.gami.mtype_social"), "social_share"]],
                {}, class: "l-field",
                data: { missionform_target: "type", action: "change->missionform#typeChanged" } %>
          <%= f.select :period, [[t("merchant.gami.period_once"), "once"], [t("merchant.gami.daily"), "daily"], [t("merchant.gami.weekly"), "weekly"]], {}, class: "l-field", data: { missionform_target: "period" } %>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
          <div data-missionform-target="goalWrap">
            <label class="l-label"><%= t("merchant.gami.goal_label") %></label>
            <%= f.number_field :goal, value: 1, class: "l-field", placeholder: t("merchant.gami.goal_ph") %>
          </div>
          <div>
            <label class="l-label" data-missionform-target="pointsLabel"><%= t("merchant.gami.points_label") %></label>
            <%= f.number_field :reward_points, value: 20, class: "l-field", placeholder: t("merchant.gami.points_ph") %>
          </div>
        </div>

        <%# Allowed social networks + optional per-platform points (only for social_share) %>
        <div data-missionform-target="platforms" hidden style="margin-top:10px; padding:10px 12px; border:1px solid var(--line); border-radius:10px;">
          <div class="l-eyebrow" style="margin-bottom:4px;"><%= t("merchant.gami.platform_allow") %></div>
          <p style="font-size:11.5px; color:var(--ink-2); margin:0 0 8px;"><%= t("merchant.gami.platform_allow_hint") %></p>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <% Mission::PROOF_PLATFORMS.each do |plat| %>
              <label style="display:flex; align-items:center; gap:6px; font-size:13px;">
                <input type="checkbox" name="mission[proof_config][enabled][<%= plat %>]" value="1" checked style="flex:none;">
                <span style="width:64px;"><%= Mission::PLATFORM_LABELS[plat] %></span>
                <input type="number" name="mission[proof_config][platforms][<%= plat %>]" min="0" class="l-field" placeholder="<%= t('merchant.gami.platform_pts_ph') %>" style="padding:6px 8px;">
              </label>
            <% end %>
          </div>
        </div>

        <%= f.hidden_field :active, value: true %>
        <%= f.submit t("merchant.gami.add_mission"), class: "l-btn l-btn-primary", style: "margin-top:10px;" %>
      <% end %>
    </div>
  </div>

  <%# ---- Badges (editable) ---- %>
  <% crit = { "first_purchase" => t("merchant.gami.crit_first"), "purchases_count" => t("merchant.gami.crit_count"), "points_total" => t("merchant.gami.crit_points"), "night_owl" => t("merchant.gami.crit_night") } %>
  <div class="l-panel" data-tabs-target="panel" data-tab="badges" hidden>
    <h3 class="l-display" style="font-size:18px; margin-bottom:10px;"><%= t("merchant.gami.badges") %></h3>
    <%= render "merchant/gamification/reward_source", context: :badge %>
    <% @badges.each do |b| %>
      <details class="l-editrow">
        <summary style="display:flex; align-items:center; gap:10px; padding:8px 0; cursor:pointer; list-style:none;">
          <span style="font-size:20px;"><%= b.display_icon %></span>
          <div style="flex:1;"><strong><%= b.name %></strong>
            <div style="font-size:12px; color:var(--ink-2);"><%= crit[b.criteria_type] || b.criteria_type %><%= " · #{t('merchant.gami.threshold_word')} #{b.threshold}" if %w[purchases_count points_total].include?(b.criteria_type) %><%= " · #{t('merchant.gami.points_plus', n: b.reward_points)}" if b.reward_points.to_i.positive? %><%= " · 🎁 #{b.reward.title}" if b.reward %></div>
          </div>
          <span class="l-chip" style="font-size:11px;"><%= t("merchant.gami.edit_chip") %></span>
          <%= button_to "✕", merchant_badge_path(b), method: :delete, class: "l-btn l-btn-ghost", style: "padding:4px 10px;", form: { data: { turbo_confirm: t("merchant.gami.delete_badge_confirm") }, style: "display:inline;" } %>
        </summary>
        <%= form_with model: b, url: merchant_badge_path(b), method: :patch, scope: :badge do |f| %>
          <label class="l-label"><%= t("merchant.gami.badge_name_label") %></label>
          <%= f.text_field :name, class: "l-field", style: "margin:4px 0 10px;", placeholder: t("merchant.gami.badge_name_ph") %>
          <div style="display:grid; grid-template-columns:70px 1fr 110px 120px; gap:8px; align-items:end;">
            <div>
              <label class="l-label"><%= t("merchant.gami.icon_label") %></label>
              <%= render "merchant/shared/icon_field", name: "badge[icon]", value: b.icon, placeholder: "🏅" %>
            </div>
            <div>
              <label class="l-label"><%= t("merchant.gami.criteria_label") %></label>
              <%= f.select :criteria_type, crit.map { |k, v| [v, k] }, {}, class: "l-field" %>
            </div>
            <div>
              <label class="l-label"><%= t("merchant.gami.threshold_label") %></label>
              <%= f.number_field :threshold, class: "l-field", min: 1, placeholder: t("merchant.gami.threshold_ph") %>
            </div>
            <div>
              <label class="l-label"><%= t("merchant.gami.reward_points_label") %></label>
              <%= f.number_field :reward_points, class: "l-field", min: 0, placeholder: t("merchant.gami.badge_points_ph") %>
            </div>
          </div>
          <label class="l-label" style="margin-top:10px; display:block;"><%= t("merchant.gami.badge_reward_label") %></label>
          <%= f.select :reward_id, @rewards.map { |r| [reward_option_label(r), r.id] }, { include_blank: t("merchant.gami.badge_reward_blank") }, class: "l-field" %>
          <p style="font-size:11.5px; color:var(--ink-2); margin:4px 0 0;"><%= t("merchant.gami.badge_reward_hint") %></p>
          <label class="l-label" style="margin-top:10px; display:block;"><%= t("merchant.gami.badge_desc_label") %></label>
          <%= f.text_area :description, rows: 2, class: "l-field", style: "margin-top:4px; resize:vertical;", placeholder: t("merchant.gami.badge_desc_ph") %>
          <p style="font-size:11.5px; color:var(--ink-2); margin:4px 0 0;"><%= t("merchant.gami.badge_desc_hint") %></p>
          <%= f.submit t("merchant.gami.save"), class: "l-btn l-btn-primary", style: "margin:12px 0 12px;" %>
        <% end %>
      </details>
    <% end %>

    <%= form_with url: merchant_badges_path, method: :post, scope: :badge do %>
      <div class="l-eyebrow" style="margin-top:16px; margin-bottom:8px;"><%= t("merchant.gami.badge_new") %></div>
      <label class="l-label"><%= t("merchant.gami.badge_name_label") %></label>
      <input type="text" name="badge[name]" class="l-field" placeholder="<%= t("merchant.gami.add_badge_name_ph") %>" style="margin-top:4px;">
      <div style="display:grid; grid-template-columns:70px 1fr 110px 120px; gap:8px; margin-top:8px; align-items:end;">
        <div>
          <label class="l-label"><%= t("merchant.gami.icon_label") %></label>
          <%= render "merchant/shared/icon_field", name: "badge[icon]", placeholder: "🏅" %>
        </div>
        <div>
          <label class="l-label"><%= t("merchant.gami.criteria_label") %></label>
          <select name="badge[criteria_type]" class="l-field"><% crit.each { |k, v| %><option value="<%= k %>"><%= v %></option><% } %></select>
        </div>
        <div>
          <label class="l-label"><%= t("merchant.gami.threshold_label") %></label>
          <input type="number" name="badge[threshold]" class="l-field" value="1" min="1" placeholder="<%= t("merchant.gami.threshold_ph") %>">
        </div>
        <div>
          <label class="l-label"><%= t("merchant.gami.reward_points_label") %></label>
          <input type="number" name="badge[reward_points]" class="l-field" value="0" min="0" placeholder="<%= t("merchant.gami.badge_points_ph") %>">
        </div>
      </div>
      <label class="l-label" style="margin-top:10px; display:block;"><%= t("merchant.gami.badge_reward_label") %></label>
      <%= select_tag "badge[reward_id]", options_for_select(@rewards.map { |r| [reward_option_label(r), r.id] }), include_blank: t("merchant.gami.badge_reward_blank"), class: "l-field" %>
      <label class="l-label" style="margin-top:10px; display:block;"><%= t("merchant.gami.badge_desc_label") %></label>
      <textarea name="badge[description]" rows="2" class="l-field" style="margin-top:4px; resize:vertical;" placeholder="<%= t("merchant.gami.badge_desc_ph") %>"></textarea>
      <p style="font-size:11.5px; color:var(--ink-2); margin:4px 0 0;"><%= t("merchant.gami.badge_desc_hint") %></p>
      <%= submit_tag t("merchant.gami.add_badge"), class: "l-btn l-btn-primary", style: "margin-top:10px;" %>
    <% end %>
    <p style="font-size:12px; color:var(--ink-2); margin-top:10px;"><%= t("merchant.gami.badges_note") %></p>
  </div>

  <%# ---- Lucky wheel (editable prizes) ---- %>
  <div class="l-panel" data-tabs-target="panel" data-tab="wheel" hidden>
    <h3 class="l-display" style="font-size:18px; margin-bottom:4px;"><%= t("merchant.gami.wheel") %></h3>
    <p style="color:var(--ink-2); font-size:13px; margin-bottom:14px;"><%= t("merchant.gami.wheel_note") %></p>
    <% rows = @wheel.resolved_segments.dup; rows << {} while rows.size < 2 %>
    <%= form_with url: merchant_wheel_config_path, method: :patch do %>
      <div data-controller="rows" data-rows-next-value="<%= rows.size %>" data-rows-min-value="2">
        <div style="display:flex; gap:8px; font-size:11px; color:var(--ink-2); text-transform:uppercase; letter-spacing:.05em; padding:0 2px 6px;">
          <span style="width:40px;"><%= t("merchant.gami.col_color") %></span><span style="flex:1;"><%= t("merchant.gami.col_prize") %></span><span style="width:96px;"><%= t("merchant.gami.col_points") %></span><span style="width:160px;"><%= t("merchant.gami.col_reward") %></span><span style="width:84px;"><%= t("merchant.gami.col_rate") %></span><span style="width:34px;"></span>
        </div>
        <div style="display:flex; flex-direction:column; gap:8px;" data-rows-target="list">
          <% rows.each_with_index do |s, i| %>
            <div style="display:flex; gap:8px; align-items:center;" data-row>
              <input type="color" name="segments[<%= i %>][color]" value="<%= s['color'] || '#E08A3C' %>" style="width:40px; height:38px; border:1px solid var(--line); border-radius:10px; padding:2px; background:#fff; cursor:pointer;">
              <input type="text" name="segments[<%= i %>][label]" value="<%= s['label'] %>" placeholder="<%= t("merchant.gami.prize_ph") %>" class="l-field" style="flex:1;">
              <input type="number" name="segments[<%= i %>][value]" value="<%= s['value'] %>" min="0" placeholder="0" class="l-field" style="width:96px;">
              <%= select_tag "segments[#{i}][reward_id]", options_for_select(@rewards.map { |r| [r.title, r.id] }, s['reward_id']), include_blank: t("merchant.gami.reward_none"), class: "l-field", style: "width:160px;" %>
              <input type="number" name="segments[<%= i %>][weight]" value="<%= s['weight'] || 10 %>" min="1" placeholder="10" class="l-field" style="width:84px;">
              <button type="button" class="wheel-x" data-action="rows#remove" aria-label="<%= t("merchant.gami.remove_cell") %>">✕</button>
            </div>
          <% end %>
        </div>
        <template data-rows-target="template">
          <div style="display:flex; gap:8px; align-items:center;" data-row>
            <input type="color" name="segments[__INDEX__][color]" value="#E08A3C" style="width:40px; height:38px; border:1px solid var(--line); border-radius:10px; padding:2px; background:#fff; cursor:pointer;">
            <input type="text" name="segments[__INDEX__][label]" placeholder="<%= t("merchant.gami.prize_ph") %>" class="l-field" style="flex:1;">
            <input type="number" name="segments[__INDEX__][value]" min="0" placeholder="0" class="l-field" style="width:96px;">
            <%= select_tag "segments[__INDEX__][reward_id]", options_for_select(@rewards.map { |r| [r.title, r.id] }), include_blank: t("merchant.gami.reward_none"), class: "l-field", style: "width:160px;" %>
            <input type="number" name="segments[__INDEX__][weight]" value="10" min="1" placeholder="10" class="l-field" style="width:84px;">
            <button type="button" class="wheel-x" data-action="rows#remove" aria-label="<%= t("merchant.gami.remove_cell") %>">✕</button>
          </div>
        </template>
        <button type="button" class="l-btn l-btn-ghost" data-action="rows#add" style="margin-top:10px;">
          <%= ui_icon(:check, size: 15) %> <%= t("merchant.gami.add_cell") %>
        </button>
      </div>

      <div style="display:flex; gap:16px; align-items:center; margin-top:14px; flex-wrap:wrap;">
        <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
          <input type="checkbox" name="daily_free" value="1" <%= "checked" if @wheel.daily_free %>>
          <%= t("merchant.gami.daily_free") %>
        </label>
        <label style="display:flex; align-items:center; gap:8px; font-size:14px;">
          <%= t("merchant.gami.extra_spin_pre") %>
          <input type="number" name="cost_points" value="<%= @wheel.cost_points %>" min="0" class="l-field" style="width:90px;"> <%= t("merchant.gami.extra_spin_suf") %>
        </label>
      </div>

      <%= submit_tag t("merchant.gami.save_wheel"), class: "l-btn l-btn-primary", style: "margin-top:16px;" %>
    <% end %>
  </div>
</div>
