<%# Merchants kept asking where the "Thưởng: …" list comes from. Say it plainly,
    with a link to the page where those rewards are created. `context` picks the
    wording: :stamp (tem đủ) or :badge (đạt huy hiệu). %>
<div style="display:flex; align-items:flex-start; gap:8px; padding:10px 12px; margin-bottom:12px;
            border-radius:12px; background:var(--surface-2); font-size:13px; line-height:1.5;">
  <span style="font-size:15px; line-height:1.3;">🎁</span>
  <div style="color:var(--ink-2);">
    <% if @rewards.empty? %>
      <%= t("merchant.gami.reward_source_empty") %>
      <%= link_to t("merchant.gami.reward_source_create"), merchant_rewards_path,
            style: "color:var(--primary); font-weight:600; text-decoration:none; white-space:nowrap;" %>
    <% else %>
      <%= t("merchant.gami.reward_source_#{context}") %>
      <%= link_to t("merchant.gami.reward_source_manage"), merchant_rewards_path,
            style: "color:var(--primary); font-weight:600; text-decoration:none; white-space:nowrap;" %>
    <% end %>
  </div>
</div>
