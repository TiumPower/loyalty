<% content_for :title, @workspace.name %>
<%# Shown once, straight after creation, and only when no set-password email
    could be sent. Deliberately not a flash notice: those are copied into a
    JS-readable cookie. %>
<% if (cred = flash[:owner_credentials]).present? %>
  <div class="l-panel" style="margin-bottom:16px; border-color:#C9871F; background:color-mix(in srgb, #C9871F 8%, #fff);">
    <div style="font-weight:700; margin-bottom:4px;">🔑 Thông tin đăng nhập cho chủ cửa hàng</div>
    <p style="font-size:13px; color:var(--ink-2); margin:0 0 10px;">
      Chỉ hiển thị một lần. Gửi cho chủ cửa hàng qua kênh riêng và nhắc họ đổi mật khẩu sau khi đăng nhập.
    </p>
    <div class="l-mono" style="font-size:14px;">
      <div>Email: <strong><%= cred["email"] %></strong></div>
      <div>Mật khẩu: <strong><%= cred["password"] %></strong></div>
    </div>
  </div>
<% end %>
<div style="display:grid; grid-template-columns:1fr 320px; gap:20px; align-items:start;">
  <div class="l-panel">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
      <span style="width:44px; height:44px; border-radius:12px; background:<%= @workspace.theme_value(:primary) %>;"></span>
      <div><h2 class="l-display" style="font-size:22px;"><%= @workspace.name %></h2>
        <div style="color:var(--ink-2); font-size:13px;"><%= @workspace.subdomain %> · <%= @workspace.industry %> · <%= @workspace.status_label %></div></div>
    </div>
    <div class="l-kpis">
      <div class="l-kpi"><div class="k">Thành viên</div><div class="v"><%= number_with_delimiter(@members_count) %></div></div>
      <div class="l-kpi"><div class="k">Điểm đã phát</div><div class="v"><%= number_with_delimiter(@points_issued) %></div></div>
      <div class="l-kpi"><div class="k">Gói</div><div class="v" style="font-size:22px;"><%= @workspace.plan %></div><div class="d" style="color:var(--ink-2);"><%= number_with_delimiter(@workspace.monthly_price) %>đ/tháng</div></div>
    </div>
  </div>

  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:10px;">Quản trị</h3>
    <div style="display:flex; gap:8px; margin-bottom:16px;">
      <% if @workspace.pending? || @workspace.status == "suspended" %>
        <%= button_to "✓ Duyệt / Kích hoạt", approve_admin_workspace_path(@workspace), method: :patch, class: "l-btn l-btn-primary", style: "flex:1;" %>
      <% elsif @workspace.active? %>
        <%= button_to "Tạm ngưng", suspend_admin_workspace_path(@workspace), method: :patch, class: "l-btn l-btn-ghost", style: "flex:1;", form: { data: { turbo_confirm: "Tạm ngưng?" } } %>
      <% end %>
    </div>
    <%= form_with model: @workspace, url: admin_workspace_path(@workspace), method: :patch do |f| %>
      <label class="l-label">Subdomain</label>
      <div style="display:flex; align-items:center; gap:6px;">
        <%= f.text_field :subdomain, class: "l-field", style: "text-align:right;" %>
        <span class="l-mono" style="color:var(--ink-2); white-space:nowrap; font-size:12px;">.loyalty.tiumpower.com</span>
      </div>
      <label class="l-label" style="margin-top:12px;">Tên miền riêng (tuỳ chọn)</label>
      <%= f.text_field :custom_domain, class: "l-field", placeholder: "loyalty.tenshop.vn" %>
      <label class="l-label" style="margin-top:12px;">Trạng thái</label>
      <%= f.select :status, Workspace::STATUSES.map { |s| [Workspace::STATUS_LABELS[s], s] }, {}, class: "l-field" %>
      <label class="l-label" style="margin-top:12px;">Gói dịch vụ</label>
      <%= f.select :plan, Workspace::PLANS.map { |p| [p.capitalize, p] }, {}, class: "l-field" %>
      <%= f.submit "Cập nhật", class: "l-btn l-btn-soft l-btn-block", style: "margin-top:16px;" %>
    <% end %>
    <div style="display:flex; flex-direction:column; gap:8px; margin-top:16px;">
      <%= link_to merchant_url_for(@workspace), target: "_blank", rel: "noopener",
            class: "l-btn l-btn-primary l-btn-block" do %>
        <%= ui_icon(:launch, size: 16) %> Mở dashboard merchant
      <% end %>
      <%= link_to customer_url_for(@workspace), target: "_blank", rel: "noopener",
            class: "l-btn l-btn-ghost l-btn-block" do %>
        <%= ui_icon(:launch, size: 16) %> Mở app khách
      <% end %>
    </div>
    <div style="margin-top:14px; padding:12px 14px; border-radius:12px; background:var(--surface-2); font-size:12px; color:var(--ink-2); line-height:1.5;">
      <div style="font-weight:600; color:var(--ink);">Dashboard merchant</div>
      <div class="l-mono" style="overflow-wrap:anywhere;"><%= @workspace.subdomain %>.loyalty.tiumpower.com/merchant</div>
      <div style="font-weight:600; color:var(--ink); margin-top:8px;">App khách</div>
      <div class="l-mono" style="overflow-wrap:anywhere;"><%= @workspace.subdomain %>.loyalty.tiumpower.com</div>
      <div class="l-mono" style="overflow-wrap:anywhere; opacity:.75;">hoặc loyalty.tiumpower.com/w/<%= @workspace.slug %></div>
    </div>
    <div style="margin-top:20px; padding-top:16px; border-top:1px solid var(--line);">
      <div style="font-weight:700; color:var(--warn,#B4402F); margin-bottom:4px;">Vùng nguy hiểm</div>
      <p style="font-size:12.5px; color:var(--ink-2); margin:0 0 10px; line-height:1.5;">
        Xoá vĩnh viễn workspace này cùng toàn bộ khách hàng, điểm, ưu đãi, hoá đơn và tệp đã tải lên.
        <strong>Không thể hoàn tác.</strong> Nếu chỉ muốn ngừng dịch vụ, hãy dùng “Tạm ngưng”.
      </p>
      <%= form_with url: admin_workspace_path(@workspace), method: :delete do %>
        <label class="l-label">Gõ <span class="l-mono"><strong><%= @workspace.subdomain %></strong></span> để xác nhận</label>
        <%= text_field_tag :confirm, nil, class: "l-field", autocomplete: "off",
              placeholder: @workspace.subdomain %>
        <%= submit_tag "Xoá vĩnh viễn workspace", class: "l-btn l-btn-ghost l-btn-block",
              style: "margin-top:10px; color:var(--warn,#B4402F);",
              data: { turbo_confirm: "Xoá vĩnh viễn “#{@workspace.name}”? Không thể hoàn tác." } %>
      <% end %>
    </div>

  </div>
</div>
