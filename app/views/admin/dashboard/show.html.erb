<% content_for :title, "Tổng quan nền tảng" %>

<%# Cảnh báo đứng trên cùng và nói thẳng nội dung. Trước đây đây là một ô KPI
    chỉ đếm số cảnh báo rồi dẫn sang trang Giám sát — phải bấm thêm một nhịp
    mới biết nó nói gì, trong khi đây đúng là thứ cần làm ngay. %>
<% if @alerts.any? %>
  <div class="l-panel" style="margin-bottom:16px; border-left:4px solid var(--warn);">
    <div class="l-eyebrow" style="color:var(--warn);">Cảnh báo</div>
    <% @alerts.each do |a| %>
      <div style="margin-top:6px;">⚠️ <%= a %></div>
    <% end %>
    <%= link_to "Xem workspace →", admin_workspaces_path,
          style: "display:inline-block; margin-top:10px; font-weight:600; color:var(--primary); text-decoration:none;" %>
  </div>
<% end %>

<div class="l-kpis">
  <div class="l-kpi"><div class="k">Workspaces</div><div class="v"><%= @workspaces_count %></div><div class="d"><%= @active_count %> active · <%= @trial_count %> trial</div></div>
  <div class="l-kpi"><div class="k">Tổng thành viên</div><div class="v"><%= number_with_delimiter(@members_count) %></div><div class="d">toàn nền tảng</div></div>
  <div class="l-kpi"><div class="k">Điểm đã phát</div><div class="v"><%= number_with_delimiter(@points_issued) %></div><div class="d">toàn nền tảng</div></div>
  <div class="l-kpi"><div class="k">Điểm đã đổi</div><div class="v"><%= number_with_delimiter(@points_redeemed) %></div></div>
  <div class="l-kpi"><div class="k">Giao dịch</div><div class="v"><%= number_with_delimiter(@purchases_count) %></div></div>
  <div class="l-kpi"><div class="k">Voucher đã dùng</div><div class="v"><%= number_with_delimiter(@vouchers_used) %></div></div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:20px;">
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Top workspace theo thành viên</h3>
    <% @top.each do |ws, count| %>
      <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-top:1px solid var(--line);">
        <span style="width:24px; height:24px; border-radius:7px; background:<%= ws.theme_value(:primary) %>;"></span>
        <strong><%= ws.name %></strong>
        <span style="margin-left:auto; color:var(--ink-2);"><%= number_with_delimiter(count) %> khách</span>
      </div>
    <% end %>
  </div>
  <div class="l-panel">
    <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Workspace theo trạng thái</h3>
    <% @by_status.each do |status, count| %>
      <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 0; border-top:1px solid var(--line);">
        <span><%= Workspace::STATUS_LABELS[status] || status %></span>
        <strong><%= count %></strong>
      </div>
    <% end %>
  </div>
</div>

<div class="l-panel" style="margin-top:20px;">
  <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Workspace mới nhất</h3>
  <% @recent.each do |ws| %>
    <div style="display:flex; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line);">
      <span style="width:30px; height:30px; border-radius:9px; background:<%= ws.theme_value(:primary) %>;"></span>
      <div><strong><%= ws.name %></strong><div style="font-size:12px; color:var(--ink-2);"><%= ws.subdomain %> · <%= ws.industry %></div></div>
      <span class="l-chip <%= 'l-chip-brand' if ws.active? %>" style="margin-left:auto;"><%= ws.status %></span>
      <%= link_to "Xem", admin_workspace_path(ws), class: "l-btn l-btn-ghost", style: "padding:6px 12px;" %>
    </div>
  <% end %>
</div>
