<% content_for :title, "Tổng quan nền tảng" %>
<div class="l-kpis">
  <div class="l-kpi"><div class="k">Workspaces</div><div class="v"><%= @workspaces_count %></div><div class="d"><%= @active_count %> active · <%= @trial_count %> trial</div></div>
  <div class="l-kpi"><div class="k">Tổng thành viên</div><div class="v"><%= number_with_delimiter(@members_count) %></div><div class="d">toàn nền tảng</div></div>
  <div class="l-kpi"><div class="k">Điểm phát hành</div><div class="v"><%= number_with_delimiter(@points_issued) %></div><div class="d">toàn nền tảng</div></div>
  <%= link_to admin_monitoring_path, class: "l-kpi", style: "text-decoration:none; color:inherit; display:block;" do %>
    <div class="k">Cảnh báo</div>
    <div class="v" style="<%= "color:var(--warn,#B4402F);" if @alerts_count.positive? %>"><%= @alerts_count %></div>
    <div class="d" style="color:var(--ink-2);"><%= @alerts_count.positive? ? "chờ duyệt / quá hạn ›" : "Không có cảnh báo" %></div>
  <% end %>
</div>

<div class="l-panel" style="margin-top:20px;">
  <h3 class="l-display" style="font-size:18px; margin-bottom:12px;">Workspace mới nhất</h3>
  <% @recent.each do |ws| %>
    <div style="display:flex; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line);">
      <span style="width:30px; height:30px; border-radius:9px; background:<%= ws.theme_value(:primary) %>;"></span>
      <div><strong><%= ws.name %></strong><div style="font-size:12px; color:var(--ink-2);"><%= ws.subdomain %> · <%= ws.industry %></div></div>
      <span class="l-chip <%= 'l-chip-brand' if ws.active? %>" style="margin-left:auto;"><%= ws.status %></span>
      <%= link_to "Xem", admin_workspace_path(ws), class: "l-btn l-btn-ghost", style: "padding:6px 12px;" %>
    </div>
  <% end %>
</div>
